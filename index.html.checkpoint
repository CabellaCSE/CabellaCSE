// --- Client Tier Spreadsheet Helper Functions ---
function sendClientTierEmail(tier) {
  const fileMap = {
    'Select': 'resources/Cabella_Cabinets_Select_Pricing.xlsx',
    'Plus': 'resources/Cabella_Cabinets_Plus_Pricing.xlsx',
    'Premier': 'resources/Cabella_Cabinets_Premier_Pricing.xlsx'
  };
  const fullUrl = window.location.origin + '/' + (fileMap[tier] || '');
  const subject = encodeURIComponent(`Cabella Collections - ${tier} Cabinet Price Sheet & Self-Quote Spreadsheet`);
  const body = encodeURIComponent(`Hello,\n\nAttached is your Cabella ${tier} Cabinet Price Sheet and Self-Quote Spreadsheet. You can use this spreadsheet to calculate itemized cabinet pricing for your upcoming project.\n\nSpreadsheet Direct Download Link: ${fullUrl}\n\nPlease let us know if you have any questions or when you are ready to place your order!\n\nBest regards,\nCabella Collections Team`);
  
  window.open(`mailto:?subject=${subject}&body=${body}`, '_blank');
  if (typeof showToast === 'function') {
    showToast(`Client ${tier} Tier self-quote email template generated!`);
  }
}

function copyClientTierLink(tier) {
  const fileMap = {
    'Select': 'resources/Cabella_Cabinets_Select_Pricing.xlsx',
    'Plus': 'resources/Cabella_Cabinets_Plus_Pricing.xlsx',
    'Premier': 'resources/Cabella_Cabinets_Premier_Pricing.xlsx'
  };
  const fullUrl = window.location.origin + '/' + (fileMap[tier] || '');
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(fullUrl).then(() => {
      if (typeof showToast === 'function') {
        showToast(`Copied ${tier} Tier spreadsheet link to clipboard!`);
      } else {
        alert(`Copied ${tier} Tier spreadsheet link to clipboard!`);
      }
    }).catch(() => {
      prompt(`Copy ${tier} Tier spreadsheet URL:`, fullUrl);
    });
  } else {
    prompt(`Copy ${tier} Tier spreadsheet URL:`, fullUrl);
  }
}


// --- Company Directory & RingCentral Functions ---
let currentDirFilter = 'all';

function filterDirectoryCategory(filter, btn) {
  currentDirFilter = filter;
  document.querySelectorAll('.dir-filter-btn').forEach(b => b.classList.remove('active'));
  if (btn) btn.classList.add('active');
  renderPeopleTable();
}

function renderPeopleTable() {
  const query = (document.getElementById('directorySearchInput')?.value || '').toLowerCase().trim();
  const gridContainer = document.getElementById('peopleCardsGrid');
  const tableBody = document.getElementById('peopleTableBody');
  if (!gridContainer && !tableBody) return;

  let people = (typeof BASE_DATA !== 'undefined' && BASE_DATA.people) ? BASE_DATA.people : [
    { name: 'Edwin Portillo', role: 'Chief Executive Officer', email: 'edwin@cabellacollections.com', phone: '(702) 679-2070', extension: '103', system: 'RingCentral' },
    { name: 'Gil Sirimarco', role: 'Chief Financial Officer', email: 'gil@cabellacollections.com', phone: '(702) 679-2715', extension: '101', system: 'RingCentral' },
    { name: 'Jerry Maza', role: 'Head Project Manager', email: 'jerry@cabellacollections.com', phone: '(702) 679-2239', extension: '104', system: 'RingCentral' },
    { name: 'Mayra Rodriguez', role: 'Orders Coordinator', email: 'orders@cabellacollections.com', phone: 'Main line: (702) 879-2549', extension: '106', system: 'RingCentral' },
    { name: 'Margie Caro', role: 'Project Manager & Sales', email: 'pm@cabellacollections.com', phone: '(725) 255-2835', extension: '107', system: 'RingCentral' },
    { name: 'Chuy', role: 'Warehouse Manager', email: 'inbox@cabellacollections.com', phone: 'Main line: (702) 879-2549', extension: '', system: 'Company' }
  ];

  if (typeof currentDirFilter !== 'undefined') {
    if (currentDirFilter === 'exec') {
      people = people.filter(p => p.role.includes('Officer') || p.role.includes('CEO') || p.role.includes('CFO'));
    } else if (currentDirFilter === 'pm') {
      people = people.filter(p => p.role.includes('Project') || p.role.includes('Designer') || p.role.includes('PM'));
    } else if (currentDirFilter === 'ops') {
      people = people.filter(p => p.role.includes('Orders') || p.role.includes('Warehouse') || p.role.includes('Coordinator'));
    }
  }

  if (query) {
    people = people.filter(p => 
      (p.name || '').toLowerCase().includes(query) ||
      (p.role || '').toLowerCase().includes(query) ||
      (p.extension || '').toLowerCase().includes(query) ||
      (p.phone || '').toLowerCase().includes(query) ||
      (p.email || '').toLowerCase().includes(query)
    );
  }

  const getInitials = (name) => {
    const parts = (name || '').split(' ').filter(Boolean);
    if (parts.length >= 2) return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
    return ((name || '').substring(0, 2)).toUpperCase() || 'CB';
  };

  if (gridContainer) {
    if (people.length === 0) {
      gridContainer.innerHTML = '<div style="grid-column: 1 / -1; padding: 30px; text-align: center; color: var(--muted); background: #fff; border-radius: 10px; border: 1px solid #cbd5e1">No staff members match your search criteria.</div>';
    } else {
      gridContainer.innerHTML = people.map(p => {
        const initials = getInitials(p.name);
        const extBadge = p.extension ? '<span class="badge" style="background:#0284c7;color:#fff;font-weight:bold;font-size:12px">Ext. ' + esc(p.extension) + '</span>' : '<span class="badge" style="background:#64748b;color:#fff;font-size:11px">Main Line</span>';
        const phoneClean = (p.phone || '').replace(/[^0-9]/g, '');
        const phoneLink = phoneClean ? 'tel:+1' + phoneClean.slice(-10) : 'tel:+17028792549';
        return `
          <div style="background:#fff;border:1px solid #cbd5e1;border-radius:12px;padding:18px;box-shadow:0 2px 8px rgba(0,0,0,0.03);display:flex;flex-direction:column;justify-content:space-between">
            <div>
              <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px">
                <div style="display:flex;align-items:center;gap:12px">
                  <div style="width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,#061a33,#133763);color:#fff;font-weight:bold;display:flex;align-items:center;justify-content:center;font-size:16px">
                    ${initials}
                  </div>
                  <div>
                    <h3 style="margin:0;font-size:16px;color:#0f2942">${esc(p.name)}</h3>
                    <div style="font-size:13px;color:#64748b;font-weight:500">${esc(p.role)}</div>
                  </div>
                </div>
                ${extBadge}
              </div>
              <div style="font-size:13px;color:#334155;line-height:1.6;margin-bottom:14px;background:#f8fafc;padding:10px 12px;border-radius:8px;border:1px solid #f1f5f9">
                <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px">
                  <span>📞 Direct Line:</span>
                  <a href="${phoneLink}" style="color:#0284c7;font-weight:bold;text-decoration:none">${esc(p.phone)}</a>
                </div>
                ${p.email ? `
                  <div style="display:flex;align-items:center;gap:6px">
                    <span>✉️ Email:</span>
                    <a href="mailto:${esc(p.email)}" style="color:#0284c7;text-decoration:none">${esc(p.email)}</a>
                  </div>
                ` : '<div style="font-size:12px;color:#94a3b8">✉️ Email: Main line / Contact office</div>'}
              </div>
            </div>
            <div style="display:flex;gap:6px;margin-top:8px;flex-wrap:wrap">
              <a href="${phoneLink}" class="btn" style="flex:1;min-width:100px;font-size:12px;padding:7px 10px;text-align:center;background:#061a33;color:#fff;font-weight:bold;text-decoration:none">📞 Call Direct</a>
              <button class="btn" onclick="openQuickSmsModal('${esc(p.name)}', '${esc(p.phone)}', 'external')" style="flex:1;min-width:105px;font-size:12px;padding:7px 10px;background:#1d4d86;color:#fff;font-weight:bold;border:0;cursor:pointer">📲 Text SMS</button>
              <button class="btn secondary" onclick="openQuickSmsModal('${esc(p.name)}', '${esc(p.phone)}', 'internal')" style="font-size:12px;padding:7px 10px;background:#f1f5f9;color:#0f2942;font-weight:bold;border:1px solid #cbd5e1;cursor:pointer" title="Send Internal Staff Ping">💬 Ping</button>
              ${p.email ? `<a href="mailto:${esc(p.email)}" class="btn secondary" style="font-size:12px;padding:7px 10px;text-decoration:none" title="Email Staff Member">✉️ Email</a>` : ''}
            </div>
          </div>
        `;
      }).join('');
    }
  }

  if (tableBody) {
    if (people.length === 0) {
      tableBody.innerHTML = '<tr><td colspan="6" style="padding:20px;text-align:center;color:var(--muted)">No staff members match your filter.</td></tr>';
    } else {
      tableBody.innerHTML = people.map(p => {
        const phoneClean = (p.phone || '').replace(/[^0-9]/g, '');
        const phoneLink = phoneClean ? 'tel:+1' + phoneClean.slice(-10) : 'tel:+17028792549';
        return `
          <tr>
            <td style="padding:12px 14px;font-weight:bold;color:#0f2942">${esc(p.name)}</td>
            <td style="padding:12px 14px;color:#475569">${esc(p.role)}</td>
            <td style="padding:12px 14px">
              ${p.extension ? '<span class="badge" style="background:#0284c7;color:#fff;font-weight:bold">Ext. ' + esc(p.extension) + '</span>' : '<span class="badge" style="background:#64748b;color:#fff">Main Line</span>'}
            </td>
            <td style="padding:12px 14px">
              <a href="${phoneLink}" style="color:#0284c7;font-weight:bold;text-decoration:none">${esc(p.phone)}</a>
            </td>
            <td style="padding:12px 14px">
              ${p.email ? `<a href="mailto:${esc(p.email)}" style="color:#0284c7;text-decoration:none">${esc(p.email)}</a>` : '<span style="color:#94a3b8">—</span>'}
            </td>
            <td style="padding:12px 14px;text-align:right">
              <div style="display:inline-flex;gap:6px;align-items:center;justify-content:flex-end">
                <a href="${phoneLink}" class="btn" style="font-size:11.5px;padding:5px 9px;background:#061a33;color:#fff;font-weight:bold;text-decoration:none">📞 Call</a>
                <button class="btn" onclick="openQuickSmsModal('${esc(p.name)}', '${esc(p.phone)}', 'external')" style="font-size:11.5px;padding:5px 9px;background:#1d4d86;color:#fff;font-weight:bold;border:0;cursor:pointer">📲 Text SMS</button>
                <button class="btn secondary" onclick="openQuickSmsModal('${esc(p.name)}', '${esc(p.phone)}', 'internal')" style="font-size:11.5px;padding:5px 8px;background:#f1f5f9;color:#0f2942;font-weight:bold;border:1px solid #cbd5e1;cursor:pointer">💬 Ping</button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }
  }
}

function copyExtensionList() {
  const list = `CABELLA COLLECTIONS STAFF & RINGCENTRAL EXTENSIONS
Main Line: (702) 879-2549

Ext. 101 - Gil Sirimarco (CFO) | (702) 679-2715 | gil@cabellacollections.com
Ext. 103 - Edwin Portillo (CEO) | (702) 679-2070 | edwin@cabellacollections.com
Ext. 104 - Jerry Maza (Head PM) | (702) 679-2239 | jerry@cabellacollections.com
Ext. 106 - Logistics & Orders Desk | Main line: (702) 879-2549 | orders@cabellacollections.com
Ext. 107 - Margie Caro (Project Manager & Sales) | (725) 255-2835 | pm@cabellacollections.com
Warehouse - Chuy (Warehouse Manager) | Main line: (702) 879-2549 | inbox@cabellacollections.com`;

  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(list).then(() => {
      if (typeof showToast === 'function') showToast('Copied Extension List to clipboard!');
      else alert('Copied Extension List to clipboard!');
    });
  } else {
    prompt('Copy Staff Extension List:', list);
  }
}

function exportDirectoryCSV() {
  const people = (typeof BASE_DATA !== 'undefined' && BASE_DATA.people) ? BASE_DATA.people : [];
  let csv = 'Name,Role,Extension,Phone,Email,System\n';
  people.forEach(p => {
    csv += `"${p.name}","${p.role}","${p.extension || 'Main'}","${p.phone}","${p.email || ''}","${p.system || 'RingCentral'}"\n`;
  });
  const blob = new Blob([csv], { type: 'text/csv' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'Cabella_Staff_Directory.csv';
  a.click();
  URL.revokeObjectURL(url);
}

