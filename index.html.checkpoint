    body.innerHTML = items.map(item => `
      <tr style="border-bottom:1px solid #e2e8f0">
        <td style="padding:8px 12px;font-weight:bold;color:#0f2942">${esc(item.name)} <span style="font-size:11px;font-family:monospace;color:#64748b">(${esc(item.sku)})</span></td>
