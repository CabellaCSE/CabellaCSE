  <!-- SLIM MANDATORY VENDOR QUOTE SALES NOTICE -->
  <div style="margin-bottom:12px;background:#fffbeb;border:1px solid #f59e0b;border-left:4px solid #d97706;color:#78350f;padding:10px 14px;border-radius:8px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;font-size:12.5px">
