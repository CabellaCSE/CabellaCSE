// Global event delegation for cards and elements with data-view attribute
document.addEventListener("click", function(e) {
  const card = e.target.closest("[data-view]");
  if (card) {
    const viewId = card.getAttribute("data-view");
    if (viewId && typeof show === "function") {
      show(viewId);
    }
  }
});



// RingCentral & Quick SMS Dispatcher Functions
let rcMessagesList = [
  { id: 1, sender: "Chavez Shipping", phone: "(702) 555-0199", text: "Driver Chavez is en route to Elite Stone for PO 3102 pickup.", direction: "incoming", time: "10:15 AM" },
  { id: 2, sender: "Gil Sirimarco (CFO)", recipient: "Edwin Portillo", phone: "(702) 679-2070", text: "Approved quote #4821 for HomeCo Shaker cabinets.", direction: "outgoing", time: "09:45 AM" },
  { id: 3, sender: "All In Shipping", phone: "(702) 555-0188", text: "Waiting for Grandwood warehouse release on pallet #4.", direction: "incoming", time: "09:12 AM" },
  { id: 4, sender: "Mayra Rodriguez", recipient: "Jerry Maza", phone: "(702) 679-2239", text: "PO 3105 sent to MSI Surfaces Las Vegas.", direction: "outgoing", time: "08:30 AM" }
];

let currentRcFilter = "all";

function renderRcMessages() {
  const container = document.getElementById("rcCoverMessageStream");
  const countEl = document.getElementById("rcMsgCount");
  if (!container) return;

  let filtered = rcMessagesList;
  if (currentRcFilter === "incoming") {
    filtered = rcMessagesList.filter(m => m.direction === "incoming");
  } else if (currentRcFilter === "outgoing") {
    filtered = rcMessagesList.filter(m => m.direction === "outgoing");
  }

  if (countEl) {
    countEl.textContent = "Showing " + filtered.length + " message" + (filtered.length === 1 ? "" : "s");
  }

  if (filtered.length === 0) {
    container.innerHTML = '<div style="color:#94a3b8;font-size:12.5px;padding:12px;text-align:center">No text messages match filter.</div>';
    return;
  }

  container.innerHTML = filtered.map(m => {
    const isOut = m.direction === "outgoing";
    const badgeBg = isOut ? "#3b82f6" : "#22c55e";
    const badgeText = isOut ? "📤 OUT" : "📥 IN";
    return `
      <div style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);border-radius:8px;padding:9px 12px;color:#fff;font-size:13px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">
          <div style="display:flex;align-items:center;gap:6px">
            <span style="background:${badgeBg};color:#fff;font-size:10px;font-weight:900;padding:2px 6px;border-radius:4px">${badgeText}</span>
            <strong style="color:#e2e8f0;font-size:13px">${esc(m.sender)}${m.recipient ? ' → ' + esc(m.recipient) : ''}</strong>
          </div>
          <span style="font-size:11px;color:#94a3b8">${esc(m.time)}</span>
        </div>
        <div style="color:#cbd5e1;line-height:1.4;font-size:12.5px">${esc(m.text)}</div>
        <div style="margin-top:5px;display:flex;gap:12px;font-size:11px">
          <a href="tel:${esc((m.phone || '').replace(/[^0-9]/g, ''))}" style="color:#60a5fa;text-decoration:none;font-weight:600">📞 Call ${esc(m.phone)}</a>
          <button onclick="openQuickSmsModal('${esc(m.sender)}', '${esc(m.phone)}', 'external')" style="background:none;border:0;color:#38bdf8;cursor:pointer;padding:0;font-size:11px;font-weight:600">💬 Reply Text</button>
        </div>
      </div>
    `;
  }).join("");
}

function filterRcMessages(filter) {
  currentRcFilter = filter;
  const allBtn = document.getElementById("rcFilterAllBtn");
  const inBtn = document.getElementById("rcFilterInBtn");
  const outBtn = document.getElementById("rcFilterOutBtn");

  if (allBtn) {
    allBtn.style.background = filter === "all" ? "#e5b85f" : "rgba(255,255,255,0.15)";
    allBtn.style.color = filter === "all" ? "#061a33" : "#fff";
  }
  if (inBtn) {
    inBtn.style.background = filter === "incoming" ? "#22c55e" : "rgba(255,255,255,0.15)";
    inBtn.style.color = "#fff";
  }
  if (outBtn) {
    outBtn.style.background = filter === "outgoing" ? "#3b82f6" : "rgba(255,255,255,0.15)";
    outBtn.style.color = "#fff";
  }

  renderRcMessages();
}

function addRcMessageToStream(msg) {
  rcMessagesList.unshift({
    id: Date.now(),
    sender: msg.sender || "Staff Member",
    recipient: msg.recipient || "",
    phone: msg.phone || "(702) 879-2549",
    text: msg.text || "",
    direction: msg.direction || "outgoing",
    time: msg.time || new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })
  });
  renderRcMessages();
}

function dismissRingAlert() {
  const alertEl = document.getElementById("rcIncomingRingAlert") || document.getElementById("rcActiveIncomingAlert");
  if (alertEl) alertEl.style.display = "none";
  if (typeof showToast === "function") showToast("🔕 RingCentral incoming alert silenced.");
}

function openQuickSmsModal(recipientName = "Staff Member / Client", recipientPhone = "(702) 879-2549", defaultMode = "external") {
  const activeName = (typeof currentActiveUser !== "undefined" && currentActiveUser.name) ? currentActiveUser.name : "Gil Sirimarco";
  const activeRole = (typeof currentActiveUser !== "undefined" && currentActiveUser.role) ? currentActiveUser.role : "CFO";
  
  const content = `
    <div style="padding:4px 0">
      <div style="display:flex;gap:8px;margin-bottom:16px;background:#f1f5f9;padding:4px;border-radius:8px;border:1px solid #cbd5e1">
        <button id="smsModeExtBtn" type="button" onclick="switchSmsModalMode('external')" class="btn" style="flex:1;font-size:13px;font-weight:800;padding:8px;border-radius:6px;${defaultMode === 'external' ? 'background:#061a33;color:#fff;border:0;' : 'background:transparent;color:#475569;border:0;'}">
          📲 RingCentral Business SMS (External Text)
        </button>
        <button id="smsModeIntBtn" type="button" onclick="switchSmsModalMode('internal')" class="btn" style="flex:1;font-size:13px;font-weight:800;padding:8px;border-radius:6px;${defaultMode === 'internal' ? 'background:#0284c7;color:#fff;border:0;' : 'background:transparent;color:#475569;border:0;'}">
          🏢 Cabella Staff Chat / Team Ping (Internal)
        </button>
      </div>

      <input type="hidden" id="smsModalModeVal" value="${defaultMode}">

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px">
        <div>
          <label style="display:block;font-size:12px;font-weight:800;color:#475569;margin-bottom:4px">Recipient Name</label>
          <input id="smsModalName" value="${esc(recipientName)}" style="width:100%;padding:9px 12px;border:1px solid #cbd5e1;border-radius:6px;font-size:13.5px;font-weight:700;color:#0f2942">
        </div>
        <div>
          <label style="display:block;font-size:12px;font-weight:800;color:#475569;margin-bottom:4px">Target Phone Line / Extension</label>
          <input id="smsModalPhone" value="${esc(recipientPhone)}" style="width:100%;padding:9px 12px;border:1px solid #cbd5e1;border-radius:6px;font-size:13.5px;font-weight:700;color:#0f2942">
        </div>
      </div>

      <div style="margin-bottom:14px">
        <label style="display:block;font-size:12px;font-weight:800;color:#475569;margin-bottom:6px">⚡ Quick Message Shortcuts & Templates</label>
        <div style="display:flex;gap:6px;flex-wrap:wrap">
          <button type="button" class="btn secondary" onclick="applySmsTemplate('📦 Your cabinet/material order is ready for pickup at our Las Vegas warehouse.')" style="font-size:11.5px;padding:4px 8px;background:#fff">📦 Order Ready</button>
          <button type="button" class="btn secondary" onclick="applySmsTemplate('📄 Please review and approve your updated Cabella quote/invoice.')" style="font-size:11.5px;padding:4px 8px;background:#fff">📄 Quote Review</button>
          <button type="button" class="btn secondary" onclick="applySmsTemplate('⏰ Please confirm driver ETA for today\'s jobsite delivery.')" style="font-size:11.5px;padding:4px 8px;background:#fff">⏰ Delivery ETA</button>
          <button type="button" class="btn secondary" onclick="applySmsTemplate('📞 Please call me back when you have a moment.')" style="font-size:11.5px;padding:4px 8px;background:#fff">📞 Call Back Request</button>
          <button type="button" class="btn secondary" onclick="applySmsTemplate('🏢 Internal Team: Please check updated project notes on Cabella Portal.')" style="font-size:11.5px;padding:4px 8px;background:#fff">🏢 Staff Update</button>
        </div>
      </div>

      <div style="margin-bottom:16px">
        <label style="display:block;font-size:12px;font-weight:800;color:#475569;margin-bottom:4px">Text Message Content</label>
        <textarea id="smsModalBody" rows="4" placeholder="Type text message here..." style="width:100%;padding:10px;border:1px solid #cbd5e1;border-radius:8px;font-size:13.5px;font-family:inherit;resize:vertical;box-sizing:border-box"></textarea>
      </div>

      <div style="display:flex;justify-content:space-between;align-items:center;background:#f8fafc;padding:12px 16px;border-radius:8px;border:1px solid #e2e8f0;flex-wrap:wrap;gap:10px">
        <div style="font-size:12px;color:#64748b;font-weight:600">
          Sending as: <strong style="color:#0f2942">${esc(activeName)} (${esc(activeRole)})</strong>
        </div>
        <div style="display:flex;gap:8px">
          <button type="button" onclick="closeModal()" class="btn secondary" style="font-size:13px;padding:8px 14px">Cancel</button>
          <button type="button" onclick="dispatchSmsFromModal()" class="btn" style="background:#0284c7;color:#fff;font-weight:800;font-size:13px;padding:8px 18px;border:0">
            📤 Dispatch Text / SMS
          </button>
        </div>
      </div>
    </div>
  `;

  if (typeof showModal === "function") {
    showModal("💬 Direct Text & RingCentral Dispatcher", content, "680px");
  }
}

function switchSmsModalMode(mode) {
  const modeVal = document.getElementById("smsModalModeVal");
  const extBtn = document.getElementById("smsModeExtBtn");
  const intBtn = document.getElementById("smsModeIntBtn");
  if (modeVal) modeVal.value = mode;

  if (mode === "external") {
    if (extBtn) { extBtn.style.background = "#061a33"; extBtn.style.color = "#fff"; }
    if (intBtn) { intBtn.style.background = "transparent"; intBtn.style.color = "#475569"; }
  } else {
    if (extBtn) { extBtn.style.background = "transparent"; extBtn.style.color = "#475569"; }
    if (intBtn) { intBtn.style.background = "#0284c7"; intBtn.style.color = "#fff"; }
  }
}

function applySmsTemplate(text) {
  const body = document.getElementById("smsModalBody");
  if (body) {
    body.value = text;
    body.focus();
  }
}

function dispatchSmsFromModal() {
  const name = document.getElementById("smsModalName")?.value || "Recipient";
  const phone = document.getElementById("smsModalPhone")?.value || "Main Line";
  const body = document.getElementById("smsModalBody")?.value || "";
  const mode = document.getElementById("smsModalModeVal")?.value || "external";

  if (!body.trim()) {
    alert("Please enter a message before sending.");
    return;
  }

  const activeName = (typeof currentActiveUser !== "undefined" && currentActiveUser.name) ? currentActiveUser.name : "Gil Sirimarco";

  addRcMessageToStream({
    sender: activeName,
    recipient: name,
    phone: phone,
    text: body,
    direction: "outgoing",
    mode: mode,
    time: "Just now"
  });

  if (typeof closeModal === "function") closeModal();
  const typeText = mode === "internal" ? "Internal Staff Ping" : "RingCentral SMS";
  if (typeof showToast === "function") showToast("✅ " + typeText + " dispatched to " + name + " (" + phone + ")");
}

function sendRcQuickSms() {
  const phone = document.getElementById("rcQuickSmsPhone")?.value || "";
  const body = document.getElementById("rcQuickSmsBody")?.value || "";

  if (!phone || !body) {
    alert("Please enter recipient name/phone and message content.");
    return;
  }

  const activeName = (typeof currentActiveUser !== "undefined" && currentActiveUser.name) ? currentActiveUser.name : "Gil Sirimarco";

  addRcMessageToStream({
    sender: activeName,
    recipient: phone,
    phone: phone,
    text: body,
    direction: "outgoing",
    mode: "external",
    time: "Just now"
  });

  clearRcQuickSmsForm();
  if (typeof showToast === "function") showToast("✅ RingCentral SMS sent to " + phone);
}

function clearRcQuickSmsForm() {
  const p = document.getElementById("rcQuickSmsPhone");
  const b = document.getElementById("rcQuickSmsBody");
  if (p) p.value = "";
  if (b) b.value = "";
}

