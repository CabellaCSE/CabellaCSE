        <span style="font-size:11px; background:#1e293b; color:#94a3b8; padding:3px 8px; border-radius:4px">WebRTC Camera Stream</span>
      </div>

      <!-- Camera Viewfinder Window -->
      <div style="position:relative; width:100%; max-width:420px; height:260px; margin:0 auto 16px; background:#000; border:2px dashed #38bdf8; border-radius:12px; display:flex; flex-direction:column; align-items:center; justify-content:center; overflow:hidden">
        
        <!-- Target Laser Frame -->
        <div style="position:absolute; width:180px; height:180px; border:2px solid #22c55e; border-radius:8px; box-shadow:0 0 15px rgba(34,197,94,0.5); pointer-events:none"></div>
        <div style="position:absolute; top:50%; left:20%; right:20%; height:2px; background:#ef4444; box-shadow:0 0 8px #ef4444; animation:scanPulse 1.5s infinite"></div>

        <div style="font-size:36px; margin-bottom:6px">📦</div>
        <div style="font-size:13px; font-weight:800; color:#cbd5e1">Aim camera at Rack QR or Item Barcode</div>
        <div style="font-size:11px; color:#64748b; margin-top:2px">Phone Camera Active (60 FPS)</div>
      </div>

      <!-- Simulated Quick Scan Triggers for Instant Testing -->
      <div style="background:#1e293b; border-radius:8px; padding:12px; margin-bottom:16px; text-align:left">
        <div style="font-size:11.5px; font-weight:800; color:#94a3b8; text-transform:uppercase; margin-bottom:8px">⚡ Tap Test Barcode to Simulate Instant Camera Scan:</div>
        <div style="display:flex; flex-wrap:wrap; gap:6px">
          <button class="btn" style="background:#334155; color:#fff; font-size:11px; font-weight:700; padding:6px 10px; border-radius:6px" onclick="simulateScanResult('B12', 'A-02-B4')">
            Scan B12 Cabinet (Rack A-02)
          </button>
          <button class="btn" style="background:#334155; color:#fff; font-size:11px; font-weight:700; padding:6px 10px; border-radius:6px" onclick="simulateScanResult('CAL-GLD-3CM', 'C-AF2-S4')">
            Scan Calacatta Quartz (Yard AF-2)
          </button>
          <button class="btn" style="background:#334155; color:#fff; font-size:11px; font-weight:700; padding:6px 10px; border-radius:6px" onclick="simulateScanResult('LVP-OAK-NAT', 'D-PR1-P3')">
            Scan Coastal Oak Flooring Pallet
          </button>
        </div>
      </div>

      <div style="display:flex; justify-content:flex-end">
        <button class="btn secondary" style="background:#334155; color:#fff; border:0; padding:8px 16px; border-radius:6px" onclick="closeModal()">Close Camera</button>
      </div>
    </div>
  `;
  showModal('📷 Warehouse Barcode / QR Camera Scanner', content, '500px');
}

function simulateScanResult(sku, loc) {
  closeModal();
  const store = getInventoryStore();
  const item = store.items.find(i => i.sku === sku);
  if (item) {
    showModal(
      '📦 Scanned Item: ' + sku,
      `
        <div style="background:#fff; border-radius:10px">
          <div style="display:flex; align-items:center; gap:12px; margin-bottom:14px; padding-bottom:12px; border-bottom:1px solid #e2e8f0">
            <div style="width:48px; height:48px; border-radius:8px; background:#0284c7; color:#fff; display:flex; align-items:center; justify-content:center; font-size:24px; font-weight:900">
              ✓
            </div>
            <div>
              <div style="font-size:18px; font-weight:900; color:#0f172a">${esc(item.sku)} — ${esc(item.name)}</div>
              <div style="font-size:12.5px; color:#64748b">Category: ${esc(item.category)} · Style: ${esc(item.style)}</div>
            </div>
          </div>

          <div style="background:#f8fafc; border:1px solid #cbd5e1; border-radius:8px; padding:14px; margin-bottom:16px">
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; font-size:13px">
              <div>
                <span style="color:#64748b">Assigned Bin Location:</span>
                <div style="font-size:15px; font-weight:900; color:#1e40af; margin-top:2px">📍 ${esc(item.location)} (${esc(item.bin)})</div>
              </div>
              <div>
                <span style="color:#64748b">Current In Stock:</span>
                <div style="font-size:16px; font-weight:900; color:#166534; margin-top:2px">${item.onHand} ${item.unit}</div>
              </div>
            </div>
          </div>

          <div style="display:flex; justify-content:space-between; gap:10px">
            <button class="btn secondary" onclick="closeModal()">Close</button>
            <button class="btn" style="background:#0284c7; color:#fff; font-weight:800" onclick="closeModal(); openItemDetailModal('${item.id}')">
              ⚙️ Adjust Stock / Relocate Bin
            </button>
          </div>
        </div>
      `,
      '550px'
    );
  }
}

// PRINT QR LABELS (Formatted for standard thermal label printers or 8.5x11 sheets)
function printAllBinLabels() {
  const store = getInventoryStore();
  const items = store.items || [];

  const printWindow = window.open('', '_blank');
  if (!printWindow) {
    showToast('⚠️ Pop-up blocked. Please allow pop-ups to print QR bin labels.');
    return;
  }

  const labelHtml = `
    <!DOCTYPE html>
    <html>
    <head>
      <title>Cabella Warehouse Bin & Rack QR Labels</title>
      <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; padding: 20px; background: #fff; }
        .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
        .label { border: 2px solid #000; padding: 14px; border-radius: 8px; page-break-inside: avoid; text-align: center; }
        .title { font-size: 18px; font-weight: 900; margin-bottom: 2px; }
        .loc { font-size: 22px; font-weight: 900; color: #0284c7; background: #f0f9ff; padding: 4px 8px; border-radius: 4px; display: inline-block; margin: 6px 0; }
        .qr-box { width: 100px; height: 100px; margin: 8px auto; border: 2px solid #333; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: bold; background: #f8fafc; }
        @media print {
          body { padding: 0; }
          button { display: none; }
        }
      </style>
    </head>
    <body>
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; border-bottom:2px solid #333; padding-bottom:10px">
        <div>
          <h2 style="margin:0">Cabella Cabinets & Stone — Warehouse Bin QR Labels</h2>
          <div style="font-size:12px; color:#555">Thermal Label Ready · Print & affix to rack beam</div>
        </div>
        <button onclick="window.print()" style="background:#0284c7; color:#fff; font-weight:bold; font-size:14px; padding:10px 20px; border:0; border-radius:6px; cursor:pointer">🖨️ Print Labels</button>
      </div>

      <div class="grid">
        ${items.map(item => `
          <div class="label">
            <div class="title">${item.sku}</div>
            <div style="font-size:12px; color:#444">${item.name}</div>
            <div class="loc">${item.location} (${item.bin})</div>
            <div class="qr-box">
              [ QR CODE ]<br><span style="font-size:10px">${item.sku}</span>
            </div>
            <div style="font-size:11px; color:#666">${item.aisle} · ${item.rack}</div>
          </div>
        `).join('')}
      </div>
    </body>
    </html>
  `;

  printWindow.document.write(labelHtml);
  printWindow.document.close();
}

function printSingleQrLabel(itemId) {
  const store = getInventoryStore();
  const item = store.items.find(i => i.id === itemId);
  if (!item) return;

  const printWindow = window.open('', '_blank');
  if (!printWindow) return;

  const labelHtml = `
    <!DOCTYPE html>
    <html>
    <head>
      <title>Bin Label - ${item.sku}</title>
      <style>
        body { font-family: sans-serif; text-align: center; padding: 20px; }
        .label { border: 3px solid #000; padding: 20px; max-width: 320px; margin: 0 auto; border-radius: 8px; }
        .title { font-size: 26px; font-weight: 900; }
        .loc { font-size: 26px; font-weight: 900; color: #0284c7; margin: 10px 0; }
        .qr-box { width: 140px; height: 140px; margin: 12px auto; border: 2px solid #333; display: flex; align-items: center; justify-content: center; font-weight: bold; background:#f8fafc }
      </style>
    </head>
    <body onload="window.print()">
      <div class="label">
        <div class="title">${item.sku}</div>
        <div style="font-size:13px; color:#444; margin-top:4px">${item.name}</div>
        <div class="loc">${item.location}</div>
        <div class="qr-box">
          [ QR CODE ]<br>${item.sku}
        </div>
        <div style="font-size:13px; font-weight:bold">${item.aisle} · ${item.rack} · ${item.bin}</div>
      </div>
    </body>
    </html>
  `;
  printWindow.document.write(labelHtml);
  printWindow.document.close();
}

// ITEM DETAIL & EDIT MODAL
function openItemDetailModal(itemId) {
  const store = getInventoryStore();
  const item = store.items.find(i => i.id === itemId);
  if (!item) return;

  const content = `
    <div style="background:#ffffff; border-radius:10px">
      <form id="editInventoryItemForm" onsubmit="event.preventDefault(); saveEditedInventoryItem('${item.id}');">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px">
          <div>
            <label style="display:block; font-size:12px; font-weight:bold; margin-bottom:3px">SKU / Code</label>
            <input id="editInvSku" type="text" value="${esc(item.sku)}" required style="width:100%; padding:8px; border:1px solid #cbd5e1; border-radius:6px; font-weight:bold">
          </div>
          <div>
            <label style="display:block; font-size:12px; font-weight:bold; margin-bottom:3px">Item Description</label>
            <input id="editInvName" type="text" value="${esc(item.name)}" required style="width:100%; padding:8px; border:1px solid #cbd5e1; border-radius:6px">
          </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:10px; margin-bottom:12px">
          <div>
            <label style="display:block; font-size:12px; font-weight:bold; margin-bottom:3px">Physical Stock (On Hand)</label>
            <input id="editInvOnHand" type="number" min="0" value="${item.onHand}" required style="width:100%; padding:8px; border:1px solid #cbd5e1; border-radius:6px; font-size:15px; font-weight:800">
          </div>
          <div>
            <label style="display:block; font-size:12px; font-weight:bold; margin-bottom:3px">Wholesale Net Cost ($)</label>
            <input id="editInvCost" type="number" step="0.01" value="${item.unitCost}" required style="width:100%; padding:8px; border:1px solid #cbd5e1; border-radius:6px; font-weight:bold">
          </div>
          <div>
            <label style="display:block; font-size:12px; font-weight:bold; margin-bottom:3px">3-Day Sales Consumption</label>
            <input id="editInvVel" type="number" min="0" value="${item.salesVelocity3Day}" required style="width:100%; padding:8px; border:1px solid #cbd5e1; border-radius:6px; font-weight:bold">
          </div>
        </div>

        <div style="background:#f8fafc; border:1px solid #cbd5e1; border-radius:8px; padding:12px; margin-bottom:14px">
          <div style="font-weight:800; font-size:12.5px; margin-bottom:6px">📍 Bin Location Assignment</div>
          <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px">
            <div>
              <label style="font-size:11px; color:#475569">Aisle / Row</label>
              <input id="editInvAisle" type="text" value="${esc(item.aisle)}" style="width:100%; padding:6px; border:1px solid #cbd5e1; border-radius:6px; font-size:12px">
            </div>
            <div>
              <label style="font-size:11px; color:#475569">Rack</label>
              <input id="editInvRack" type="text" value="${esc(item.rack)}" style="width:100%; padding:6px; border:1px solid #cbd5e1; border-radius:6px; font-size:12px">
            </div>
            <div>
              <label style="font-size:11px; color:#475569">Bin Slot</label>
              <input id="editInvBin" type="text" value="${esc(item.bin)}" style="width:100%; padding:6px; border:1px solid #cbd5e1; border-radius:6px; font-size:12px">
            </div>
          </div>
        </div>

        <div style="display:flex; justify-content:space-between; align-items:center; border-top:1px solid #e2e8f0; padding-top:12px">
          <button type="button" class="btn secondary" style="color:#b91c1c" onclick="deleteInventoryItem('${item.id}')">Delete SKU</button>
          <div style="display:flex; gap:8px">
            <button type="button" class="btn secondary" onclick="closeModal()">Cancel</button>
            <button type="submit" class="btn" style="background:#0284c7; color:#fff; font-weight:800">Save Item</button>
          </div>
        </div>
      </form>
    </div>
  `;
  showModal('⚙️ Manage Inventory SKU: ' + item.sku, content, '600px');
}

function saveEditedInventoryItem(itemId) {
  const store = getInventoryStore();
  const item = store.items.find(i => i.id === itemId);
  if (!item) return;

  const oldOnHand = item.onHand;
  item.sku = document.getElementById('editInvSku').value.trim();
  item.name = document.getElementById('editInvName').value.trim();
  item.onHand = Number(document.getElementById('editInvOnHand').value) || 0;
  item.unitCost = Number(document.getElementById('editInvCost').value) || 0;
  item.salesVelocity3Day = Number(document.getElementById('editInvVel').value) || 0;
  item.aisle = document.getElementById('editInvAisle').value.trim();
  item.rack = document.getElementById('editInvRack').value.trim();
  item.bin = document.getElementById('editInvBin').value.trim();
  item.location = item.aisle.replace('Aisle ', '') + '-' + item.rack.replace('Rack ', '') + '-' + item.bin.replace('Bin ', '');

  if (oldOnHand !== item.onHand) {
    const diff = item.onHand - oldOnHand;
    const uName = (typeof currentActiveUser !== 'undefined' && currentActiveUser.name) ? currentActiveUser.name : 'Gil Sirimarco (CFO)';
    store.auditLog.unshift({
      id: 'LOG-' + Math.floor(Math.random()*9000 + 1000),
      timestamp: new Date().toLocaleString(),
      type: 'Manual Adjustment',
      sku: item.sku,
      location: item.location,
      qtyChange: (diff > 0 ? '+' : '') + diff,
      user: uName,
      ref: 'Inventory Count Reconciliation'
    });
  }

  saveInventoryStore(store);
  closeModal();
  showToast('💾 Updated SKU ' + item.sku);
  renderInventoryView();
}

function deleteInventoryItem(itemId) {
  if (!confirm('Are you sure you want to remove this SKU from warehouse inventory?')) return;
  const store = getInventoryStore();
  store.items = store.items.filter(i => i.id !== itemId);
  saveInventoryStore(store);
  closeModal();
  showToast('🗑️ Item deleted');
  renderInventoryView();
}

function openAddNewInventoryItemModal() {
  const content = `
    <div style="background:#ffffff; border-radius:10px">
      <form id="addNewInvForm" onsubmit="event.preventDefault(); submitNewInventoryItem();">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px">
          <div>
            <label style="display:block; font-size:12px; font-weight:bold; margin-bottom:3px">SKU / Code *</label>
            <input id="newInvSku" type="text" placeholder="e.g. W3630 or CAL-PRE-01" required style="width:100%; padding:8px; border:1px solid #cbd5e1; border-radius:6px; font-weight:bold">
          </div>
          <div>
            <label style="display:block; font-size:12px; font-weight:bold; margin-bottom:3px">Category *</label>
            <select id="newInvCat" required style="width:100%; padding:8px; border:1px solid #cbd5e1; border-radius:6px; font-weight:bold">
              <option value="Cabinets">Cabinets & Vanity</option>
              <option value="Stone">Quartz & Granite Slabs</option>
              <option value="Flooring">SPC Flooring & Underlayment</option>
              <option value="Hardware">Sinks & Hardware</option>
            </select>
          </div>
        </div>

        <div style="margin-bottom:12px">
          <label style="display:block; font-size:12px; font-weight:bold; margin-bottom:3px">Item Name / Description *</label>
          <input id="newInvName" type="text" placeholder="e.g. 36W x 30H Wall Cabinet (White Shaker)" required style="width:100%; padding:8px; border:1px solid #cbd5e1; border-radius:6px">
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:10px; margin-bottom:12px">
          <div>
            <label style="display:block; font-size:12px; font-weight:bold; margin-bottom:3px">Initial Qty *</label>
            <input id="newInvOnHand" type="number" min="0" value="10" required style="width:100%; padding:8px; border:1px solid #cbd5e1; border-radius:6px; font-weight:bold">
          </div>
          <div>
            <label style="display:block; font-size:12px; font-weight:bold; margin-bottom:3px">Unit Cost ($)</label>
            <input id="newInvCost" type="number" step="0.01" value="120.00" required style="width:100%; padding:8px; border:1px solid #cbd5e1; border-radius:6px; font-weight:bold">
          </div>
          <div>
            <label style="display:block; font-size:12px; font-weight:bold; margin-bottom:3px">Aisle / Row</label>
            <input id="newInvAisle" type="text" value="Aisle A" style="width:100%; padding:8px; border:1px solid #cbd5e1; border-radius:6px">
          </div>
        </div>

        <div style="display:flex; justify-content:flex-end; gap:8px; border-top:1px solid #e2e8f0; padding-top:12px">
          <button type="button" class="btn secondary" onclick="closeModal()">Cancel</button>
          <button type="submit" class="btn" style="background:#059669; color:#fff; font-weight:800">+ Add SKU to Warehouse</button>
        </div>
      </form>
    </div>
  `;
  showModal('+ Add New Warehouse Inventory SKU', content, '550px');
}

function submitNewInventoryItem() {
  const sku = document.getElementById('newInvSku').value.trim();
  const cat = document.getElementById('newInvCat').value;
  const name = document.getElementById('newInvName').value.trim();
  const onHand = Number(document.getElementById('newInvOnHand').value) || 0;
  const cost = Number(document.getElementById('newInvCost').value) || 0;
  const aisle = document.getElementById('newInvAisle').value.trim();

  const store = getInventoryStore();
  const newItem = {
    id: 'SKU-' + sku.replace(/[^a-zA-Z0-9]/g, '-'),
    sku: sku,
    name: name,
    category: cat,
    style: 'Standard Stock',
    vendor: 'Grandwood / HomeCo',
    aisle: aisle,
    rack: 'Rack 01',
    bin: 'Bin 01',
    location: aisle.replace('Aisle ', '') + '-01-01',
    onHand: onHand,
    reserved: 0,
    unitCost: cost,
    retailRate: cost * 2,
    reorderPoint: 5,
    targetStock: 20,
    salesVelocity3Day: 3,
    unit: 'Boxes',
    status: 'In Stock'
  };

  store.items.push(newItem);
  saveInventoryStore(store);
  closeModal();
  showToast('✅ Added new SKU: ' + sku);
  renderInventoryView();
}

function clearInventoryAuditLog() {
  showToast('Audit log filter reset');
}

function openSingleReorderPoModal(itemId, suggestedQty) {
  const store = getInventoryStore();
  const item = store.items.find(i => i.id === itemId);
  if (!item) return;

  const content = `
    <div style="background:#ffffff; border-radius:10px">
      <div style="background:#0284c7; color:#fff; padding:12px 16px; border-radius:8px; margin-bottom:14px">
        <div style="font-weight:800; font-size:15px">⚡ 1-Click Purchase Order to ${esc(item.vendor)}</div>
        <div style="font-size:12px; opacity:0.9">Auto-calculated based on current run-rate depletion velocity.</div>
      </div>

      <div style="background:#f8fafc; border:1px solid #cbd5e1; border-radius:8px; padding:12px; margin-bottom:14px; font-size:13px">
        <div style="display:flex; justify-content:space-between; margin-bottom:4px">
          <span>Reorder SKU:</span>
          <strong>${esc(item.sku)} — ${esc(item.name)}</strong>
        </div>
        <div style="display:flex; justify-content:space-between; margin-bottom:4px">
          <span>Current In Stock:</span>
          <span style="color:#b91c1c; font-weight:800">${item.onHand} units</span>
        </div>
        <div style="display:flex; justify-content:space-between">
          <span>Wholesale Cost / Unit:</span>
          <strong>$${Number(item.unitCost).toFixed(2)}</strong>
        </div>
      </div>

      <div style="margin-bottom:16px">
        <label style="display:block; font-size:12px; font-weight:800; margin-bottom:4px">Order Quantity (Units) *</label>
        <input id="reorderPoQty" type="number" min="1" value="${suggestedQty || 20}" style="width:100%; padding:10px; border:1px solid #cbd5e1; border-radius:6px; font-size:16px; font-weight:900">
      </div>

      <div style="display:flex; justify-content:flex-end; gap:8px">
        <button class="btn secondary" onclick="closeModal()">Cancel</button>
        <button class="btn" style="background:#0284c7; color:#fff; font-weight:800" onclick="submitReorderPo('${item.sku}')">
          ✉️ Dispatch PO to ${esc(item.vendor)}
        </button>
      </div>
    </div>
  `;
  showModal('⚡ Reorder PO: ' + item.sku, content, '500px');
}

function submitReorderPo(sku) {
  const qty = document.getElementById('reorderPoQty')?.value || 20;
  closeModal();
  showToast('🚀 Purchase Order for ' + qty + ' units of ' + sku + ' generated and queued!');
}

function openBatchReorderPoModal() {
  showToast('📦 Multi-Item Vendor RFQ Composer launched');
  openQuoteDispatcher();
}





/* =========================================================================
   QUICKBOOKS ONLINE RECENT ACTIVITY TALLY & UNIVERSAL LOOKUP ENGINE (GIL CFO)
   Tracks Invoices, Estimates, POs, Payments, Clients, Projects & Inventory
   ========================================================================= */

let currentQboSearchFilter = 'all';

function getQboWorkedTodayItems() {
  const store = getQboStore();
  const items = [];

  // Estimates
  (store.estimates || []).forEach(function(est) {
    const itemsSummary = (est.items || []).map(it => (it.product || '') + ' ' + (it.desc || '')).join(', ');
    items.push({
      type: 'Estimate',
      id: est.id,
      name: 'Estimate ' + est.id,
      customer: est.customer,
      company: est.company || '',
      shipTo: est.shipTo || est.jobsite || '',
      date: est.date || '08/15/2026',
      amount: Number(est.total || 0),
      status: est.status || 'Closed',
      statusClass: est.status === 'Closed' ? 'status-closed' : 'status-open',
      statusIcon: est.status === 'Closed' ? '🕒' : '⭕',
      hasPrint: true,
      itemsSummary: itemsSummary,
      raw: est
    });
  });

  // Purchase Orders
  (store.pos || []).forEach(function(po) {
    const itemsSummary = (po.items || []).map(it => (it.product || '') + ' ' + (it.desc || '')).join(', ');
    items.push({
      type: 'Purchase Order',
      id: po.id,
      name: 'Purchase Order ' + po.id,
      customer: po.vendor,
      company: po.vendor,
      shipTo: po.jobsiteRef || '',
      date: po.date || '08/15/2026',
      amount: Number(po.total || 0),
      status: po.status || 'Open',
      statusClass: 'status-open',
      statusIcon: '⭕',
      hasPrint: false,
      itemsSummary: itemsSummary,
      raw: po
    });
  });

  // Invoices
  (store.invoices || []).forEach(function(inv) {
    let statusClass = 'status-paid';
    let statusIcon = '🟢';
    if (inv.status === 'Overdue') {
      statusClass = 'status-overdue';
      statusIcon = '🔴';
    } else if (inv.status === 'Open' || inv.status === 'Unpaid') {
      statusClass = 'status-open';
      statusIcon = '⭕';
    }
    const itemsSummary = (inv.items || []).map(it => (it.product || '') + ' ' + (it.desc || '')).join(', ');
    items.push({
      type: 'Invoice',
      id: inv.id,
      name: 'Invoice ' + inv.id,
      customer: inv.customer,
      company: inv.company || (inv.id === '8381' ? 'Fast Vegas Home Buyers' : ''),
      shipTo: inv.shipTo || inv.jobsite || '',
      date: inv.date || '08/15/2026',
      amount: Number(inv.total || 0),
      status: inv.status || 'Paid in Full',
      statusClass: statusClass,
      statusIcon: statusIcon,
      hasPrint: true,
      itemsSummary: itemsSummary,
      raw: inv
    });
  });

  // Payments & Tax Payments
  (store.payments || []).forEach(function(pay) {
    items.push({
      type: pay.status === 'Tax Payment' ? 'Tax Payment' : 'Payment',
      id: pay.id,
      name: pay.status === 'Tax Payment' ? 'Tax Payment' : 'Payment',
      customer: pay.customer,
      company: pay.customer,
      shipTo: pay.ref || '',
      date: pay.date || '08/15/2026',
      amount: Number(pay.amount || 0),
      status: pay.status || 'Paid',
      statusClass: 'status-paid',
      statusIcon: '🟢',
      hasPrint: false,
      raw: pay
    });
  });

  return items;
}

function openQboSearchDropdown() {
  const dd = document.getElementById('qboSearchDropdown');
  if (dd) {
    dd.style.display = 'block';
    renderQboRecentTransactions(document.getElementById('q') ? document.getElementById('q').value : '');
  }
}

function closeQboSearchDropdown() {
  const dd = document.getElementById('qboSearchDropdown');
  if (dd) {
    dd.style.display = 'none';
  }
}

function toggleQboSearchDropdown() {
  const dd = document.getElementById('qboSearchDropdown');
  if (dd) {
    if (dd.style.display === 'block') {
      closeQboSearchDropdown();
    } else {
      openQboSearchDropdown();
    }
  }
}

function setQboSearchFilter(filterType) {
  currentQboSearchFilter = filterType;
  
  const btnIds = ['all', 'invoices', 'estimates', 'pos', 'payments', 'clients'];
  btnIds.forEach(function(t) {
    const btn = document.getElementById('qboFilterBtn-' + t);
    if (btn) {
      if (t === filterType) {
        btn.style.background = '#0284c7';
        btn.style.color = '#ffffff';
        btn.style.border = '0';
      } else {
        btn.style.background = '#ffffff';
        btn.style.color = '#0f172a';
        btn.style.border = '1px solid #cbd5e1';
      }
    }
  });

  const query = (document.getElementById('q') ? document.getElementById('q').value : '');
  renderQboRecentTransactions(query);
}

function applySearchSuggestion(text) {
  const qInput = document.getElementById('q');
  if (qInput) {
    qInput.value = text;
    handleQboSearchInput(text);
  }
}

function handleQboSearchInput(query) {
  openQboSearchDropdown();
  renderQboRecentTransactions(query);
}

function renderQboRecentTransactions(query) {
  query = query || '';
  const listEl = document.getElementById('qboRecentTransactionsList');
  if (!listEl) return;

  const q = String(query || '').trim().toLowerCase();
  const allItems = getQboWorkedTodayItems();
  const store = getQboStore();

  const countInvoices = allItems.filter(function(x) { return x.type === 'Invoice'; }).length;
  const countEstimates = allItems.filter(function(x) { return x.type === 'Estimate'; }).length;
  const countPos = allItems.filter(function(x) { return x.type === 'Purchase Order'; }).length;
  const countPayments = allItems.filter(function(x) { return x.type === 'Payment' || x.type === 'Tax Payment'; }).length;
  const countClients = (store.projects || []).length;
  const countTotal = allItems.length;

  if (document.getElementById('qboTallyTotalCount')) document.getElementById('qboTallyTotalCount').textContent = countTotal;
  if (document.getElementById('topTallyCountBadge')) document.getElementById('topTallyCountBadge').textContent = countTotal;
  if (document.getElementById('filterCount-all')) document.getElementById('filterCount-all').textContent = countTotal;
  if (document.getElementById('filterCount-invoices')) document.getElementById('filterCount-invoices').textContent = countInvoices;
  if (document.getElementById('filterCount-estimates')) document.getElementById('filterCount-estimates').textContent = countEstimates;
  if (document.getElementById('filterCount-pos')) document.getElementById('filterCount-pos').textContent = countPos;
  if (document.getElementById('filterCount-payments')) document.getElementById('filterCount-payments').textContent = countPayments;
  if (document.getElementById('filterCount-clients')) document.getElementById('filterCount-clients').textContent = countClients;

  let filtered = allItems;

  if (currentQboSearchFilter === 'invoices') {
    filtered = filtered.filter(function(x) { return x.type === 'Invoice'; });
  } else if (currentQboSearchFilter === 'estimates') {
    filtered = filtered.filter(function(x) { return x.type === 'Estimate'; });
  } else if (currentQboSearchFilter === 'pos') {
    filtered = filtered.filter(function(x) { return x.type === 'Purchase Order'; });
  } else if (currentQboSearchFilter === 'payments') {
    filtered = filtered.filter(function(x) { return x.type === 'Payment' || x.type === 'Tax Payment'; });
  }

  if (q) {
    filtered = filtered.filter(function(x) {
      return x.name.toLowerCase().includes(q) ||
             (x.customer && x.customer.toLowerCase().includes(q)) ||
             x.id.toLowerCase().includes(q) ||
             (x.amount && x.amount.toString().includes(q)) ||
             (x.status && x.status.toLowerCase().includes(q));
    });
  }

  const sugBox = document.getElementById('qboSearchSuggestionsBox');
  if (sugBox) {
    sugBox.style.display = q ? 'none' : 'block';
  }

  if (filtered.length === 0 && currentQboSearchFilter !== 'clients') {
    listEl.innerHTML = '<div style="padding:16px; text-align:center; color:#64748b; font-size:13px">No transactions matching "<strong>' + (typeof escapeHtml === 'function' ? escapeHtml(query) : query) + '</strong>" found in today\'s tally.</div>';
  } else {
    let rowsHtml = '';
    for (let i = 0; i < filtered.length; i++) {
      const item = filtered[i];
      const formattedAmount = item.amount ? ('$' + Number(item.amount).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })) : '$0.00';
      
      let statusBg = '#e2e8f0';
      let statusColor = '#0f172a';
      if (item.status === 'Paid' || item.status === 'Paid in Full') {
        statusBg = '#dcfce7';
        statusColor = '#166534';
      } else if (item.status === 'Overdue') {
        statusBg = '#fee2e2';
        statusColor = '#991b1b';
      } else if (item.status === 'Closed') {
        statusBg = '#f1f5f9';
        statusColor = '#475569';
      } else if (item.status === 'Open' || item.status === 'Unpaid') {
        statusBg = '#e0f2fe';
        statusColor = '#0369a1';
      }

      const safeCust = (typeof escapeHtml === 'function') ? escapeHtml(item.customer || '') : (item.customer || '');
      const printBtn = item.hasPrint 
        ? '<button onclick="event.stopPropagation(); printQboTransaction(\'' + item.type + '\', \'' + item.id + '\')" title="Print ' + item.type + '" style="background:transparent; border:0; color:#64748b; cursor:pointer; font-size:14px; padding:2px 4px; border-radius:4px" onmouseover="this.style.color=\'#0f172a\'" onmouseout="this.style.color=\'#64748b\'">🖨️</button>'
        : '<span style="width:22px"></span>';

      rowsHtml += '<div onclick="openQboTransactionItem(\'' + item.type + '\', \'' + item.id + '\', \'' + safeCust.replace(/'/g, "\\'") + '\')" ' +
        'style="display:flex; justify-content:space-between; align-items:center; padding:9px 12px; border-radius:6px; cursor:pointer; font-size:13px; transition:background 0.15s; border-bottom:1px solid #f8fafc" ' +
        'onmouseover="this.style.background=\'#f8fafc\'" ' +
        'onmouseout="this.style.background=\'transparent\'">' +
        '<div style="display:flex; align-items:center; gap:10px; flex:1; min-width:0">' +
          '<span style="font-size:14px; color:#64748b">🕒</span>' +
          '<div style="font-weight:800; color:#0f172a; min-width:140px; white-space:nowrap">' + item.name + '</div>' +
          '<div style="color:#334155; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; flex:1">' + safeCust + '</div>' +
        '</div>' +
        '<div style="display:flex; align-items:center; gap:14px; flex-shrink:0">' +
          '<span style="color:#64748b; font-size:12px; font-weight:500">' + item.date + '</span>' +
          '<span style="font-weight:800; color:#0f172a; font-size:13.5px; min-width:80px; text-align:right">' + formattedAmount + '</span>' +
          '<span style="background:' + statusBg + '; color:' + statusColor + '; padding:3px 8px; border-radius:12px; font-size:11px; font-weight:800; display:flex; align-items:center; gap:4px">' +
            '<span>' + item.statusIcon + '</span> <span>' + item.status + '</span>' +
          '</span>' +
          printBtn +
        '</div>' +
      '</div>';
    }
    listEl.innerHTML = rowsHtml;
  }

  // Handle Clients & Projects Section
  const cpSection = document.getElementById('qboClientsProjectsMatchSection');
  const cpList = document.getElementById('qboClientsProjectsList');
  if (cpSection && cpList) {
    const clients = store.projects || [];
    let matchedCP = clients;
    if (q) {
      matchedCP = clients.filter(function(p) {
        return (p.name && p.name.toLowerCase().includes(q)) ||
               (p.client && p.client.toLowerCase().includes(q)) ||
               (p.address && p.address.toLowerCase().includes(q)) ||
               (p.pm && p.pm.toLowerCase().includes(q));
      });
    }

    if (currentQboSearchFilter === 'clients' || (q && matchedCP.length > 0)) {
      cpSection.style.display = 'block';
      let cpHtml = '';
      for (let j = 0; j < matchedCP.length; j++) {
        const p = matchedCP[j];
        const pClient = (typeof escapeHtml === 'function') ? escapeHtml(p.client) : p.client;
        const pName = (typeof escapeHtml === 'function') ? escapeHtml(p.name) : p.name;
        const pAddr = (typeof escapeHtml === 'function') ? escapeHtml(p.address) : p.address;
        const pPm = (typeof escapeHtml === 'function') ? escapeHtml(p.pm) : p.pm;
        const pStatus = (typeof escapeHtml === 'function') ? escapeHtml(p.status) : p.status;
        cpHtml += '<div onclick="openQboProjectItem(\'' + p.id + '\', \'' + pClient.replace(/'/g, "\\'") + '\')" style="display:flex; justify-content:space-between; align-items:center; padding:8px 12px; border-radius:6px; background:#f8fafc; border:1px solid #e2e8f0; cursor:pointer; font-size:13px" onmouseover="this.style.background=\'#f1f5f9\'" onmouseout="this.style.background=\'#f8fafc\'">' +
          '<div>' +
            '<div style="font-weight:800; color:#0b57d0">📁 ' + pName + ' (' + pClient + ')</div>' +
            '<div style="font-size:11.5px; color:#64748b">📍 ' + pAddr + ' | PM: ' + pPm + '</div>' +
          '</div>' +
          '<div style="text-align:right">' +
            '<div style="font-weight:800; color:#0f172a">$' + Number(p.contractValue || 0).toLocaleString() + '</div>' +
            '<div style="font-size:11px; color:#166534; font-weight:700">🟢 ' + pStatus + '</div>' +
          '</div>' +
        '</div>';
      }
      cpList.innerHTML = cpHtml;
    } else {
      cpSection.style.display = 'none';
    }
  }

  // Handle Warehouse SKUs & Bins Section
  const invSection = document.getElementById('qboInventoryMatchSection');
  const invList = document.getElementById('qboInventoryMatchList');
  if (invSection && invList && q) {
    let invItems = [];
    try {
      const invStore = getInventoryStore();
      invItems = invStore.items || [];
    } catch(e) {}

    const matchedInv = invItems.filter(function(item) {
      return (item.sku && item.sku.toLowerCase().includes(q)) ||
             (item.name && item.name.toLowerCase().includes(q)) ||
             (item.bin && item.bin.toLowerCase().includes(q)) ||
             (item.category && item.category.toLowerCase().includes(q));
    });

    if (matchedInv.length > 0) {
      invSection.style.display = 'block';
      let invHtml = '';
      const limit = Math.min(matchedInv.length, 4);
      for (let k = 0; k < limit; k++) {
        const it = matchedInv[k];
        const itSku = (typeof escapeHtml === 'function') ? escapeHtml(it.sku) : it.sku;
        const itName = (typeof escapeHtml === 'function') ? escapeHtml(it.name) : it.name;
        const itBin = (typeof escapeHtml === 'function') ? escapeHtml(it.bin) : it.bin;
        invHtml += '<div onclick="closeQboSearchDropdown(); show(\'inventory\'); openInventoryDetail(\'' + it.id + '\')" style="display:flex; justify-content:space-between; align-items:center; padding:7px 10px; border-radius:6px; background:#f0fdf4; border:1px solid #bbf7d0; cursor:pointer; font-size:12.5px">' +
          '<div>' +
            '<span style="font-weight:800; color:#166534">📦 ' + itSku + '</span> - <span>' + itName + '</span>' +
            '<span style="font-size:11px; color:#64748b; margin-left:6px">📍 Bin: ' + itBin + '</span>' +
          '</div>' +
          '<div style="font-weight:800; color:#0f172a">' + it.stock + ' in stock</div>' +
        '</div>';
      }
      invList.innerHTML = invHtml;
    } else {
      invSection.style.display = 'none';
    }
  } else if (invSection) {
    invSection.style.display = 'none';
  }
}

function openQboTransactionItem(type, id, customer) {
  closeQboSearchDropdown();
  if (type === 'Invoice' || type === 'Estimate' || type === 'Purchase Order' || type === 'Bill') {
    openQboTransactionModal(type, id);
  } else if (type === 'Payment' || type === 'Tax Payment') {
    const safeCust = (typeof escapeHtml === 'function') ? escapeHtml(customer) : customer;
    showModal('💳 ' + type + ' Details', '<div style="padding:10px">' +
      '<div style="background:#f8fafc; border:1px solid #cbd5e1; border-radius:8px; padding:16px; margin-bottom:14px">' +
        '<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px">' +
          '<span style="font-size:18px; font-weight:900; color:#0f172a">' + type + ' #' + id + '</span>' +
          '<span style="background:#dcfce7; color:#166534; padding:4px 10px; border-radius:12px; font-weight:800; font-size:12px">🟢 Cleared / Synced</span>' +
        '</div>' +
        '<div style="font-size:13.5px; color:#334155; margin-bottom:6px"><strong>Customer / Entity:</strong> ' + safeCust + '</div>' +
        '<div style="font-size:13.5px; color:#334155; margin-bottom:6px"><strong>Transaction Date:</strong> 08/14/2026</div>' +
        '<div style="font-size:13.5px; color:#334155; margin-bottom:6px"><strong>Settlement Method:</strong> Zelle / Wire / QuickBooks Direct</div>' +
        '<div style="font-size:13.5px; color:#334155"><strong>Sync Status:</strong> Recorded in QuickBooks Online Chart of Accounts</div>' +
      '</div>' +
      '<div style="display:flex; justify-content:flex-end; gap:8px">' +
        '<button class="btn" style="background:#0284c7; color:#fff" onclick="closeModal(); show(\'accounting\'); switchQboTab(\'invoices\');">Go to QuickBooks Invoices & Payments</button>' +
        '<button class="btn secondary" onclick="closeModal()">Close</button>' +
      '</div>' +
    '</div>', '580px');
  }
}

function openQboProjectItem(projectId, clientName) {
  closeQboSearchDropdown();
  show('accounting');
  switchQboTab('projects');
}

function printQboTransaction(type, id) {
  closeQboSearchDropdown();
  openQboTransactionModal(type, id);
  setTimeout(function() {
    window.print();
  }, 400);
}

// Click outside listener to dismiss the QBO search dropdown cleanly
document.addEventListener('click', function(e) {
  const dd = document.getElementById('qboSearchDropdown');
  const searchContainer = document.querySelector('.search');
  const workedBtn = document.getElementById('recentActivityHeaderBtn');
  if (dd && dd.style.display === 'block') {
    if (!dd.contains(e.target) && (!searchContainer || !searchContainer.contains(e.target)) && (!workedBtn || !workedBtn.contains(e.target))) {
      closeQboSearchDropdown();
    }
  }
});

</script>
</body>
</html>