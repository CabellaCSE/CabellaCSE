  function renderPlHomeCoCabinets(q) {
    const body = document.getElementById('plHcCabinetTableBody');
    if (!body) return;
    const query = (q || '').trim().toLowerCase();
    const data = (typeof CABINET_COMPARISON_DATA !== 'undefined') ? CABINET_COMPARISON_DATA : [];
    const items = data.filter(item => {
      if (item.hcList === null) return false;
      return !query || item.sku.toLowerCase().includes(query) || item.name.toLowerCase().includes(query) || (item.desc || '').toLowerCase().includes(query) || (item.cat || '').toLowerCase().includes(query);
    });

    if (items.length === 0) {
      body.innerHTML = `<tr><td colspan="6" style="padding:16px;text-align:center;color:var(--muted)">No HomeCo cabinets found matching "${esc(query)}".</td></tr>`;
      return;
    }

    body.innerHTML = items.slice(0, 100).map(item => {
      const listPrice = Number(item.hcList || 0);
      const cabellaCost = (listPrice * 0.40).toFixed(2);
      return `
        <tr style="border-bottom:1px solid #e2e8f0">
          <td style="padding:8px 12px;font-weight:bold;font-family:monospace;color:#0f2942">${esc(item.sku)}</td>
          <td style="padding:8px 12px;font-size:12px;color:var(--muted)"><span class="badge" style="margin:0;font-size:10.5px;background:#e6f4ea;color:#137333">${esc(item.cat)}</span></td>
          <td style="padding:8px 12px;font-size:13px">${esc(item.name)} ${item.desc ? `<span style="color:#64748b;font-size:11px">(${esc(item.desc)})</span>` : ''}</td>
          <td style="padding:8px 10px;text-align:right;color:#64748b;text-decoration:line-through">${listPrice.toFixed(2)}</td>
          <td style="padding:8px 10px;text-align:center;font-weight:bold;color:#059669"><span style="background:#d1fae5;padding:2px 6px;border-radius:4px;font-size:11px;color:#065f46">Wholesale Net</span></td>
          <td style="padding:8px 10px;text-align:right;font-weight:bold;color:#047857;background:#f0fdf4">${cabellaCost}</td>
        </tr>
      `;
    }).join('');
  }

  function renderPlGrandwoodCabinets(q) {
    const body = document.getElementById('plGwTableBody');
    if (!body) return;
    const query = (q || '').trim().toLowerCase();
    const data = (typeof CABINET_COMPARISON_DATA !== 'undefined') ? CABINET_COMPARISON_DATA : [];
    const items = data.filter(item => {
      return !query || item.sku.toLowerCase().includes(query) || item.name.toLowerCase().includes(query) || (item.desc || '').toLowerCase().includes(query) || (item.cat || '').toLowerCase().includes(query);
    });

    if (items.length === 0) {
      body.innerHTML = `<tr><td colspan="5" style="padding:16px;text-align:center;color:var(--muted)">No Grandwood cabinets found matching "${esc(query)}".</td></tr>`;
      return;
    }

    body.innerHTML = items.slice(0, 100).map(item => {
      const swCost = Number(item.gw || 0).toFixed(2);
      const dcCost = Number(item.gw * 1.05 || 0).toFixed(2);
      return `
        <tr style="border-bottom:1px solid #e2e8f0">
          <td style="padding:8px 12px;font-weight:bold;font-family:monospace;color:#0f2942">${esc(item.sku)}</td>
          <td style="padding:8px 12px;font-size:12px;color:var(--muted)"><span class="badge" style="margin:0;font-size:10.5px;background:#f1f5f9;color:#334155">${esc(item.cat)}</span></td>
          <td style="padding:8px 12px;font-size:13px">${esc(item.name)} ${item.desc ? `<span style="color:#64748b;font-size:11px">(${esc(item.desc)})</span>` : ''}</td>
          <td style="padding:8px 10px;text-align:right;font-weight:bold;color:#1e293b">${swCost}</td>
          <td style="padding:8px 10px;text-align:right;font-weight:bold;color:#0284c7">${dcCost}</td>
        </tr>
      `;
    }).join('');
  }

  function renderPlAchillesStone(q) {
    const body = document.getElementById('plAchillesTableBody');
    if (!body) return;
    const query = (q || '').trim().toLowerCase();
