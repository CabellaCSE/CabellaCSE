function isCurrentActiveUserAdmin() {
  if (typeof currentActiveUser === 'undefined' || !currentActiveUser) return true;
  if (typeof currentActiveUser.isAdmin === 'boolean') return currentActiveUser.isAdmin;
  const role = (currentActiveUser.qboRole || '').toLowerCase();
  return role.includes('admin') || role.includes('primary admin') || role.includes('company admin') || role.includes('all access');
}


function updateHomeSmsTabulation() {
  const el = document.getElementById('homeSmsTabulationText');
  if (!el) return;
  try {
    const data = (typeof getDispatchData === 'function') ? getDispatchData() : null;
    if (data && data.manifests && data.currentManifestDate) {
      const manifest = data.manifests[data.currentManifestDate];
      if (manifest && manifest.trucks) {
        let totalStops = 0;
        let truckCount = manifest.trucks.length;
        manifest.trucks.forEach(t => {
          if (t.rows) totalStops += t.rows.length;
        });
        el.textContent = `Delivery SMS (${totalStops} Stops Tabulated · ${truckCount} Trucks)`;
        return;
      }
    }
  } catch (e) {
    console.error('SMS tabulation error:', e);
  }
  el.textContent = 'Delivery SMS (21 Stops Tabulated · 2 Trucks)';
}

function updateRoleBasedFinancialVisibility() {
  updateHomeSmsTabulation();
  const isAdmin = isCurrentActiveUserAdmin();
  const userName = currentActiveUser ? currentActiveUser.name : 'Gil Sirimarco';

  // 1. Home Command Center - BANK & FINANCIALS
  const bankBoxVal = document.getElementById('homeQboBankVal');
  const netBoxVal = document.getElementById('homeQboNetVal');
  const spendBoxVal = document.getElementById('homeQboSpendVal');
  const loanBoxVal = document.getElementById('homeQboLoanVal');
  const bankNotice = document.getElementById('homeBankNotice');
  const bankRoleBadge = document.getElementById('homeBankRoleBadge');

  if (bankBoxVal) bankBoxVal.innerHTML = isAdmin ? '$12,973.00' : '<span style="color:#64748b; font-size:12px; font-weight:800">🔒 Admin Only</span>';
  if (netBoxVal) netBoxVal.innerHTML = isAdmin ? '$152,457.00 <small style="font-size:10px; color:#15803d">(↑292%)</small>' : '<span style="color:#64748b; font-size:12px; font-weight:800">🔒 Admin Only</span>';
  if (spendBoxVal) spendBoxVal.innerHTML = isAdmin ? '$546,582.00' : '<span style="color:#64748b; font-size:12px; font-weight:800">🔒 Admin Only</span>';
  if (loanBoxVal) loanBoxVal.innerHTML = isAdmin ? '$3,095.00' : '<span style="color:#64748b; font-size:12px; font-weight:800">🔒 Admin Only</span>';
  if (bankNotice) bankNotice.style.display = isAdmin ? 'none' : 'block';
  if (bankRoleBadge) {
    bankRoleBadge.style.background = isAdmin ? '#e0f2fe' : '#ffe4e6';
    bankRoleBadge.style.color = isAdmin ? '#0369a1' : '#9f1239';
    bankRoleBadge.innerHTML = isAdmin ? 'LIVE SYNC' : '🔒 RESTRICTED';
  }

  // 2. Home Command Center - SALES & GET PAID FUNNEL
  const arVal = document.getElementById('homeQboArVal');
  const paidVal = document.getElementById('homeQboPaidVal');
  const depositedVal = document.getElementById('homeQboDepositedVal');

  if (arVal) arVal.innerHTML = '$42,150.58'; // Visible for open sales collection
  if (paidVal) paidVal.innerHTML = isAdmin ? '$114,554.00' : '<span style="color:#64748b; font-size:12px; font-weight:800">🔒 Restricted</span>';
  if (depositedVal) depositedVal.innerHTML = isAdmin ? '$45,955.92' : '<span style="color:#64748b; font-size:12px; font-weight:800">🔒 Restricted</span>';

  // 3. QBO Hub Executive Top KPI Tiles
  const qboNetIncome = document.getElementById('qboKpiNetIncome');
  const qboArBalance = document.getElementById('qboKpiArBalance');
  const qboApBalance = document.getElementById('qboKpiApBalance');
  const qboBankBalance = document.getElementById('qboKpiBankBalance');

  if (qboNetIncome) qboNetIncome.innerHTML = isAdmin ? '$152,457.00' : '🔒 Restricted';
  if (qboArBalance) qboArBalance.innerHTML = '$42,150.58';
  if (qboApBalance) qboApBalance.innerHTML = isAdmin ? '$18,240.00' : '🔒 Restricted';
  if (qboBankBalance) qboBankBalance.innerHTML = isAdmin ? '$12,973.00' : '🔒 Restricted';
}

function switchQboTab(tabId) {
  const adminOnlyTabs = ['accounts', 'reports', 'sync', 'payroll'];
  const isAdmin = isCurrentActiveUserAdmin();

  // Hide all qbo tab contents
  const contents = document.querySelectorAll('.qbo-tab-content');
  contents.forEach(el => el.style.display = 'none');

  // Deactivate all qbo nav buttons
  const buttons = document.querySelectorAll('.qbo-nav-tab');
  buttons.forEach(btn => btn.classList.remove('active'));

  const targetBtn = document.getElementById('qboTabBtn-' + tabId);
  if (targetBtn) targetBtn.classList.add('active');

  const targetContent = document.getElementById('qboTabContent-' + tabId);
  if (targetContent) {
    if (adminOnlyTabs.includes(tabId) && !isAdmin) {
      targetContent.style.display = 'block';
      targetContent.innerHTML = `
        <div style="background:#fff; border:2px solid #fecdd3; border-radius:12px; padding:36px 24px; text-align:center; max-width:620px; margin:30px auto; box-shadow:0 10px 25px rgba(0,0,0,0.06)">
          <div style="font-size:48px; margin-bottom:12px">🔒</div>
          <h3 style="margin:0 0 8px; font-size:20px; font-weight:800; color:#881337">Administrative Access Restricted</h3>
          <p style="margin:0 0 16px; font-size:14px; color:#9f1239; line-height:1.5">
            The <strong>${tabId.toUpperCase()}</strong> tab contains confidential executive accounting data. 
            Your current account <strong>${esc(currentActiveUser ? currentActiveUser.name : 'User')}</strong> is assigned the role <strong>${esc(currentActiveUser ? (currentActiveUser.qboRole || 'Sales QB User') : 'Sales QB User')}</strong>.
          </p>
          <div style="background:#fff1f2; border:1px solid #fda4af; border-radius:8px; padding:12px; font-size:12.5px; color:#475569; text-align:left; line-height:1.4; margin-bottom:20px">
            <strong>ℹ️ QuickBooks Permissions Notice:</strong> Only QBO Primary Admins & Company Admins (Gil Sirimarco, Edwin Portillo, Dave Siefers) have authorization to view Chart of Accounts, Company Financial Reports, Payroll & Team, and Direct QBO Batch Integrations.
          </div>
          <button onclick="openSettingsModal('permissions')" style="background:#9f1239; color:#fff; font-weight:800; border:0; padding:10px 20px; border-radius:8px; cursor:pointer; font-size:13px; box-shadow:0 4px 10px rgba(159,18,57,0.3)">
            🔑 Manage Users & Switch Active Account
          </button>
        </div>
      `;
    } else {
      targetContent.style.display = 'block';
      if (typeof renderAllQboTables === 'function') renderAllQboTables();
    }
  }
}




