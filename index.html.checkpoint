            <div><strong>Vehicle / License Plate:</strong> ${esc(release.vehiclePlate)}</div>
            <div><strong>Warehouse Attendant:</strong> ${esc(release.signedByStaff)}</div>
          </div>
        </div>

        <div style="background: #f8fafc; border: 1px solid #cbd5e1; padding: 10px 12px; border-radius: 6px; margin-bottom: 16px; font-size: 12.5px">
          <div style="font-weight: 800; color: #0f172a; margin-bottom: 2px">📦 ITEMS & MATERIALS RELEASED:</div>
          <div>${esc(order.itemsSummary)}</div>
        </div>

        <div style="font-size: 11px; color: #64748b; line-height: 1.4; margin-bottom: 16px; background: #fff; border: 1px dashed #cbd5e1; padding: 8px 10px; border-radius: 6px">
          <strong>Customer Inspection & Condition Acknowledgement:</strong> By signing below, the recipient confirms that all cabinet boxes, quartz/granite stone slabs, trim pieces, and flooring listed on this order have been inspected, accounted for, and safely loaded into the recipient's vehicle in good condition without visible damage.
        </div>

        <div style="display: flex; justify-content: space-between; align-items: flex-end; border-top: 1px solid #cbd5e1; padding-top: 14px">
          <div style="flex: 1; max-width: 320px">
            <div style="font-size: 11px; font-weight: 800; color: #475569; margin-bottom: 4px; text-transform: uppercase">DIGITAL CLIENT SIGNATURE:</div>
            <div style="border: 1px solid #cbd5e1; background: #fafafa; border-radius: 6px; padding: 6px; display: inline-block">
              <img src="${release.signatureDataUrl}" alt="Client Signature" style="max-height: 70px; display: block">
            </div>
            <div style="font-size: 11px; font-weight: 800; color: #0f172a; margin-top: 4px">${esc(release.clientName)} — ${release.signedAt}</div>
          </div>

          <div style="text-align: right">
            <div style="font-size: 11px; color: #64748b">Cabella Warehouse Operations</div>
            <div style="font-size: 12px; font-weight: 800; color: #0f172a">Las Vegas Main Facility</div>
