            <div><strong>Customer:</strong> ${esc(order.customer)}</div>
            <div><strong>Invoice #:</strong> ${esc(order.invoiceNumber || 'N/A')}</div>
            <div><strong>PO #:</strong> ${esc(order.poNumber || 'N/A')}</div>
          </div>

          <div style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 10px 12px; border-radius: 6px">
            <div style="font-weight: 800; color: #64748b; font-size: 10.5px; text-transform: uppercase; margin-bottom: 4px">SIGNER / VEHICLE DETAILS</div>
            <div><strong>Signer Printed Name:</strong> ${esc(release.clientName)}</div>
