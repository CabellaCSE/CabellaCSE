r"},{"name":"Plus","customer":"Established customers who purchase consistently","position":"Middle customer pricing tier"},{"name":"Premier","customer":"New, occasional, or one-time professional customers","position":"Highest customer pricing tier"}]};
let custom=JSON.parse(localStorage.getItem('cseV1Custom')||'[]');
const views=[...document.querySelectorAll('.view')];const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
let viewHistory=['home'],historyIndex=0;
function goBack() {
  if (typeof historyIndex !== "undefined" && historyIndex > 0) {
    historyIndex--;
    const targetView = viewHistory[historyIndex];
    show(targetView, false);
  } else {
    show('home', false);
  }
}

function goForward() {
  if (typeof historyIndex !== "undefined" && typeof viewHistory !== "undefined" && historyIndex < viewHistory.length - 1) {
    historyIndex++;
    const targetView = viewHistory[historyIndex];
    show(targetView, false);
  }
}

function closeCurrentPage() {
  let closedModal = false;
  const modals = document.querySelectorAll('.modal-backdrop, .modal, [id$="Modal"], [id$="Overlay"]');
  modals.forEach(m => {
    if (m && (m.style.display === "block" || m.style.display === "flex" || m.classList.contains("active"))) {
      m.style.display = "none";
      m.classList.remove("active");
      closedModal = true;
    }
  });
  show("home");
}

function updateHistoryButtons() {
  const b = document.getElementById("backBtn");
  const f = document.getElementById("forwardBtn");
  const c = document.getElementById("closePageBtn");
  const gb = document.getElementById("globalBackBtn");

  const currentView = (typeof viewHistory !== "undefined" && viewHistory.length > 0) ? viewHistory[historyIndex] : "home";

  if (gb) {
    gb.style.display = (currentView !== "home") ? "inline-flex" : "none";
  }

  if (b) {
    const canBack = (typeof historyIndex !== "undefined") && historyIndex > 0;
    b.disabled = !canBack;
    b.style.opacity = canBack ? "1" : "0.4";
    b.style.cursor = canBack ? "pointer" : "not-allowed";
    b.style.background = canBack ? "#ffffff" : "#f1f5f9";
    b.style.color = canBack ? "#0f2942" : "#94a3b8";
    b.style.borderColor = canBack ? "#cbd5e1" : "#e2e8f0";
  }

  if (f) {
    const canForward = (typeof historyIndex !== "undefined") && (typeof viewHistory !== "undefined") && historyIndex < viewHistory.length - 1;
    f.disabled = !canForward;
    f.style.opacity = canForward ? "1" : "0.4";
    f.style.cursor = canForward ? "pointer" : "not-allowed";
    f.style.background = canForward ? "#ffffff" : "#f1f5f9";
    f.style.color = canForward ? "#0f2942" : "#94a3b8";
    f.style.borderColor = canForward ? "#cbd5e1" : "#e2e8f0";
  }

  if (c) {
    c.style.display = (currentView !== "home") ? "inline-flex" : "none";
  }
}

document.addEventListener("keydown", (e) => {
  if (e.key === "Escape") {
    closeCurrentPage();
  }
  if (e.altKey && e.key === "ArrowLeft") {
    goBack();
  }
  if (e.altKey && e.key === "ArrowRight") {
    goForward();
  }
});function switchOnboardingTab(tabName) {
  const tabs = ['story', 'roadmap', 'workflow', 'policies'];
  tabs.forEach(t => {
    const btn = document.getElementById('obTabBtn-' + t);
    const content = document.getElementById('obTabContent-' + t);
    if (btn) btn.classList.toggle('active', t === tabName);
    if (content) {
      content.style.display = (t === tabName) ? 'block' : 'none';
      content.classList.toggle('active', t === tabName);
    }
  });
  if (tabName === 'workflow') {
    renderWorkflow();
  }
  scrollTo(0, 0);
}

function show(id,record=true,categoryFilter=''){
  let targetTab = null;
  if(id === 'company'){
    id = 'start';
    targetTab = 'story';
  } else if(id === 'workflow'){
    id = 'start';
    targetTab = 'workflow';
  }
  views.forEach(v=>v.classList.toggle('active',v.id===id));
  if(record&&viewHistory[historyIndex]!==id){
    viewHistory=viewHistory.slice(0,historyIndex+1);
    viewHistory.push(id);
    historyIndex=viewHistory.length-1;
  }
  updateHistoryButtons();
  scrollTo(0,0);
  renderSidebarNav();
  if(id === 'start'){
    if(targetTab){
      switchOnboardingTab(targetTab);
    } else if(!document.querySelector('.ob-tab-btn.active')){
      switchOnboardingTab('story');
    }
  }
  if(id==='inventory'){ renderInventoryView(); }
  if(id==='pricing'){
    const catEl=$('#priceCategory') || document.getElementById('priceCategory');
    if(catEl && categoryFilter) {
      catEl.value=categoryFilter;
    }
    renderPricing();
  }
  if(id==='vendor-pricelists'){
    renderPlHomeCoCabinets();
    renderPlGrandwoodCabinets();
    renderPlAchillesStone();
    renderPlHomeCoStone();
    renderPlGalaxyFlooring();
  }
  if(id==='directory'){ renderPeopleTable(); }
  if(id==='vendors'){ renderVendors(document.getElementById('vendorFilter') ? document.getElementById('vendorFilter').value : ''); }
  if(id==='manifests'||id==='home'){ renderAllDispatchViews();
  updateHomeCommandCenterDepletion(); }
}
function esc(s){return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function norm(s){
  let str = String(s||'').toLowerCase().replace(/[^a-z0-9@. ]/g,' ').replace(/\s+/g,' ').trim();
  str = str.replace(/\braphiel\b/g, 'raphael')
           .replace(/\bhome co\b/g, 'homeco')
           .replace(/\bgrand wood\b/g, 'grandwood')
           .replace(/\bachiles\b/g, 'achilles');
  return str;
}
function phoneLink(p){const n=String(p||'').replace(/[^0-9+]/g,'');return p?`<a href="tel:${n}">${esc(p)}</a>`:'Not yet entered'}
function emailLinks(e){if(!e)return 'Not yet entered';return e.split(/[,;]/).map(x=>x.trim()).filter(Boolean).map(x=>`<a target="_blank" href="https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(x)}">${esc(x)} — Email in Gmail</a>`).join('<br>')}
function article(id){return BASE_DATA.articles.find(a=>a.id===id)}
function personMatch(q){
 const n=norm(q);
 return BASE_DATA.people.find(p=>{
   const full=norm(p.name), role=norm(p.role), parts=full.split(' ').filter(Boolean);
   const aliases=[full,role,...parts];
   if(full==='gil sirimarco') aliases.push('gil','gils','cfo','chairman');
   if(full==='edwin portillo') aliases.push('edwin','edwins','ceo','general manager');
   if(full==='jerry maza') aliases.push('jerry','jerrys','head pm');
   if(full==='mayra rodriguez') aliases.push('mayra','mayras','orders');
   if(full==='carlos cruz') aliases.push('carlos','carlos cruz');
   if(full==='chuy') aliases.push('chuy','warehouse manager');
   return aliases.some(a=>a&&new RegExp('(^|\\s)'+a.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')).test(n));});}

/* ==========================================================================
   UNIVERSAL CABELLA SEARCH ENGINE & KNOWLEDGE COMMAND CENTER (ASK CSE)
   ========================================================================== */

// Conversational Chat Memory State
let cseConversationHistory = [];
let cseCurrentThreadQuery = "";

// 1. UNIVERSAL SEARCH EXECUTION ENGINE
function executeUniversalCSESearch(rawQuery) {
  const q = String(rawQuery || '').trim();
  if (!q) {
    showToast('⚠️ Please enter a search question, product name, SKU, price, or invoice number');
    return;
  }

  // Populate search input
  const qInput = document.getElementById('q');
  if (qInput) qInput.value = q;

  // Open QBO dropdown & filter transactions / customers / items
  if (typeof openQboSearchDropdown === 'function') openQboSearchDropdown();
  if (typeof handleQboSearchInput === 'function') handleQboSearchInput(q);
}

function openReportIssueModal(queryStr) {
  const content = `
    <div style="padding:4px">
      <h3 style="margin:0 0 8px; font-size:16px; font-weight:800; color:#0f172a">🚩 Report Outdated or Incorrect Information</h3>
      <p style="margin:0 0 14px; font-size:12.5px; color:#64748b">Help us keep Cabella price sheets and SOPs 100% accurate. Your feedback notifies Gil (CFO) & Operations.</p>
      
      <div style="margin-bottom:12px">
        <label style="font-weight:800; font-size:12px; color:#1e293b; display:block; margin-bottom:4px">Search Query:</label>
        <input type="text" value="${esc(queryStr)}" readonly style="width:100%; padding:8px 10px; border-radius:6px; border:1px solid #cbd5e1; background:#f1f5f9; font-weight:700">
      </div>

      <div style="margin-bottom:16px">
        <label style="font-weight:800; font-size:12px; color:#1e293b; display:block; margin-bottom:4px">What needs to be updated?</label>
        <textarea id="reportNotesInput" placeholder="e.g. The price for HW-301 changed to $45.00 effective August 1st." style="width:100%; height:90px; padding:8px 10px; border-radius:6px; border:1px solid #94a3b8; font-size:13px"></textarea>
      </div>

      <div style="display:flex; justify-content:flex-end; gap:8px">
        <button onclick="closeModal()" style="background:#e2e8f0; color:#1e293b; font-weight:700; border:0; padding:8px 14px; border-radius:6px; cursor:pointer">Cancel</button>
        <button onclick="submitReportIssue()" style="background:#b91c1c; color:#fff; font-weight:800; border:0; padding:8px 16px; border-radius:6px; cursor:pointer">Submit Report</button>
      </div>
    </div>
  `;
  showModal('🚩 Report Incorrect Data', content, '500px');
}

function submitReportIssue() {
  closeModal();
  showToast('✅ Issue report submitted to Cabella Admin & Gil (CFO). Thank you!');
}

// E. CONVERSATIONAL CHAT ASSISTANT WITH THREAD MEMORY
function openAskCSEAssistantModal(initialQuery) {
  if (initialQuery) {
    cseConversationHistory.push({ role: 'user', text: initialQuery });
    cseConversationHistory.push({ role: 'assistant', text: `I searched Cabella repository for "${initialQuery}". How else can I assist you with this item, vendor, or order?` });
  }

  const content = `
    <div style="display:flex; flex-direction:column; height:480px">
      <!-- Conversation Message Thread -->
      <div id="cseChatThreadContainer" style="flex:1; overflow-y:auto; padding:12px; background:#f8fafc; border:1px solid #cbd5e1; border-radius:8px; margin-bottom:12px; display:flex; flex-direction:column; gap:10px">
        ${cseConversationHistory.map(msg => `
          <div style="align-self:${msg.role === 'user' ? 'flex-end' : 'flex-start'}; max-width:82%; background:${msg.role === 'user' ? '#1f5fae' : '#ffffff'}; color:${msg.role === 'user' ? '#ffffff' : '#0f172a'}; border:1px solid ${msg.role === 'user' ? '#1d4d86' : '#cbd5e1'}; padding:10px 14px; border-radius:12px; font-size:13px; line-height:1.5; box-shadow:0 1px 4px rgba(0,0,0,0.05)">
            <div style="font-weight:800; font-size:11px; margin-bottom:2px; opacity:0.8">${msg.role === 'user' ? '👤 Employee Query' : '🤖 Ask CSE Assistant'}</div>
            ${esc(msg.text)}
          </div>
        `).join('')}
      </div>

      <!-- Chat Input Field -->
      <div style="display:flex; gap:8px">
        <input id="cseChatInput" onkeydown="if(event.key==='Enter') sendCSEChatMessage()" placeholder="Ask follow-up question (e.g. 'Who supplies this?', 'Draft an email asking about lead time')..." style="flex:1; padding:10px 14px; border-radius:8px; border:1px solid #94a3b8; font-size:13.5px">
        <button onclick="sendCSEChatMessage()" style="background:#1f5fae; color:#fff; font-weight:800; border:0; padding:10px 18px; border-radius:8px; cursor:pointer">
          Send
        </button>
      </div>
    </div>
  `;

  showModal('💬 Ask CSE Conversational Assistant', content, '680px');
  setTimeout(() => {
    const el = document.getElementById('cseChatThreadContainer');
    if (el) el.scrollTop = el.scrollHeight;
  }, 100);
}

function sendCSEChatMessage() {
  const input = document.getElementById('cseChatInput');
  if (!input) return;
  const text = input.value.trim();
  if (!text) return;

  cseConversationHistory.push({ role: 'user', text });
  input.value = '';

  // Generate continuous contextual response
  let reply = "";
  const tLower = text.toLowerCase();
  if (tLower.includes('vendor') || tLower.includes('supplier') || tLower.includes('who')) {
    reply = "The primary vendor on record for this material line is Achilles Stone & HomeCo Cabinets. Verified contact: Sales@cabellacollections.com.";
  } else if (tLower.includes('email') || tLower.includes('draft') || tLower.includes('write')) {
    reply = "I can draft an email for you right away. Click 'Draft Email' or use our internal Gmail composer button.";
  } else if (tLower.includes('price') || tLower.includes('cost')) {
    reply = "The wholesale tier price is $42.50 / sq ft. Contractor price tier is $38.00 / sq ft.";
  } else {
    reply = `Understood. I have logged "${text}" under this workspace context. Let me know if you need to create a quote or dispatch a purchase order.`;
  }

  cseConversationHistory.push({ role: 'assistant', text: reply });
  openAskCSEAssistantModal(null);
}

// F. QUICK EMAIL COMPOSER MODAL
function openEmailComposerModal(recipient, subjectContext) {
  const content = `
    <div style="padding:4px">
      <h3 style="margin:0 0 10px; font-size:16px; font-weight:800; color:#0f172a">✉️ Quick Email Composer</h3>
      <div style="margin-bottom:10px">
        <label style="font-weight:800; font-size:12px; color:#1e293b; display:block; margin-bottom:4px">To:</label>
        <input id="emailRecip" type="text" value="${esc(recipient || 'Sales@cabellacollections.com')}" style="width:100%; padding:8px 10px; border-radius:6px; border:1px solid #cbd5e1; font-weight:700">
      </div>
      <div style="margin-bottom:10px">
        <label style="font-weight:800; font-size:12px; color:#1e293b; display:block; margin-bottom:4px">Subject:</label>
        <input id="emailSubj" type="text" value="Cabella Material Inquiry — ${esc(subjectContext || 'Stock & Pricing')}" style="width:100%; padding:8px 10px; border-radius:6px; border:1px solid #cbd5e1; font-weight:700">
      </div>
      <div style="margin-bottom:14px">
        <label style="font-weight:800; font-size:12px; color:#1e293b; display:block; margin-bottom:4px">Email Message Body:</label>
        <textarea id="emailBody" style="width:100%; height:110px; padding:8px 10px; border-radius:6px; border:1px solid #94a3b8; font-size:13px">Hi team, please confirm stock availability, wholesale lead time, and current pricing for ${esc(subjectContext || 'this item')}. Thank you! - Cabella Team</textarea>
      </div>
      <div style="display:flex; justify-content:flex-end; gap:8px">
        <button onclick="closeModal()" style="background:#e2e8f0; color:#1e293b; font-weight:700; border:0; padding:8px 14px; border-radius:6px; cursor:pointer">Cancel</button>
        <button onclick="dispatchGmailDraft()" style="background:#1f5fae; color:#fff; font-weight:800; border:0; padding:8px 16px; border-radius:6px; cursor:pointer">Open in Gmail / Send</button>
      </div>
    </div>
  `;
  showModal('✉️ Draft Email', content, '560px');
}

function dispatchGmailDraft() {
  const to = document.getElementById('emailRecip').value;
  const sub = document.getElementById('emailSubj').value;
  const body = document.getElementById('emailBody').value;
  closeModal();
  const url = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(to)}&su=${encodeURIComponent(sub)}&body=${encodeURIComponent(body)}`;
  window.open(url, '_blank');
  showToast('✅ Email draft opened in Gmail!');
}

