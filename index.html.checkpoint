    </summary>
    <div class="tier-body" style="padding:20px;background:#fff">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-bottom:16px;background:#f8fafc;padding:14px;border-radius:10px;border:1px solid #cbd7e6">
