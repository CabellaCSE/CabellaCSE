function getDispatchData() {
  try {
    const raw = localStorage.getItem('cabellaDispatchData_v2');
    if (raw) return JSON.parse(raw);
  } catch(e) {}
  localStorage.setItem('cabellaDispatchData_v2', JSON.stringify(DEFAULT_DISPATCH_DATA));
  return DEFAULT_DISPATCH_DATA;
}

function saveDispatchData(data) {
  localStorage.setItem('cabellaDispatchData_v2', JSON.stringify(data));
  renderAllDispatchViews();
}

function switchFulfillmentMainTab(tabKey) {
  const data = getDispatchData();
  data.activeFulfillmentTab = tabKey;
  saveDispatchData(data);
}

function switchDispatchDate(dateStr) {
  const data = getDispatchData();
  data.currentManifestDate = dateStr;
  saveDispatchData(data);
}

function switchDispatchTruckTab(truckId) {
  const data = getDispatchData();
  data.activeTruckTab = truckId;
  saveDispatchData(data);
}

function toggleDispatchLock(dateStr) {
  const data = getDispatchData();
  const manifest = data.manifests[dateStr || data.currentManifestDate];
  if (!manifest) return;

  const user = (typeof currentActiveUser !== 'undefined') ? currentActiveUser.name : 'Authorized Staff';
  manifest.isLocked = !manifest.isLocked;
  if (manifest.isLocked) {
    manifest.lockedAt = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) + ' at ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    manifest.lockedBy = user;
    if (typeof showToast === 'function') showToast('🔒 Manifest Locked at 6:00 PM Cutoff. Orders dispatched.');
  } else {
    manifest.lockedAt = '';
    manifest.lockedBy = '';
    if (typeof showToast === 'function') showToast('🔓 Manifest UNLOCKED. Project Managers & Mayra can edit POs.');
  }
  saveDispatchData(data);
}

function findVendorPickupAddress(vendorInput) {
  if (!vendorInput) return '';
  const raw = String(vendorInput).trim();
  if (!raw) return '';
  const clean = raw.toLowerCase().replace(/[^a-z0-9]/g, '');
  if (!clean) return '';

  // 1. Direct exact lookup in VENDOR_ADDRESS_BOOK
  if (VENDOR_ADDRESS_BOOK[raw]) return VENDOR_ADDRESS_BOOK[raw];

  // 2. Normalized exact match (ignoring spaces & special chars)
  for (const [key, addr] of Object.entries(VENDOR_ADDRESS_BOOK)) {
    const cleanKey = key.toLowerCase().replace(/[^a-z0-9]/g, '');
    if (clean === cleanKey) return addr;
  }

  // 3. Substring match against VENDOR_ADDRESS_BOOK keys
  for (const [key, addr] of Object.entries(VENDOR_ADDRESS_BOOK)) {
    const cleanKey = key.toLowerCase().replace(/[^a-z0-9]/g, '');
    if (clean.length >= 2 && (clean.includes(cleanKey) || cleanKey.includes(clean))) {
      return addr;
    }
  }

  // 4. Word-level match (e.g. "grand wood" matches "grandwood")
  const words = raw.toLowerCase().split(/\s+/).filter(w => w.length >= 3);
  if (words.length > 0) {
    for (const [key, addr] of Object.entries(VENDOR_ADDRESS_BOOK)) {
      const kLower = key.toLowerCase().replace(/[^a-z0-9]/g, '');
      if (words.every(w => kLower.includes(w)) || words.some(w => w.length >= 4 && kLower.includes(w))) {
        return addr;
      }
    }
  }

  // 5. Dynamic search in BASE_DATA.vendors
  if (typeof BASE_DATA !== 'undefined' && Array.isArray(BASE_DATA.vendors)) {
    for (const v of BASE_DATA.vendors) {
      if (!v.address) continue;
      const vNameClean = (v.name || '').toLowerCase().replace(/[^a-z0-9]/g, '');
      const vCompClean = (v.company || '').toLowerCase().replace(/[^a-z0-9]/g, '');
      if (clean === vNameClean || clean === vCompClean) return v.address;
      if (clean.length >= 3 && (clean.includes(vNameClean) || vNameClean.includes(clean) || clean.includes(vCompClean) || vCompClean.includes(clean))) {
        return v.address;
      }
    }
  }

  return '';
}

function populateVendorDatalists() {
  const datalist = document.getElementById('manifestVendorDatalist');
  if (!datalist) return;

  const entries = new Map();
  for (const [name, addr] of Object.entries(VENDOR_ADDRESS_BOOK)) {
    // Only include primary clean vendor names in datalist
    if (!entries.has(name)) entries.set(name, addr);
  }
  if (typeof BASE_DATA !== 'undefined' && Array.isArray(BASE_DATA.vendors)) {
    for (const v of BASE_DATA.vendors) {
      if (v.name && !entries.has(v.name)) entries.set(v.name, v.address || '');
    }
  }

  datalist.innerHTML = Array.from(entries.entries())
    .sort((a, b) => a[0].localeCompare(b[0]))
    .map(([name, addr]) => `<option value="${esc(name)}">${addr ? esc(addr) : ''}</option>`)
    .join('');
}

function autoFillVendorAddressInForm(inputEl, targetAddressId) {
  const val = (inputEl.value || '').trim();
  const target = document.getElementById(targetAddressId);
  if (!target) return;

  const resolved = findVendorPickupAddress(val);
  if (resolved) {
    target.value = resolved;
    if (targetAddressId === 'manifestPoAddress') {
      const notice = document.getElementById('manifestPoAddressNotice');
      if (notice) {
        notice.style.display = 'inline-flex';
        notice.innerHTML = `<span>✓ Auto-filled: <strong>${esc(resolved.length > 35 ? resolved.slice(0, 35) + '...' : resolved)}</strong></span>`;
      }
      target.style.borderColor = '#10b981';
      target.style.backgroundColor = '#f0fdf4';
      setTimeout(() => {
        target.style.borderColor = '#cbd5e1';
        target.style.backgroundColor = '#ffffff';
      }, 1200);
    }
  }
}

function openAddPoToManifestModal(defaultTruckId) {
  const data = getDispatchData();
  const manifest = data.manifests[data.currentManifestDate];
  if (!manifest) return;

  const modal = document.getElementById('addPoToManifestModal');
  if (!modal) return;

  // Populate vendor datalist for instant autocomplete
  populateVendorDatalists();

  // Populate truck select options
  const truckSelect = document.getElementById('manifestPoTruckSelect');
  if (truckSelect) {
    truckSelect.innerHTML = manifest.trucks.map(t => 
      `<option value="${t.id}" ${t.id === (defaultTruckId || data.activeTruckTab) ? 'selected' : ''}>${t.icon} ${esc(t.name)} (${t.driverName || 'Driver'})</option>`
    ).join('');
  }

  // Reset fields
  const cName = document.getElementById('manifestPoCompanyName');
  const cAddr = document.getElementById('manifestPoAddress');
  const vInv = document.getElementById('manifestPoVendorInv');
  const poNum = document.getElementById('manifestPoNumber');
  const cInv = document.getElementById('manifestPoCustInv');
  const qty = document.getElementById('manifestPoQty');
  const notes = document.getElementById('manifestPoNotes');
  const notice = document.getElementById('manifestPoAddressNotice');

  if (cName) cName.value = '';
  if (cAddr) {
    cAddr.value = '';
    cAddr.style.borderColor = '#cbd5e1';
    cAddr.style.backgroundColor = '#ffffff';
  }
  if (vInv) vInv.value = '';
  if (poNum) poNum.value = '';
  if (cInv) cInv.value = '';
  if (qty) qty.value = '';
  if (notes) notes.value = '';
  if (notice) {
    notice.style.display = 'none';
    notice.innerHTML = '';
  }

  modal.style.display = 'flex';
  if (cName) setTimeout(() => cName.focus(), 50);
}

function closeAddPoToManifestModal() {
  const modal = document.getElementById('addPoToManifestModal');
  if (modal) modal.style.display = 'none';
}

function saveNewPoToManifest() {
  const data = getDispatchData();
  const manifest = data.manifests[data.currentManifestDate];
  if (!manifest) return;

  const truckId = document.getElementById('manifestPoTruckSelect')?.value || 'all_in';
  const companyName = (document.getElementById('manifestPoCompanyName')?.value || '').trim();
  let address = (document.getElementById('manifestPoAddress')?.value || '').trim();
  const vendorInv = (document.getElementById('manifestPoVendorInv')?.value || '').trim() || '—';
  const poNumber = (document.getElementById('manifestPoNumber')?.value || '').trim();
  const custInv = (document.getElementById('manifestPoCustInv')?.value || '').trim() || '—';
  const qty = (document.getElementById('manifestPoQty')?.value || '').trim() || '—';
  const notes = (document.getElementById('manifestPoNotes')?.value || '').trim() || 'Added to manifest';
  const status = document.getElementById('manifestPoStatusSelect')?.value || 'Scheduled';

  if (!companyName) {
    alert('Please enter the Company / Vendor Name (e.g. HomeCo, Grandwood, Duko).');
    return;
  }
  if (!poNumber) {
    alert('Please enter the PO # (e.g. 3210).');
    return;
  }

  if (!address) {
    address = findVendorPickupAddress(companyName) || 'California / Local Supplier Warehouse';
  }

  let truck = manifest.trucks.find(t => t.id === truckId);
  if (!truck) {
    truck = manifest.trucks[0];
  }

  const newRow = {
    id: 'row-' + Date.now(),
    stop: truck.rows.length + 1,
    companyName: companyName,
    address: address,
    vendorInv: vendorInv,
    poNumber: poNumber,
    custInv: custInv,
    qty: qty,
    notes: notes,
    status: status,
    lastUpdated: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) + ' ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
  };

  truck.rows.push(newRow);
  saveDispatchData(data);
  closeAddPoToManifestModal();
  if (typeof showToast === 'function') showToast(`✅ PO #${poNumber} (${companyName}) added to ${truck.name}!`);
}

function quickAddInlinePoToManifest() {
  const data = getDispatchData();
  const manifest = data.manifests[data.currentManifestDate];
  if (!manifest) return;

  const targetTruckId = data.activeTruckTab === 'master' ? 'all_in' : data.activeTruckTab;
  const truck = manifest.trucks.find(t => t.id === targetTruckId) || manifest.trucks[0];

  const cNameEl = document.getElementById('inlinePoCompanyName');
  const poEl = document.getElementById('inlinePoNumber');
  const vInvEl = document.getElementById('inlinePoVendorInv');
  const cInvEl = document.getElementById('inlinePoCustInv');
  const qtyEl = document.getElementById('inlinePoQty');
  const notesEl = document.getElementById('inlinePoNotes');

  const companyName = (cNameEl?.value || '').trim();
  const poNumber = (poEl?.value || '').trim();
  const vendorInv = (vInvEl?.value || '').trim() || '—';
  const custInv = (cInvEl?.value || '').trim() || '—';
  const qty = (qtyEl?.value || '').trim() || '—';
  const notes = (notesEl?.value || '').trim() || '—';

  if (!companyName || !poNumber) {
    alert('Please enter at least Company Name and PO # to quick add.');
    return;
  }

  let address = (document.getElementById('inlineHiddenAddr')?.value || '').trim();
  if (!address) {
    address = findVendorPickupAddress(companyName) || 'California / Local Supplier Warehouse';
  }

  const newRow = {
    id: 'row-' + Date.now(),
    stop: truck.rows.length + 1,
    companyName: companyName,
    address: address,
    vendorInv: vendorInv,
    poNumber: poNumber,
    custInv: custInv,
    qty: qty,
    notes: notes,
    status: 'Scheduled',
    lastUpdated: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) + ' ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
  };

  truck.rows.push(newRow);
  saveDispatchData(data);

  if (cNameEl) cNameEl.value = '';
  if (poEl) poEl.value = '';
  if (vInvEl) vInvEl.value = '';
  if (cInvEl) cInvEl.value = '';
  if (qtyEl) qtyEl.value = '';
  if (notesEl) notesEl.value = '';

  if (typeof showToast === 'function') showToast(`➕ PO #${poNumber} added to ${truck.name} whiteboard!`);
}

function updateManifestRowStatus(rowId, newStatus) {
  const data = getDispatchData();
  const manifest = data.manifests[data.currentManifestDate];
  if (!manifest) return;

  for (const truck of manifest.trucks) {
    const row = truck.rows.find(r => r.id === rowId);
    if (row) {
      row.status = newStatus;
      row.lastUpdated = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) + ' ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      saveDispatchData(data);
      if (typeof showToast === 'function') showToast(`⚡ PO #${row.poNumber} status updated to "${newStatus}"`);
      return;
    }
  }
}

function deleteManifestRow(rowId) {
  if (!confirm('Are you sure you want to remove this PO pickup from the manifest?')) return;

  const data = getDispatchData();
  const manifest = data.manifests[data.currentManifestDate];
  if (!manifest) return;

  for (const truck of manifest.trucks) {
    const idx = truck.rows.findIndex(r => r.id === rowId);
    if (idx !== -1) {
      const removed = truck.rows.splice(idx, 1)[0];
      // Renumber stops
      truck.rows.forEach((r, i) => r.stop = i + 1);
      saveDispatchData(data);
      if (typeof showToast === 'function') showToast(`🗑️ PO #${removed.poNumber} removed from manifest.`);
      return;
    }
  }
}

function moveManifestRowTruck(rowId, targetTruckId) {
  const data = getDispatchData();
  const manifest = data.manifests[data.currentManifestDate];
  if (!manifest) return;

  let sourceRow = null;
  let sourceTruck = null;

  for (const truck of manifest.trucks) {
    const idx = truck.rows.findIndex(r => r.id === rowId);
    if (idx !== -1) {
      sourceTruck = truck;
      sourceRow = truck.rows.splice(idx, 1)[0];
      truck.rows.forEach((r, i) => r.stop = i + 1);
      break;
    }
  }

  if (!sourceRow) return;

  const destTruck = manifest.trucks.find(t => t.id === targetTruckId);
  if (!destTruck) return;

  sourceRow.stop = destTruck.rows.length + 1;
  sourceRow.lastUpdated = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) + ' ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  destTruck.rows.push(sourceRow);

  saveDispatchData(data);
  if (typeof showToast === 'function') showToast(`🚚 PO #${sourceRow.poNumber} moved to ${destTruck.name}!`);
}

function openAddNewTruckModal() {
  const modal = document.getElementById('addNewTruckModal');
  if (!modal) return;
  const n = document.getElementById('newTruckName');
  const d = document.getElementById('newTruckDriver');
  const p = document.getElementById('newTruckPhone');
  const v = document.getElementById('newTruckVehicle');
  if (n) n.value = '';
  if (d) d.value = '';
  if (p) p.value = '';
  if (v) v.value = '';
  modal.style.display = 'flex';
}

function closeAddNewTruckModal() {
  const modal = document.getElementById('addNewTruckModal');
  if (modal) modal.style.display = 'none';
}

function saveAddNewTruck() {
  const data = getDispatchData();
  const manifest = data.manifests[data.currentManifestDate];
  if (!manifest) return;

  const name = (document.getElementById('newTruckName')?.value || '').trim();
  const driver = (document.getElementById('newTruckDriver')?.value || '').trim();
  const phone = (document.getElementById('newTruckPhone')?.value || '').trim();
  const vehicle = (document.getElementById('newTruckVehicle')?.value || '').trim() || 'Pickup Vehicle / Van';

  if (!name) {
    alert('Please enter a Carrier / Truck Name (e.g. "Tom\'s Vehicle", "Edwin\'s Truck", "Hotshot Courier").');
    return;
  }

  const truckId = 'custom_' + Date.now();
  const newTruck = {
    id: truckId,
    name: name,
    icon: '🚐',
    driverName: driver || 'Assigned Driver',
    driverPhone: phone || 'Company Phone',
    truckType: vehicle,
    isCustom: true,
    rows: []
  };

  manifest.trucks.push(newTruck);
  data.activeTruckTab = truckId;
  saveDispatchData(data);
  closeAddNewTruckModal();
  if (typeof showToast === 'function') showToast(`🚚 New Truck "${name}" added to today's whiteboard!`);
}

function printDeliveryManifest(targetTruckId) {
  const data = getDispatchData();
  const manifest = data.manifests[data.currentManifestDate];
  if (!manifest) return;

  const truckId = targetTruckId || data.activeTruckTab;
  let printTrucks = [];
  if (truckId === 'master') {
    printTrucks = manifest.trucks;
  } else {
    const t = manifest.trucks.find(t => t.id === truckId);
    if (t) printTrucks = [t];
  }

  if (printTrucks.length === 0) return;

  let printHtml = `
    <!DOCTYPE html>
    <html>
    <head>
      <title>Cabella Delivery Manifest — ${manifest.deliveryDate}</title>
      <style>
        body { font-family: Arial, sans-serif; margin: 20px; color: #000; }
        .header { display: flex; justify-content: space-between; border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 15px; }
        .title { font-size: 22px; font-weight: bold; }
        .sub { font-size: 13px; color: #444; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 25px; font-size: 12px; }
        th, td { border: 1px solid #333; padding: 6px 8px; text-align: left; }
        th { background: #f0f0f0; font-weight: bold; }
        .carrier-sec { font-size: 16px; font-weight: bold; margin: 15px 0 6px; background: #e2e8f0; padding: 6px 10px; }
        .sig-box { margin-top: 30px; border-top: 1px solid #333; display: flex; justify-content: space-between; padding-top: 10px; font-size: 12px; }
        @media print {
          .no-print { display: none !important; }
        }
      </style>
    </head>
    <body>
      <div class="no-print" style="background:#0284c7; color:#fff; padding:10px 15px; margin-bottom:20px; border-radius:6px; display:flex; justify-content:space-between; align-items:center">
        <span>🖨️ Cabella Delivery Sheet Ready for Print</span>
        <button onclick="window.print()" style="background:#fff; color:#0284c7; border:0; padding:6px 14px; font-weight:bold; border-radius:4px; cursor:pointer">Print Now</button>
      </div>

      <div class="header">
        <div>
          <div class="title">CABELLA'S DELIVERY LIST</div>
          <div class="sub">Cabinets, Stone & Flooring Logistics & Vendor Pickups</div>
        </div>
        <div style="text-align: right; font-size: 13px;">
          <div><strong>DELIVERY DATE:</strong> ${manifest.deliveryDay.toUpperCase()}, ${manifest.deliveryDate}</div>
          <div><strong>PICKUP DATE:</strong> ${manifest.pickupDay.toUpperCase()}, ${manifest.pickupDate}</div>
          <div><strong>6 PM CUTOFF:</strong> ${manifest.isLocked ? 'LOCKED' : 'OPEN'}</div>
        </div>
      </div>
  `;

  printTrucks.forEach(t => {
    printHtml += `
      <div class="carrier-sec">${t.icon} CARRIER: ${t.name.toUpperCase()} (${t.driverName} - ${t.driverPhone}) | ${t.rows.length} Stops</div>
      <table>
        <thead>
          <tr>
            <th style="width: 40px; text-align:center">STOP</th>
            <th style="width: 180px">COMPANY NAME</th>
            <th>ADDRESS</th>
            <th style="width: 100px">VENDOR INV #</th>
            <th style="width: 80px">PO #</th>
            <th style="width: 80px">CUST INV #</th>
            <th style="width: 120px">QTY / NOTES</th>
            <th style="width: 90px">STATUS</th>
            <th style="width: 100px">DRIVER SIGN</th>
          </tr>
        </thead>
        <tbody>
          ${t.rows.map(r => `
            <tr>
              <td style="text-align:center; font-weight:bold">${r.stop}</td>
              <td style="font-weight:bold">${esc(r.companyName)}</td>
              <td style="font-size: 11px">${esc(r.address)}</td>
              <td>${esc(r.vendorInv)}</td>
              <td style="font-weight:bold">${esc(r.poNumber)}</td>
              <td>${esc(r.custInv)}</td>
              <td style="font-weight:${r.qty.includes('stone') ? 'bold; color:#b45309' : 'normal'}">${esc(r.qty !== '—' ? r.qty : '')} ${esc(r.notes !== '—' ? r.notes : '')}</td>
              <td>${esc(r.status)}</td>
              <td></td>
            </tr>
          `).join('')}
          ${t.rows.length === 0 ? '<tr><td colspan="9" style="text-align:center; padding:15px; color:#666">No pickups scheduled for this carrier.</td></tr>' : ''}
        </tbody>
      </table>
    `;
  });

  printHtml += `
      <div class="sig-box">
        <div><strong>Driver Signature:</strong> ___________________________</div>
        <div><strong>Warehouse Receiving Signature (Chuy):</strong> ___________________________</div>
        <div><strong>Date & Time Received:</strong> ___________________</div>
      </div>
    </body>
    </html>
  `;
  const printWindow = window.open('', '_blank');
  if (printWindow) {
    printWindow.document.write(printHtml);
    printWindow.document.close();
  }
}

function openSmsDispatchModal(targetTruckId) {
  const data = getDispatchData();
  const manifest = data.manifests[data.currentManifestDate];
  if (!manifest) return;

  const truckId = targetTruckId || (data.activeTruckTab === 'master' ? 'all_in' : data.activeTruckTab);
  const truck = manifest.trucks.find(t => t.id === truckId) || manifest.trucks[0];
  if (!truck) return;

  const modal = document.getElementById('smsDispatchModal');
  if (!modal) return;

  let msg = `🚚 CABELLA DISPATCH MANIFEST — ${truck.name.toUpperCase()}\n`;
  msg += `📅 Delivery: ${manifest.deliveryDay} ${manifest.deliveryDate} | Pickup: ${manifest.pickupDay} ${manifest.pickupDate}\n`;
  msg += `👤 Driver: ${truck.driverName} (${truck.driverPhone})\n`;
  msg += `----------------------------------------\n`;

  truck.rows.forEach((r, idx) => {
    msg += `STOP ${r.stop}: ${r.companyName.toUpperCase()}\n`;
    msg += `📍 ${r.address}\n`;
    msg += `📦 PO #: ${r.poNumber} | Inv #: ${r.vendorInv}\n`;
    if (r.qty !== '—') msg += `📐 Qty: ${r.qty}\n`;
    if (r.notes && r.notes !== '—') msg += `📝 Notes: ${r.notes}\n`;
    msg += `\n`;
  });

  msg += `Total Stops: ${truck.rows.length} POs\n`;
  msg += `Please text status updates upon pickup and delivery.\n`;

  const txtArea = document.getElementById('smsDispatchTextarea');
  const titleEl = document.getElementById('smsDispatchCarrierTitle');
  if (txtArea) txtArea.value = msg;
  if (titleEl) titleEl.textContent = `Dispatch Text for ${truck.name} (${truck.rows.length} stops)`;

  modal.style.display = 'flex';
}

function closeSmsDispatchModal() {
  const modal = document.getElementById('smsDispatchModal');
  if (modal) modal.style.display = 'none';
}

function copySmsDispatchText() {
  const txtArea = document.getElementById('smsDispatchTextarea');
  if (!txtArea) return;
  txtArea.select();
  navigator.clipboard.writeText(txtArea.value).then(() => {
    if (typeof showToast === 'function') showToast('📋 Manifest text copied to clipboard! Ready to paste into SMS / RingCentral.');
  }).catch(() => {
    document.execCommand('copy');
    if (typeof showToast === 'function') showToast('📋 Manifest text copied!');
  });
}

function exportManifestCsv(targetTruckId) {
  const data = getDispatchData();
  const manifest = data.manifests[data.currentManifestDate];
  if (!manifest) return;

  const truckId = targetTruckId || data.activeTruckTab;
  let exportTrucks = [];
  if (truckId === 'master') {
    exportTrucks = manifest.trucks;
  } else {
    const t = manifest.trucks.find(t => t.id === truckId);
    if (t) exportTrucks = [t];
  }

  let csvContent = 'data:text/csv;charset=utf-8,';
  csvContent += 'Carrier,Stop,Company Name,Address,Vendor Invoice #,PO #,Customer Inv #,Qty,Notes,Status,Last Updated\n';

  exportTrucks.forEach(t => {
    t.rows.forEach(r => {
      const rowStr = [
        `"${t.name}"`,
        r.stop,
        `"${(r.companyName || '').replace(/"/g, '""')}"`,
        `"${(r.address || '').replace(/"/g, '""')}"`,
        `"${(r.vendorInv || '').replace(/"/g, '""')}"`,
        `"${(r.poNumber || '').replace(/"/g, '""')}"`,
        `"${(r.custInv || '').replace(/"/g, '""')}"`,
        `"${(r.qty || '').replace(/"/g, '""')}"`,
        `"${(r.notes || '').replace(/"/g, '""')}"`,
        `"${(r.status || '').replace(/"/g, '""')}"`,
        `"${(r.lastUpdated || '').replace(/"/g, '""')}"`
      ].join(',');
      csvContent += rowStr + '\n';
    });
  });

  const encodedUri = encodeURI(csvContent);
  const link = document.createElement('a');
  link.setAttribute('href', encodedUri);
  link.setAttribute('download', `Cabella_Delivery_Manifest_${manifest.deliveryDate}.csv`);
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);

  if (typeof showToast === 'function') showToast('📥 Manifest CSV exported successfully!');
}

function syncManifestPoToWarehouse(rowId) {
  const data = getDispatchData();
  const manifest = data.manifests[data.currentManifestDate];
  if (!manifest) return;

  let targetRow = null;
  let targetTruck = null;

  for (const truck of manifest.trucks) {
    const row = truck.rows.find(r => r.id === rowId);
    if (row) {
      targetRow = row;
      targetTruck = truck;
      break;
    }
  }

  if (!targetRow) return;

  // Check if warehouse order exists or create one
  const whOrders = getWarehouseOrders();
  let existing = whOrders.find(o => o.poNumber === targetRow.poNumber || (o.poNumber && o.poNumber.includes(targetRow.poNumber)));

  if (existing) {
    existing.status = 'ready';
    existing.statusLabel = 'Received & Staged in Bin';
    existing.updatedBy = 'Dispatch Sync';
    existing.updatedAt = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) + ' ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    existing.notes.push({
      author: `${targetTruck.name} Driver`,
      text: `Delivered to Las Vegas warehouse from ${targetRow.companyName}. Ready for staging.`,
      timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
    });
  } else {
    const newWhOrder = {
      id: 'WO-' + Date.now(),
      projectName: `${targetRow.companyName} PO #${targetRow.poNumber}`,
      customer: targetRow.custInv !== '—' ? `Invoice #${targetRow.custInv}` : 'Cabella Inventory',
      poNumber: targetRow.poNumber,
      invoiceNumber: targetRow.custInv !== '—' ? targetRow.custInv : 'N/A',
      vendorName: targetRow.companyName,
      itemsSummary: `${targetRow.qty !== '—' ? targetRow.qty + ' ' : ''}${targetRow.notes !== '—' ? targetRow.notes : 'Materials'}`,
      status: 'ready',
      statusLabel: 'Received & Staged in Bin',
      binNumber: 'Staging Area A',
      missingItems: '',
      updatedBy: 'Dispatch Sync',
      updatedAt: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) + ' ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      lifecycleStage: 6,
      notes: [
        { author: targetTruck.name, text: `Delivered to warehouse. Staged in Area A.`, timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) }
      ]
    };
    whOrders.unshift(newWhOrder);
  }

  saveWarehouseOrders(whOrders);
  targetRow.status = 'Received at Cabella';
  saveDispatchData(data);

  if (typeof showToast === 'function') showToast(`🔄 PO #${targetRow.poNumber} synced to Warehouse Receiving & Staged in Bin!`);
}


function updateHomeDispatchSummary() {
  const data = getDispatchData();
  const currentDate = data.currentManifestDate || '2026-08-15';
  const manifest = data.manifests[currentDate];
  if (!manifest) return;

  const dateLabel = document.getElementById('homeDispatchDateLabel');
  const allInCount = document.getElementById('homeDispatchAllInCount');
  const chavezCount = document.getElementById('homeDispatchChavezCount');
  const totalCount = document.getElementById('homeDispatchTotalCount');
  const lockBadge = document.getElementById('homeDispatchLockBadge');

  if (dateLabel) dateLabel.textContent = `${manifest.deliveryDay} (${manifest.deliveryDate})`;
  
  const allInTruck = manifest.trucks.find(t => t.id === 'all_in');
  const chavezTruck = manifest.trucks.find(t => t.id === 'chavez');
  let totalStops = 0;
  manifest.trucks.forEach(t => totalStops += t.rows.length);

  if (allInCount) allInCount.textContent = `${allInTruck ? allInTruck.rows.length : 0} PO Pickups`;
  if (chavezCount) chavezCount.textContent = `${chavezTruck ? chavezTruck.rows.length : 0} PO Pickups`;
  if (totalCount) totalCount.textContent = `${totalStops} Total Stops`;

  if (lockBadge) {
    if (manifest.isLocked) {
      lockBadge.style.background = '#fee2e2';
      lockBadge.style.color = '#991b1b';
      lockBadge.style.border = '1px solid #fecaca';
      lockBadge.textContent = '🔒 6:00 PM Cutoff: Locked';
    } else {
      lockBadge.style.background = '#dcfce7';
      lockBadge.style.color = '#166534';
      lockBadge.style.border = '1px solid #bbf7d0';
      lockBadge.textContent = '🟢 Cutoff: Open for Orders';
    }
  }
}


/* ==========================================================================
   CABELLA PHOTO PROOF & CLIENT SIGNATURE VERIFICATION ENGINE
   Full 4-Stage Chain:
   1. Driver Vendor Pickup Photos (Mobile Phone Camera / Upload)
   2. Warehouse Receiving / Drop-off Inspection Photos
   3. Warehouse Order Picking & Bin Staging Photos
   4. Client Truck Loading Photos & Digital Finger Signature on Screen
   ========================================================================== */

// Helper to get all photos/signatures store from localStorage
function getPhotoProofStore() {
  try {
    const raw = localStorage.getItem('cabellaPhotoProofStore_v1');
    if (raw) return JSON.parse(raw);
  } catch(e) {}
  // Sample seed photos to show the feature working immediately
  const sampleStore = {
    "3188": {
      driverPickupPhotos: [
        { id: "p1", url: "https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=600&auto=format&fit=crop&q=60", caption: "Loaded 12 boxes at HomeCo El Monte", takenAt: "Aug 14, 10:15 AM", takenBy: "ALL IN Driver" }
      ],
      warehouseDropoffPhotos: [
        { id: "p2", url: "https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=600&auto=format&fit=crop&q=60", caption: "Offloaded at Cabella Las Vegas dock - no freight damage", takenAt: "Aug 15, 6:45 AM", takenBy: "Chuy (Warehouse)" }
      ],
      warehousePickingPhotos: [],
      clientPickupRelease: null
    },
    "3194": {
      driverPickupPhotos: [
        { id: "p3", url: "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=600&auto=format&fit=crop&q=60", caption: "5 Prefab Quartz Stones on A-Frame at HomeCo", takenAt: "Aug 14, 11:45 AM", takenBy: "ALL IN Driver" }
      ],
      warehouseDropoffPhotos: [],
      warehousePickingPhotos: [],
      clientPickupRelease: null
    },
    "WO-8402": {
      driverPickupPhotos: [],
      warehouseDropoffPhotos: [],
      warehousePickingPhotos: [
        { id: "p4", url: "https://images.unsplash.com/photo-1556911220-e15b29be8c8f?w=600&auto=format&fit=crop&q=60", caption: "White Shaker boxes assembled & staged in Bin B-04", takenAt: "Aug 8, 2:10 PM", takenBy: "Chuy (Warehouse)" }
      ],
      clientPickupRelease: {
        clientName: "Nestor Garcia",
        companyName: "YOHADI Remodeling",
        phone: "(702) 555-4921",
        vehiclePlate: "NV 892-K9L (Chevy Silverado)",
        signedAt: "Aug 8, 2026 at 2:30 PM",
        signedByStaff: "Chuy (Warehouse Manager)",
        signatureDataUrl: "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='300' height='100'><path d='M10 50 Q 50 10, 90 60 T 170 40 T 250 50' fill='none' stroke='%230f172a' stroke-width='3'/><text x='20' y='85' font-family='Arial' font-size='12' fill='%2364748b'>Nestor Garcia (Verified)</text></svg>",
        truckLoadedPhotos: [
          { id: "p5", url: "https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=600&auto=format&fit=crop&q=60", caption: "Client pickup truck loaded with boxes & strapped securely", takenAt: "Aug 8, 2:25 PM", takenBy: "Chuy (Warehouse)" }
        ]
      }
    }
  };
  localStorage.setItem('cabellaPhotoProofStore_v1', JSON.stringify(sampleStore));
  return sampleStore;
}

function savePhotoProofStore(store) {
  localStorage.setItem('cabellaPhotoProofStore_v1', JSON.stringify(store));
  if (typeof renderAllDispatchViews === 'function') renderAllDispatchViews();
  if (typeof renderWarehouseFeed === 'function') renderWarehouseFeed();
}

function getProofForEntity(key) {
  if (!key) return { driverPickupPhotos: [], warehouseDropoffPhotos: [], warehousePickingPhotos: [], clientPickupRelease: null };
  const store = getPhotoProofStore();
  if (!store[key]) {
    store[key] = { driverPickupPhotos: [], warehouseDropoffPhotos: [], warehousePickingPhotos: [], clientPickupRelease: null };
  }
  return store[key];
}

// Current active inspection entity in modal
let activePhotoEntity = {
  key: "", // e.g. "3188" or "WO-8412"
  title: "",
  type: "po", // "po" or "warehouse"
  activeStage: "driverPickupPhotos"
};

function openPoPhotoModal(key, title, defaultStage = 'driverPickupPhotos') {
  activePhotoEntity = {
    key: key,
    title: title || ('PO #' + key),
    type: key.startsWith('WO-') ? 'warehouse' : 'po',
    activeStage: defaultStage
  };

  const modal = document.getElementById('poPhotoInspectionModal');
  if (!modal) return;

  const titleEl = document.getElementById('photoModalEntityTitle');
  if (titleEl) titleEl.textContent = activePhotoEntity.title;

  switchPhotoModalTab(defaultStage);
  modal.style.display = 'flex';
}

function closePoPhotoModal() {
  const modal = document.getElementById('poPhotoInspectionModal');
  if (modal) modal.style.display = 'none';
}

function switchPhotoModalTab(stageKey) {
  activePhotoEntity.activeStage = stageKey;
  
  // Highlight tab buttons
  document.querySelectorAll('.photo-stage-tab-btn').forEach(btn => {
    btn.style.background = '#f8fafc';
    btn.style.color = '#475569';
    btn.style.borderBottom = '1px solid #cbd5e1';
  });
  const activeBtn = document.getElementById('photoStageTab-' + stageKey);
  if (activeBtn) {
    activeBtn.style.background = '#0284c7';
    activeBtn.style.color = '#ffffff';
    activeBtn.style.borderBottom = '2px solid #0284c7';
  }

  renderPhotoModalGallery();
}

function renderPhotoModalGallery() {
  const gallery = document.getElementById('photoModalGalleryContainer');
  if (!gallery) return;

  const proof = getProofForEntity(activePhotoEntity.key);
  const stagePhotos = proof[activePhotoEntity.activeStage] || [];

  const stageDescriptions = {
    driverPickupPhotos: "Driver photos taken at vendor yard (packing slips, loaded pallets, slab racks).",
    warehouseDropoffPhotos: "Warehouse dock receiving inspection photos taken in Las Vegas.",
    warehousePickingPhotos: "Warehouse order picking & bin staging photos (assembled boxes & staged materials).",
    truckLoadedPhotos: "Client truck loaded photos prior to departure."
  };

  const descEl = document.getElementById('photoModalStageDescription');
  if (descEl) descEl.textContent = stageDescriptions[activePhotoEntity.activeStage] || "Inspection Photos";

  if (stagePhotos.length === 0) {
    gallery.innerHTML = `
      <div style="grid-column: 1 / -1; text-align: center; padding: 36px 16px; background: #f8fafc; border: 2px dashed #cbd5e1; border-radius: 10px; color: #64748b">
        <div style="font-size: 28px; margin-bottom: 6px">📷</div>
        <div style="font-weight: 800; color: #0f172a; font-size: 14px">No photos uploaded for this stage yet.</div>
        <div style="font-size: 12.5px; color: #64748b; margin-top: 4px">Use your phone camera or upload photos below to add proof of condition.</div>
      </div>
    `;
    return;
  }

  gallery.innerHTML = stagePhotos.map((photo, idx) => `
    <div style="background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 6px rgba(0,0,0,0.06); display: flex; flex-direction: column">
      <div style="position: relative; height: 160px; background: #0f172a; cursor: pointer" onclick="viewFullScreenImage('${photo.url}', '${esc(photo.caption)}')">
        <img src="${photo.url}" alt="${esc(photo.caption)}" style="width: 100%; height: 100%; object-fit: cover" onerror="this.src='https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=400&q=60'">
        <div style="position: absolute; bottom: 6px; right: 6px; background: rgba(0,0,0,0.7); color: #fff; font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 4px">🔍 Click to Zoom</div>
      </div>
      <div style="padding: 10px; font-size: 12px; display: flex; flex-direction: column; justify-content: space-between; flex: 1">
        <div>
          <div style="font-weight: 800; color: #0f172a; margin-bottom: 2px">${esc(photo.caption || 'Inspection Photo')}</div>
          <div style="font-size: 11px; color: #64748b">🕒 ${photo.takenAt} · By ${esc(photo.takenBy || 'Staff')}</div>
        </div>
        <div style="display: flex; justify-content: flex-end; margin-top: 8px">
          <button onclick="deleteEntityPhoto('${photo.id}')" style="background: #fff1f2; color: #9f1239; border: 1px solid #fecdd3; padding: 3px 8px; border-radius: 4px; font-size: 11px; font-weight: 700; cursor: pointer">
            🗑️ Remove
          </button>
        </div>
      </div>
    </div>
  `).join('');
}

function handlePhotoUpload(inputEl) {
  if (!inputEl.files || inputEl.files.length === 0) return;
  const file = inputEl.files[0];
  const reader = new FileReader();

  reader.onload = function(e) {
    const dataUrl = e.target.result;
    const captionInput = document.getElementById('newPhotoCaptionInput');
    const caption = (captionInput?.value || '').trim() || 'Inspection photo';
    const user = (typeof currentActiveUser !== 'undefined') ? currentActiveUser.name : 'Cabella Staff';

    const store = getPhotoProofStore();
    if (!store[activePhotoEntity.key]) {
      store[activePhotoEntity.key] = { driverPickupPhotos: [], warehouseDropoffPhotos: [], warehousePickingPhotos: [], clientPickupRelease: null };
    }

    const newPhoto = {
      id: 'photo-' + Date.now(),
      url: dataUrl,
      caption: caption,
      takenAt: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) + ' ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      takenBy: user
    };

    if (!store[activePhotoEntity.key][activePhotoEntity.activeStage]) {
      store[activePhotoEntity.key][activePhotoEntity.activeStage] = [];
    }

    store[activePhotoEntity.key][activePhotoEntity.activeStage].push(newPhoto);
    savePhotoProofStore(store);

    if (captionInput) captionInput.value = '';
    inputEl.value = '';
    renderPhotoModalGallery();
    if (typeof showToast === 'function') showToast('📸 Photo added successfully!');
  };

  reader.readAsDataURL(file);
}

function deleteEntityPhoto(photoId) {
  if (!confirm('Are you sure you want to delete this photo?')) return;
  const store = getPhotoProofStore();
  const proof = store[activePhotoEntity.key];
  if (!proof || !proof[activePhotoEntity.activeStage]) return;

  proof[activePhotoEntity.activeStage] = proof[activePhotoEntity.activeStage].filter(p => p.id !== photoId);
  savePhotoProofStore(store);
  renderPhotoModalGallery();
  if (typeof showToast === 'function') showToast('🗑️ Photo removed.');
}

function viewFullScreenImage(url, caption) {
  const modal = document.getElementById('fullScreenImageModal');
  if (!modal) return;
  const img = document.getElementById('fullScreenImg');
  const cap = document.getElementById('fullScreenCaption');
  if (img) img.src = url;
  if (cap) cap.textContent = caption;
  modal.style.display = 'flex';
}

function closeFullScreenImageModal() {
  const modal = document.getElementById('fullScreenImageModal');
  if (modal) modal.style.display = 'none';
}

// --- CLIENT SIGNATURE PAD ENGINE ---
let signaturePadCanvas = null;
let signaturePadCtx = null;
let isDrawingSignature = false;
let signatureHasStrokes = false;
let activeSigningOrder = null;

function initSignatureCanvas() {
  const canvas = document.getElementById('clientSignatureCanvas');
  if (!canvas) return;
  signaturePadCanvas = canvas;
  signaturePadCtx = canvas.getContext('2d');
  
  // Set up drawing styles
  signaturePadCtx.strokeStyle = '#0f172a';
  signaturePadCtx.lineWidth = 2.5;
  signaturePadCtx.lineCap = 'round';
  signaturePadCtx.lineJoin = 'round';

  function getCanvasCoords(evt) {
    const rect = canvas.getBoundingClientRect();
    const scaleX = canvas.width / rect.width;
    const scaleY = canvas.height / rect.height;
    const clientX = evt.touches ? evt.touches[0].clientX : evt.clientX;
    const clientY = evt.touches ? evt.touches[0].clientY : evt.clientY;
    return {
      x: (clientX - rect.left) * scaleX,
      y: (clientY - rect.top) * scaleY
    };
  }

  function startDrawing(e) {
    e.preventDefault();
    isDrawingSignature = true;
    const coords = getCanvasCoords(e);
    signaturePadCtx.beginPath();
    signaturePadCtx.moveTo(coords.x, coords.y);
  }

  function draw(e) {
    if (!isDrawingSignature) return;
    e.preventDefault();
    const coords = getCanvasCoords(e);
    signaturePadCtx.lineTo(coords.x, coords.y);
    signaturePadCtx.stroke();
    signatureHasStrokes = true;
  }

  function stopDrawing(e) {
    if (isDrawingSignature) {
      signaturePadCtx.closePath();
      isDrawingSignature = false;
    }
  }

  canvas.addEventListener('mousedown', startDrawing);
  canvas.addEventListener('mousemove', draw);
  canvas.addEventListener('mouseup', stopDrawing);
  canvas.addEventListener('mouseleave', stopDrawing);

  canvas.addEventListener('touchstart', startDrawing, { passive: false });
  canvas.addEventListener('touchmove', draw, { passive: false });
  canvas.addEventListener('touchend', stopDrawing);
}

function clearSignaturePad() {
  if (!signaturePadCanvas || !signaturePadCtx) return;
  signaturePadCtx.clearRect(0, 0, signaturePadCanvas.width, signaturePadCanvas.height);
  signatureHasStrokes = false;
}

function openClientSignatureModal(orderId) {
  const orders = getWarehouseOrders();
  const order = orders.find(o => o.id === orderId) || {
    id: orderId,
    projectName: "Client Job Pickup",
    customer: "Client / Contractor",
    invoiceNumber: "INV-" + orderId,
    poNumber: "PO-" + orderId,
    itemsSummary: "Complete Order Package"
  };

  activeSigningOrder = order;
  const modal = document.getElementById('clientSignatureModal');
  if (!modal) return;

  const infoEl = document.getElementById('signModalOrderInfo');
  if (infoEl) {
    infoEl.innerHTML = `
      <div style="font-weight: 800; font-size: 15px; color: #0f172a">${order.projectName}</div>
      <div style="font-size: 12px; color: #475569; margin-top: 2px">
        👤 <strong>Customer:</strong> ${order.customer} | 📄 <strong>Inv #:</strong> ${order.invoiceNumber || 'N/A'} | 🏭 <strong>PO #:</strong> ${order.poNumber || 'N/A'}
      </div>
      <div style="font-size: 12px; color: #334155; margin-top: 4px; background: #f8fafc; padding: 6px 10px; border-radius: 6px; border: 1px solid #e2e8f0">
        📦 <strong>Package:</strong> ${order.itemsSummary}
      </div>
    `;
  }

  // Pre-fill fields
  const nameEl = document.getElementById('signClientName');
  const coEl = document.getElementById('signClientCompany');
  const phoneEl = document.getElementById('signClientPhone');
  const plateEl = document.getElementById('signClientPlate');

  if (nameEl) nameEl.value = order.customer.split(' ')[0] || '';
  if (coEl) coEl.value = order.customer || '';
  if (phoneEl) phoneEl.value = '';
  if (plateEl) plateEl.value = '';

  modal.style.display = 'flex';
  setTimeout(() => {
    initSignatureCanvas();
    clearSignaturePad();
  }, 100);

  renderTruckLoadedPhotosList();
}

function closeClientSignatureModal() {
  const modal = document.getElementById('clientSignatureModal');
  if (modal) modal.style.display = 'none';
}

function renderTruckLoadedPhotosList() {
  const container = document.getElementById('signTruckLoadedPhotosList');
  if (!container || !activeSigningOrder) return;

  const proof = getProofForEntity(activeSigningOrder.id);
  const photos = proof.truckLoadedPhotos || [];

  if (photos.length === 0) {
    container.innerHTML = `
      <div style="font-size: 11.5px; color: #64748b; font-style: italic">
        No loaded truck photos attached yet. Snap a photo of the client's loaded vehicle below.
      </div>
    `;
    return;
  }

  container.innerHTML = photos.map(p => `
    <div style="display: inline-flex; align-items: center; gap: 6px; background: #f1f5f9; padding: 4px 8px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 11.5px">
      <span>📷</span> <strong>${p.caption}</strong> (${p.takenAt})
    </div>
  `).join(' ');
}

function handleTruckLoadPhotoUpload(inputEl) {
  if (!inputEl.files || inputEl.files.length === 0 || !activeSigningOrder) return;
  const file = inputEl.files[0];
  const reader = new FileReader();

  reader.onload = function(e) {
    const dataUrl = e.target.result;
    const store = getPhotoProofStore();
    if (!store[activeSigningOrder.id]) {
      store[activeSigningOrder.id] = { driverPickupPhotos: [], warehouseDropoffPhotos: [], warehousePickingPhotos: [], truckLoadedPhotos: [], clientPickupRelease: null };
    }
    if (!store[activeSigningOrder.id].truckLoadedPhotos) {
      store[activeSigningOrder.id].truckLoadedPhotos = [];
    }

    store[activeSigningOrder.id].truckLoadedPhotos.push({
      id: 'photo-' + Date.now(),
      url: dataUrl,
      caption: "Client Truck Loaded Photo",
      takenAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      takenBy: "Chuy (Warehouse)"
    });

    savePhotoProofStore(store);
    renderTruckLoadedPhotosList();
    if (typeof showToast === 'function') showToast('📷 Client loaded truck photo added!');
  };

  reader.readAsDataURL(file);
}

function saveClientSignatureRelease() {
  if (!activeSigningOrder) return;

  const clientName = (document.getElementById('signClientName')?.value || '').trim();
  const companyName = (document.getElementById('signClientCompany')?.value || '').trim();
  const phone = (document.getElementById('signClientPhone')?.value || '').trim();
  const plate = (document.getElementById('signClientPlate')?.value || '').trim();
  const ackChecked = document.getElementById('signAckCheckbox')?.checked;

  if (!clientName) {
    alert('Please enter the client / driver printed name.');
    return;
  }

  if (!signatureHasStrokes && !signaturePadCanvas) {
    alert('Please have the client sign their signature on the pad using their finger or mouse.');
    return;
  }

  if (!ackChecked) {
    alert('Please verify that the client acknowledges receiving all materials in good condition.');
    return;
  }

  const signatureDataUrl = signaturePadCanvas.toDataURL('image/png');
  const store = getPhotoProofStore();
  if (!store[activeSigningOrder.id]) {
    store[activeSigningOrder.id] = { driverPickupPhotos: [], warehouseDropoffPhotos: [], warehousePickingPhotos: [], truckLoadedPhotos: [], clientPickupRelease: null };
  }

  const staffUser = (typeof currentActiveUser !== 'undefined') ? currentActiveUser.name : 'Chuy (Warehouse Manager)';

  store[activeSigningOrder.id].clientPickupRelease = {
    clientName: clientName,
    companyName: companyName || activeSigningOrder.customer,
    phone: phone || 'N/A',
    vehiclePlate: plate || 'Standard Vehicle / Truck',
    signedAt: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) + ' at ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
    signedByStaff: staffUser,
    signatureDataUrl: signatureDataUrl,
    truckLoadedPhotos: store[activeSigningOrder.id].truckLoadedPhotos || []
  };

  // Update order status to Completed & mark lifecycle stage 7 (Picked up / Delivered)
  const orders = getWarehouseOrders();
  const ord = orders.find(o => o.id === activeSigningOrder.id);
  if (ord) {
    ord.status = 'completed';
    ord.statusLabel = 'Picked Up & Signed by Client';
    ord.lifecycleStage = 7;
    ord.updatedBy = staffUser;
    ord.updatedAt = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) + ' ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    ord.notes.push({
      author: staffUser,
      text: `Client ${clientName} (${companyName || activeSigningOrder.customer}) loaded truck, signed digital release waiver, and departed.`,
      timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
    });
    saveWarehouseOrders(orders);
  }

  savePhotoProofStore(store);
  closeClientSignatureModal();
  if (typeof showToast === 'function') showToast(`✍️ Signed Bill of Lading & Release saved for ${clientName}!`);

  // Open receipt view
  setTimeout(() => {
    openPodReceiptModal(activeSigningOrder.id);
  }, 400);
}

