      <span><strong>MANDATORY SALES PROCEDURE:</strong> Wholesale matrix is for estimation reference. <strong>Always obtain an official written quote directly from the vendor</strong> before confirming final client pricing.</span>
    </div>
    <button onclick="openGmailQuoteComposer()" style="background:#d97706;color:#fff;font-weight:800;border:0;padding:5px 10px;border-radius:6px;font-size:11.5px;cursor:pointer;display:inline-flex;align-items:center;gap:4px">
      ✉️ Request Quote from Vendor
    </button>
  </div>

  <!-- INTEGRATED COMPARISON TABS & COMPACT FILTER TOOLBAR -->
  <div style="background:#ffffff;border:1px solid #cbd5e1;border-radius:10px;padding:14px 16px;margin-bottom:12px;box-shadow:0 2px 6px rgba(0,0,0,0.03)">
    <!-- Category Tabs -->
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:12px;padding-bottom:10px;border-bottom:1px solid #e2e8f0">
      <div style="display:flex;gap:6px;flex-wrap:wrap">
        <button id="btnCompCabinets" class="btn" style="background:#061a33;color:#fff;font-weight:bold;padding:7px 14px;border-radius:6px;font-size:13px;display:flex;align-items:center;gap:6px" onclick="setComparisonMode('cabinets')">
          🪵 Cabinets (GW vs HC vs CC vs GH vs TK)
        </button>
        <button id="btnCompStone" class="btn secondary" style="font-weight:bold;padding:7px 14px;border-radius:6px;font-size:13px;display:flex;align-items:center;gap:6px" onclick="setComparisonMode('stone')">
          ⛰️ Stone (Achilles vs HC vs Raphael vs Elite...)
        </button>
        <button id="btnCompFlooring" class="btn secondary" style="font-weight:bold;padding:7px 14px;border-radius:6px;font-size:13px;display:flex;align-items:center;gap:6px" onclick="setComparisonMode('flooring')">
          🪴 Flooring (Galaxy vs HC vs GW vs MSI...)
        </button>
        <button id="btnCompAll" class="btn secondary" style="font-weight:bold;padding:7px 14px;border-radius:6px;font-size:13px;display:flex;align-items:center;gap:6px" onclick="setComparisonMode('all')">
          📊 Full Combined Catalog
        </button>
      </div>

      <div id="cabinetHeightNotice" style="background:#f0f9ff;border:1px solid #bae6fd;color:#0369a1;padding:5px 10px;border-radius:6px;font-size:12px;display:flex;align-items:center;gap:5px">
        <span>📐 HomeCo tops max at 40" tall. For 42" uppers, use Grandwood or Central Cabinets.</span>
      </div>
    </div>

    <!-- Filter Inputs Grid -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px;align-items:end">
      <div>
        <label style="display:block;font-size:11px;font-weight:800;color:#64748b;text-transform:uppercase;margin-bottom:3px">Search SKU or Item</label>
        <input id="priceQuery" placeholder="Search B36, Calacatta, LVP..." style="width:100%;padding:8px 10px;border:1px solid #cbd5e1;border-radius:6px;font-size:13px" oninput="renderPricing()">
      </div>
      <div>
        <label style="display:block;font-size:11px;font-weight:800;color:#64748b;text-transform:uppercase;margin-bottom:3px">Category</label>
        <select id="priceCategory" style="width:100%;padding:8px 10px;border:1px solid #cbd5e1;border-radius:6px;font-size:13px;background:#fff" onchange="renderPricing()">
          <option value="">All Categories</option>
          <option value="Prefabricated Stone">Prefabricated Stone Slabs</option>
          <option value="Flooring & Wood">LVP Flooring & Wood</option>
          <option value="Base Cabinets">Base Cabinets</option>
          <option value="Wall Cabinets">Wall Cabinets</option>
          <option value="Pantry & Tall">Pantry & Tall Cabinets</option>
          <option value="Vanity Cabinets">Vanity Cabinets</option>
          <option value="Moldings & Accessories">Moldings & Accessories</option>
        </select>
      </div>
      <div>
        <label style="display:block;font-size:11px;font-weight:800;color:#64748b;text-transform:uppercase;margin-bottom:3px">Supplier</label>
        <select id="priceVendorFilter" style="width:100%;padding:8px 10px;border:1px solid #cbd5e1;border-radius:6px;font-size:13px;background:#fff" onchange="renderPricing()">
          <option value="">All Suppliers</option>
          <option value="Achilles Stone">Achilles Stone</option>
          <option value="HomeCo">HomeCo</option>
          <option value="Golden Home">Golden Home</option>
          <option value="Top King">Top King</option>
          <option value="Galaxy Flooring">Galaxy Flooring</option>
          <option value="Elite Stone">Elite Stone Group</option>
          <option value="Raphael Stone">Raphael Stone</option>
          <option value="T & L">T & L Slabs</option>
          <option value="Grandwood">Grandwood</option>
          <option value="Central Cabinets Direct">Central Cabinets Direct</option>
        </select>
      </div>
      <div>
        <label style="display:block;font-size:11px;font-weight:800;color:#64748b;text-transform:uppercase;margin-bottom:3px">Size / Spec</label>
        <select id="priceSizeFilter" style="width:100%;padding:8px 10px;border:1px solid #cbd5e1;border-radius:6px;font-size:13px;background:#fff" onchange="renderPricing()">
          <option value="">All Sizes</option>
          <option value="2x9">2X9 Countertop</option>
          <option value="3x9">3X9 Peninsula Island</option>
          <option value="42x9">42X9 Large Island</option>
          <option value="52x9">52X9 Extra Large Island</option>
          <option value="Slab">Slab</option>
          <option value="SqFt">SqFt (Flooring)</option>
        </select>
      </div>
      <div>
        <label style="display:block;font-size:11px;font-weight:800;color:#64748b;text-transform:uppercase;margin-bottom:3px">Finish Color</label>
        <select id="priceFinish" style="width:100%;padding:8px 10px;border:1px solid #cbd5e1;border-radius:6px;font-size:13px;background:#fff" onchange="renderPricing()">
          <option value="sw">SW — White Shaker (Cabella Wholesale Net)</option>
          <option value="db">DB — Blue Shaker</option>
          <option value="slg">SLG — Light Grey</option>
          <option value="aw">AW — Antique White</option>
          <option value="dc">DC — Espresso / Dark Grey</option>
        </select>
      </div>
      <div style="display:flex;gap:6px">
        <button class="btn" style="flex:1;padding:8px;font-size:12.5px;font-weight:bold" onclick="renderPricing()">Filter</button>
        <button class="btn secondary" style="padding:8px 10px;font-size:12.5px" onclick="clearPriceFilters()">Reset</button>
      </div>
    </div>
  </div>

  <div id="vendorCostSummaryCards" class="cards" style="margin-bottom:12px"></div>
  <div id="priceResults"></div>
</section>

