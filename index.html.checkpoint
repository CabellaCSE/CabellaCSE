            </select>
          </div>
          <div>
            <label style="display:block; font-weight:800; font-size:12.5px; margin-bottom:4px">Quantity Received on Pallet / Truck *</label>
            <input id="inboundQty" type="number" min="1" value="20" required style="width:100%; padding:9px 12px; border:1px solid #cbd5e1; border-radius:6px; font-size:15px; font-weight:800">
          </div>
