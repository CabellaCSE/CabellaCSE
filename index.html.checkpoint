      return !query || item.sku.toLowerCase().includes(query) || item.name.toLowerCase().includes(query) || (item.desc || '').toLowerCase().includes(query) || (item.size || '').toLowerCase().includes(query);
    });

    if (items.length === 0) {
      body.innerHTML = `<tr><td colspan="6" style="padding:16px;text-align:center;color:var(--muted)">No HomeCo stone items found.</td></tr>`;
      return;
    }

    body.innerHTML = items.map(item => {
      const p26 = item.homeco ? `${item.homeco.toFixed(2)}` : 'N/A';
      const p36 = item.homeco ? `${(item.homeco * 1.38).toFixed(2)}` : 'N/A';
      const p42 = item.homeco ? `${(item.homeco * 1.60).toFixed(2)}` : 'N/A';
      const p52 = item.homeco ? `${(item.homeco * 1.95).toFixed(2)}` : 'N/A';
      return `
        <tr style="border-bottom:1px solid #e2e8f0">
          <td style="padding:8px 12px;font-weight:bold;color:#0f2942">
            <div>${esc(item.name)}</div>
            <div style="font-size:11px;font-family:monospace;color:#64748b">${esc(item.sku)}</div>
          </td>
          <td style="padding:8px 10px;text-align:center;font-weight:700;color:#065f46">${p26}</td>
          <td style="padding:8px 10px;text-align:center;color:#047857">${p36}</td>
          <td style="padding:8px 10px;text-align:center;color:#047857">${p42}</td>
          <td style="padding:8px 10px;text-align:center;color:#047857">${p52}</td>
          <td style="padding:8px 12px;font-size:12px;color:var(--muted)">${esc(item.desc || 'HomeCo Prefab Matrix')}</td>
        </tr>
      `;
    }).join('');
  }

  function renderPlGalaxyFlooring(q) {
    const body = document.getElementById('plGalaxyFlooringTableBody');
    if (!body) return;
    const query = (q || '').trim().toLowerCase();
    const data = (typeof FLOORING_COMPARISON_DATA !== 'undefined') ? FLOORING_COMPARISON_DATA : [];
    const items = data.filter(item => {
      return !query || item.sku.toLowerCase().includes(query) || item.name.toLowerCase().includes(query) || (item.desc || '').toLowerCase().includes(query) || (item.size || '').toLowerCase().includes(query);
    });

    if (items.length === 0) {
      body.innerHTML = `<tr><td colspan="4" style="padding:16px;text-align:center;color:var(--muted)">No Galaxy Flooring items found.</td></tr>`;
      return;
    }

    body.innerHTML = items.map(item => `
      <tr style="border-bottom:1px solid #e2e8f0">
        <td style="padding:8px 12px;font-weight:bold;color:#0f2942">
          <div>${esc(item.name)}</div>
          <div style="font-size:11px;font-family:monospace;color:#64748b">${esc(item.sku)}</div>
        </td>
        <td style="padding:8px 12px;font-size:12px;color:#475569"><span class="badge" style="margin:0;font-size:10.5px">${esc(item.size || item.wear || 'SqFt')}</span></td>
        <td style="padding:8px 10px;text-align:right;font-weight:bold;color:#0d9488;background:#f0fdf4">${Number(item.galaxy).toFixed(2)}</td>
        <td style="padding:8px 12px;font-size:12px;color:var(--muted)">${esc(item.desc || 'Galaxy Direct Wholesale')}</td>
      </tr>
    `).join('');
  }

