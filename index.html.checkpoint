              <th style="padding: 10px 12px; text-align: right">Total Amount</th>
              <th style="padding: 10px 12px; text-align: right">50% Deposit</th>
              <th style="padding: 10px 12px; text-align: right; background: #047857">Balance Due</th>
              <th style="padding: 10px 12px; text-align: center">Status</th>
              <th style="padding: 10px 12px; text-align: center">Actions</th>
            </tr>
          </thead>
