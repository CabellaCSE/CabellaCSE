function getQboStore() {
  try {
    const raw = localStorage.getItem('cabellaQboData');
    if (raw) {
      const parsed = JSON.parse(raw);
      if (parsed && parsed.invoices) {
        const inv8381 = parsed.invoices.find(x => x.id === '8381');
        if (inv8381) {
          inv8381.customer = 'Nick Elo';
          inv8381.company = 'Fast Vegas Home Buyers';
          inv8381.shipTo = 'Fast Vegas Home Buyers\nNick Elo\n2620 Regatta Dr #102\nLas Vegas, NV 89128\nUnited States';
          inv8381.total = 2756.25;
          inv8381.subtotal = 2545.00;
          inv8381.taxAmount = 211.25;
          inv8381.date = '2026-08-15';
          inv8381.dueDate = '2026-08-15';
          inv8381.status = 'Paid in Full';
        }
      }
      return parsed;
    }
  } catch(e) {}
  localStorage.setItem('cabellaQboData', JSON.stringify(DEFAULT_QBO_STORE));
  return DEFAULT_QBO_STORE;
}

function saveQboStore(store) {
  localStorage.setItem('cabellaQboData', JSON.stringify(store));
  renderAllQboTables();
}

function openQboTransactionModal(type = 'Invoice', existingId = null) {
  const store = getQboStore();
  let item = null;
  if (existingId) {
    if (type === 'Invoice') item = store.invoices.find(x => x.id === existingId);
    else if (type === 'Estimate') item = store.estimates.find(x => x.id === existingId);
    else if (type === 'Purchase Order') item = store.pos.find(x => x.id === existingId);
    else if (type === 'Bill') item = store.bills.find(x => x.id === existingId);
    else if (type === 'Project') item = store.projects.find(x => x.id === existingId);
  }

  // Generate clean unpopulated item if creating new
  if (!item) {
    const randNum = Math.floor(Math.random() * 900 + 8415);
    if (type === 'Invoice') {
      item = {
        id: String(randNum),
        customer: '',
        jobsite: '',
        shipTo: '',
        date: new Date().toISOString().split('T')[0],
        dueDate: new Date().toISOString().split('T')[0],
        terms: 'Due on receipt',
        salesRep: (typeof currentActiveUser !== 'undefined' && currentActiveUser.name) ? currentActiveUser.name : 'Gil Sirimarco (CFO)',
        poNumber: '',
        items: [
          { product: 'Cabinets', desc: '', qty: 1, rate: 0.00, amount: 0.00, tax: true }
        ],
        subtotal: 0.00,
        taxRate: 0.08375,
        taxAmount: 0.00,
        shipping: 0.00,
        total: 0.00,
        deposit: 0.00,
        balanceDue: 0.00,
        status: 'Unpaid',
        paymentInstructions: 'You can Pay - Zelle@CabellaCollections.com | Check payable to Cabella Cabinets Stone & Flooring',
        customerNote: 'A copy of this invoice is required for pickup. Se requiere una copia de esta factura para recoger sus artículos.',
        internalNotes: '',
        attachments: []
      };
    } else if (type === 'Estimate') {
      item = {
        id: 'EST-' + randNum,
        customer: '',
        jobsite: '',
        shipTo: '',
        date: new Date().toISOString().split('T')[0],
        expirationDate: new Date(Date.now() + 30*86400000).toISOString().split('T')[0],
        terms: '50% Deposit Required',
        salesRep: 'Gil Sirimarco (CFO)',
        poNumber: '',
        items: [
          { product: 'Countertops & Stone Slabs', desc: '', qty: 1, rate: 0.00, amount: 0.00, tax: true }
        ],
        subtotal: 0.00,
        taxRate: 0.08375,
        taxAmount: 0.00,
        shipping: 0.00,
        total: 0.00,
        status: 'Pending Approval'
      };
    } else if (type === 'Purchase Order') {
      item = {
        id: 'PO-2026-' + randNum,
        vendor: 'HomeCo Cabinets',
        jobsiteRef: '',
        date: new Date().toISOString().split('T')[0],
        deliveryDate: new Date(Date.now() + 10*86400000).toISOString().split('T')[0],
        items: [
          { product: 'White Shaker Stock RTA', desc: '', qty: 1, rate: 0.00, amount: 0.00 }
        ],
        subtotal: 0.00,
        shipping: 0.00,
        total: 0.00,
        status: 'Issued to Vendor'
      };
    } else if (type === 'Bill') {
      item = {
        id: 'BILL-' + randNum,
        vendor: 'HomeCo Cabinets',
        jobsiteRef: '',
        date: new Date().toISOString().split('T')[0],
        dueDate: new Date(Date.now() + 30*86400000).toISOString().split('T')[0],
        items: [
          { product: 'Vendor Inventory Order', desc: '', qty: 1, rate: 0.00, amount: 0.00 }
        ],
        subtotal: 0.00,
        total: 0.00,
        status: 'Unpaid'
      };
    } else if (type === 'Project') {
      item = {
        id: 'PROJ-' + randNum,
        name: '',
        client: '',
        address: '',
        pm: 'Jerry Maza (PM)',
        contractValue: 0.00,
        invoiced: 0.00,
        expenses: 0.00,
        status: 'Active'
      };
    }
  }

  const title = (existingId ? '✏️ View / Edit ' : '📄 Create New ') + type;
  const content = buildQboFormHtml(type, item);
  showModal(title, content, '920px');
  calcQboTotals();
}

function buildQboFormHtml(type, data) {
  const isInvoice = type === 'Invoice';
  const isEstimate = type === 'Estimate';
  const isPO = type === 'Purchase Order';
  const isProject = type === 'Project';
  const isBill = type === 'Bill';

  if (isProject) {
    return `
      <form onsubmit="handleQboProjectSave(event, '${esc(data.id)}')" style="font-family: Roboto, Arial, sans-serif; background:#ffffff; border-radius:8px; padding:10px">
        <div style="background:#f1f5f9; padding:12px; border-radius:8px; margin-bottom:16px; border:1px solid #cbd5e1">
          <h4 style="margin:0; font-size:15px; color:#0f172a; font-weight:800">🏗️ QuickBooks Jobsite Project</h4>
          <p style="margin:2px 0 0; font-size:12px; color:#64748b">Track jobsite contract revenues, vendor PO bills, and gross profit margins in one place.</p>
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:14px">
          <div>
            <label style="display:block; font-size:12px; font-weight:800; color:#334155; margin-bottom:4px">Project / Job Reference Name *</label>
            <input id="qboProjName" type="text" value="${esc(data.name || '')}" placeholder="e.g. YOHADI" required style="width:100%; padding:9px 12px; border:1px solid #94a3b8; border-radius:6px; font-weight:700; font-size:13px">
          </div>
          <div>
            <label style="display:block; font-size:12px; font-weight:800; color:#334155; margin-bottom:4px">Client / Customer Name *</label>
            <input id="qboProjClient" type="text" value="${esc(data.client || '')}" placeholder="e.g. Nestor Garcia" required style="width:100%; padding:9px 12px; border:1px solid #94a3b8; border-radius:6px; font-weight:700; font-size:13px">
          </div>
        </div>
        <div style="margin-bottom:14px">
          <label style="display:block; font-size:12px; font-weight:800; color:#334155; margin-bottom:4px">Full Jobsite Street Address *</label>
          <input id="qboProjAddress" type="text" value="${esc(data.address || '')}" placeholder="e.g. 4325 El Conlon Ave, Las Vegas NV 89102" required style="width:100%; padding:9px 12px; border:1px solid #94a3b8; border-radius:6px; font-weight:700; font-size:13px">
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:18px">
          <div>
            <label style="display:block; font-size:12px; font-weight:800; color:#334155; margin-bottom:4px">Assigned Project Manager *</label>
            <select id="qboProjPm" style="width:100%; padding:9px 12px; border:1px solid #94a3b8; border-radius:6px; font-weight:700; font-size:13px">
              <option value="Margie Caro (PM)">Margie Caro (Project Manager & Sales)</option>
              <option value="Jerry Maza (PM)">Jerry Maza (Project Manager)</option>
              <option value="Gil Sirimarco (CFO)">Gil Sirimarco (CFO)</option>
              <option value="Edwin Portillo (Sales)">Edwin Portillo (Sales Rep)</option>
              <option value="Mayra Rodriguez (Orders)">Logistics & Orders Desk</option>
            </select>
          </div>
          <div>
            <label style="display:block; font-size:12px; font-weight:800; color:#334155; margin-bottom:4px">Approved Contract Value ($) *</label>
            <input id="qboProjContract" type="number" step="0.01" value="${data.contractValue || 0}" placeholder="2984.83" required style="width:100%; padding:9px 12px; border:1px solid #94a3b8; border-radius:6px; font-weight:800; font-size:14px; color:#0b57d0">
          </div>
        </div>
        <div style="display:flex; justify-content:flex-end; gap:10px; border-top:1px solid #e2e8f0; padding-top:14px">
          <button type="button" onclick="closeModal()" style="background:#f1f5f9; color:#475569; border:1px solid #cbd5e1; padding:10px 18px; border-radius:6px; font-weight:700; cursor:pointer">Cancel</button>
          <button type="submit" style="background:#0b57d0; color:#ffffff; border:0; padding:10px 22px; border-radius:6px; font-weight:800; font-size:13.5px; cursor:pointer">💾 Save Jobsite Project</button>
        </div>
      </form>
    `;
  }

  const items = data.items || [{ product: 'Cabinets', desc: '', qty: 1, rate: 0, amount: 0, tax: true }];

  // Vendors list for PO / Bills
  const vendors = (typeof BASE_DATA !== 'undefined' && BASE_DATA.vendors) ? BASE_DATA.vendors : [];
  const vendorOptions = vendors.map(v => `<option value="${esc(v.name || v.display)}">${esc(v.name || v.display)}</option>`).join('');

  // Generic Customer Product Options (NO VENDOR NAMES)
  const customerProdOptions = `
    <option value="Cabinets">Cabinets (Wall / Base Sets)</option>
    <option value="Countertops & Stone Slabs">Countertops & Stone Slabs</option>
    <option value="Hardware & Accessories">Hardware & Accessories</option>
    <option value="Sinks & Plumbing">Sinks & Plumbing</option>
    <option value="Tile & Flooring">Tile & Flooring</option>
    <option value="Labor & Installation">Labor & Installation</option>
    <option value="Freight & Delivery">Freight & Delivery</option>
  `;

  return `
    <div style="font-family: Roboto, Arial, sans-serif; background:#ffffff; border:1px solid #dadce0; border-radius:8px; overflow:hidden; box-shadow:0 4px 16px rgba(0,0,0,0.08);">
      
      <!-- 1. TOP VIEW TABS BAR -->
      <div style="background:#f8fafd; border-bottom:1px solid #e0e0e0; padding:8px 16px; display:flex; justify-content:space-between; align-items:center;">
        <div style="display:flex; gap:16px; align-items:center; font-size:13px; font-weight:700">
          <span style="color:#1f1f1f; font-size:14px; font-weight:800; display:flex; align-items:center; gap:6px">
            <span>${isInvoice ? '📄' : (isEstimate ? '📐' : (isPO ? '📦' : '💵'))}</span>
            <span>${type} #${esc(data.id)}</span>
          </span>
          <button type="button" onclick="switchQboModalTab('edit')" id="qboTabBtnEdit" style="background:none; border:none; color:#006738; border-bottom:3px solid #006738; padding-bottom:4px; font-weight:800; cursor:pointer; font-size:13px">✏️ Edit Form</button>
          ${(isInvoice || isEstimate) ? `
            <button type="button" onclick="switchQboModalTab('preview')" id="qboTabBtnPreview" style="background:none; border:none; color:#444746; padding-bottom:4px; font-weight:700; cursor:pointer; font-size:13px">📄 Client Invoice PDF View</button>
          ` : ''}
        </div>
        <div style="display:flex; gap:12px; align-items:center; font-size:12px; color:#444746">
          <button type="button" onclick="showToast('⚙️ QBO Form Settings Active')" style="background:none; border:0; color:#444746; font-weight:700; cursor:pointer">⚙️ Manage</button>
          <button type="button" onclick="showToast('💬 Opening Feedback')" style="background:none; border:0; color:#444746; font-weight:700; cursor:pointer">💬 Feedback</button>
        </div>
      </div>

      <!-- EDIT FORM SECTION -->
      <div id="qboModalEditSection">
        <!-- CLIENT CONFIDENTIALITY BANNER -->
        ${(isInvoice || isEstimate) ? `
          <div style="background:#f0fdf4; border-bottom:1px solid #bbf7d0; color:#166534; padding:8px 16px; font-size:12px; font-weight:700; display:flex; align-items:center; justify-content:space-between">
            <div style="display:flex; align-items:center; gap:8px">
              <span style="font-size:14px">🔒</span>
              <span><strong>Confidential Customer View:</strong> Supplier and vendor details are strictly excluded on client invoices to protect Cabella trade pricing.</span>
            </div>
            <span style="background:#dcfce7; color:#15803d; padding:2px 8px; border-radius:12px; font-size:11px; font-weight:800">Client-Safe</span>
          </div>
        ` : ''}

        <!-- 2. BUSINESS INFO BAR -->
        <div style="background:#f1f3f4; padding:8px 16px; border-bottom:1px solid #e0e0e0; display:flex; justify-content:space-between; align-items:center; font-size:12px; color:#444746">
          <div style="display:flex; align-items:center; gap:6px; font-weight:700">
            <span>Business info:</span>
            <strong style="color:#1f1f1f">CABELLA CABINETS STONE & FLOORING ˅</strong>
          </div>
          <div style="font-weight:700; color:#0f172a">
            <span>Balance due: </span>
            <strong id="qboLiveBalanceDue" style="color:#0b57d0; font-size:13px">$ ${Number(data.balanceDue || data.total || 0).toFixed(2)}</strong>
          </div>
        </div>

        <!-- 3. ONLINE PAYMENTS RIBBON -->
        <div style="background:#f8fafc; padding:8px 16px; border-bottom:1px solid #e0e0e0; display:flex; justify-content:space-between; align-items:center; font-size:12px">
          <div style="display:flex; align-items:center; gap:8px">
            <span style="font-weight:700; color:#444746">Online payments</span>
            <span style="color:#0b57d0; font-weight:800; cursor:pointer">Get started</span>
            <span style="background:#e2e8f0; border-radius:4px; padding:2px 6px; font-size:10.5px; font-weight:800; color:#006738">Zelle</span>
            <span style="background:#e2e8f0; border-radius:4px; padding:2px 6px; font-size:10.5px; font-weight:800; color:#1e3a8a">VISA</span>
            <span style="background:#e2e8f0; border-radius:4px; padding:2px 6px; font-size:10.5px; font-weight:800; color:#c2410c">Mastercard</span>
          </div>
          <div style="color:#64748b; font-size:11px">
            <span>3555 West Reno Ave Suite G, Las Vegas NV 89118</span>
          </div>
        </div>

        <form onsubmit="handleQboTransactionSave(event, '${esc(type)}', '${esc(data.id)}')" style="margin:0">
          <!-- 4. PRIMARY HEADER FORM FIELDS GRID -->
          <div style="padding:16px; background:#ffffff; border-bottom:1px solid #e0e0e0; display:grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap:12px; align-items:start">
            <!-- Customer / Vendor Field -->
            <div>
              <label style="display:block; font-size:12px; font-weight:800; color:#444746; margin-bottom:4px">
                ${isPO || isBill ? 'Add Vendor ˅' : 'Add Customer ˅'}
              </label>
              ${isPO || isBill ? `
                <select id="qboFormParty" required style="width:100%; padding:8px 10px; border:1px solid #006738; border-radius:6px; font-weight:700; font-size:13px; outline:none; background:#f0fdf4">
                  ${vendorOptions}
                </select>
              ` : `
                <input id="qboFormParty" type="text" value="${esc(data.customer || '')}" placeholder="Select or type customer name..." required style="width:100%; padding:8px 10px; border:1px solid #006738; border-radius:6px; font-weight:700; font-size:13px; outline:none">
              `}
            </div>

            <!-- Doc Number -->
            <div>
              <label style="display:block; font-size:12px; font-weight:800; color:#444746; margin-bottom:4px">
                ${isInvoice ? 'Invoice no.' : (isEstimate ? 'Estimate no.' : (isPO ? 'PO #' : 'Bill #'))}
              </label>
              <input id="qboFormDocId" type="text" value="${esc(data.id)}" required style="width:100%; padding:8px 10px; border:1px solid #cbd5e1; border-radius:6px; font-weight:700; font-size:13px">
            </div>

            <!-- Terms -->
            <div>
              <label style="display:block; font-size:12px; font-weight:800; color:#444746; margin-bottom:4px">Terms</label>
              <select id="qboFormTerms" style="width:100%; padding:8px 10px; border:1px solid #cbd5e1; border-radius:6px; font-weight:700; font-size:12.5px">
                <option value="Due on receipt" ${data.terms === 'Due on receipt' ? 'selected' : ''}>Due on receipt</option>
                <option value="Net 15 Days" ${data.terms === 'Net 15 Days' ? 'selected' : ''}>Net 15 Days</option>
                <option value="Net 30 Days" ${data.terms === 'Net 30 Days' ? 'selected' : ''}>Net 30 Days</option>
                <option value="50% Deposit Required" ${data.terms === '50% Deposit Required' ? 'selected' : ''}>50% Deposit Required</option>
              </select>
            </div>

            <!-- Dates -->
            <div>
              <label style="display:block; font-size:12px; font-weight:800; color:#444746; margin-bottom:4px">
                ${isInvoice ? 'Invoice date' : (isEstimate ? 'Estimate date' : 'Date')}
              </label>
              <input id="qboFormDate" type="date" value="${data.date}" required style="width:100%; padding:8px 10px; border:1px solid #cbd5e1; border-radius:6px; font-weight:700; font-size:12.5px">
            </div>
          </div>

          <!-- SECONDARY ROW: Sales Rep & Jobsite Ref -->
          <div style="padding:10px 16px; background:#ffffff; border-bottom:1px solid #e0e0e0; display:grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap:12px">
            <div>
              <label style="display:block; font-size:12px; font-weight:800; color:#444746; margin-bottom:4px">Sales Rep / PM</label>
              <select id="qboFormSalesRep" style="width:100%; padding:7px 10px; border:1px solid #cbd5e1; border-radius:6px; font-weight:700; font-size:12.5px">
                <option value="Margie Caro" ${(data.salesRep === "Margie Caro" || data.salesRep === "Margie Caro (PM)") ? "selected" : ""}>Margie Caro (Project Manager & Sales)</option>
                <option value="Edwin Portillo" ${data.salesRep === 'Edwin Portillo' ? 'selected' : ''}>Edwin Portillo</option>
                <option value="Gil Sirimarco (CFO)" ${data.salesRep === 'Gil Sirimarco (CFO)' ? 'selected' : ''}>Gil Sirimarco (CFO)</option>
                <option value="Jerry Maza (PM)" ${data.salesRep === 'Jerry Maza (PM)' ? 'selected' : ''}>Jerry Maza (Project Manager)</option>
                <option value="Mayra Rodriguez (Orders)" ${data.salesRep === 'Mayra Rodriguez (Orders)' ? 'selected' : ''}>Mayra Rodriguez (Orders)</option>
              </select>
            </div>
            <div>
              <label style="display:block; font-size:12px; font-weight:800; color:#444746; margin-bottom:4px">PO #</label>
              <input id="qboFormPoNum" type="text" value="${esc(data.poNumber || '')}" placeholder="e.g. GW3142" style="width:100%; padding:7px 10px; border:1px solid #cbd5e1; border-radius:6px; font-weight:700; font-size:12.5px">
            </div>
            <div>
              <label style="display:block; font-size:12px; font-weight:800; color:#444746; margin-bottom:4px">Project / Job Name</label>
              <input id="qboFormJobsite" type="text" value="${esc(data.jobsite || '')}" placeholder="e.g. YOHADI / 4325 El Conlon Ave" style="width:100%; padding:7px 10px; border:1px solid #cbd5e1; border-radius:6px; font-weight:600; font-size:12.5px">
            </div>
            <div>
              <label style="display:block; font-size:12px; font-weight:800; color:#444746; margin-bottom:4px">Due Date</label>
              <input id="qboFormDueDate" type="date" value="${data.dueDate || data.date}" style="width:100%; padding:7px 10px; border:1px solid #cbd5e1; border-radius:6px; font-weight:700; font-size:12.5px">
            </div>
          </div>

          <!-- 5. PRODUCT OR SERVICE DYNAMIC LINE ITEMS TABLE -->
          <div style="padding:16px; background:#ffffff;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px">
              <div style="font-size:14px; font-weight:800; color:#1f1f1f; display:flex; align-items:center; gap:6px">
                <span>📦</span> <span>Product or service line items</span>
              </div>
              <div style="font-size:11.5px; color:#64748b; font-weight:600">
                <span>Copy-paste multi-line cabinet cutlists into Description box below</span>
              </div>
            </div>

            <!-- Table -->
            <div style="overflow-x:auto; border:1px solid #dadce0; border-radius:6px">
              <table id="qboItemsTable" style="width:100%; border-collapse:collapse; font-size:12.5px">
                <thead>
                  <tr style="background:#f8fafd; border-bottom:1px solid #dadce0; color:#444746; text-align:left">
                    <th style="padding:8px; width:30px; text-align:center">#</th>
                    <th style="padding:8px; width:220px">Product/service</th>
                    <th style="padding:8px">Description (Paste Cutlists / Items)</th>
                    <th style="padding:8px; width:70px; text-align:right">Qty</th>
                    <th style="padding:8px; width:100px; text-align:right">Rate ($)</th>
                    <th style="padding:8px; width:110px; text-align:right">Amount ($)</th>
                    <th style="padding:8px; width:45px; text-align:center">Tax</th>
                    <th style="padding:8px; width:40px; text-align:center"></th>
                  </tr>
                </thead>
                <tbody id="qboItemsTbody">
                  ${items.map((it, idx) => `
                    <tr class="qbo-item-row" style="border-bottom:1px solid #f1f3f4; vertical-align:top">
                      <td style="padding:8px; text-align:center; font-weight:800; color:#64748b" class="qbo-row-num">${idx + 1}</td>
                      <td style="padding:8px">
                        ${(isInvoice || isEstimate) ? `
                          <select class="qbo-prod-input" style="width:100%; border:1px solid #cbd5e1; border-radius:4px; padding:6px; font-weight:700; font-size:12px; background:#fff">
                            <option value="Cabinets" ${it.product === 'Cabinets' ? 'selected' : ''}>Cabinets</option>
                            <option value="Countertops & Stone Slabs" ${it.product === 'Countertops & Stone Slabs' ? 'selected' : ''}>Countertops & Stone Slabs</option>
                            <option value="Hardware & Accessories" ${it.product === 'Hardware & Accessories' ? 'selected' : ''}>Hardware & Accessories</option>
                            <option value="Sinks & Plumbing" ${it.product === 'Sinks & Plumbing' ? 'selected' : ''}>Sinks & Plumbing</option>
                            <option value="Tile & Flooring" ${it.product === 'Tile & Flooring' ? 'selected' : ''}>Tile & Flooring</option>
                            <option value="Labor & Installation" ${it.product === 'Labor & Installation' ? 'selected' : ''}>Labor & Installation</option>
                            <option value="Freight & Delivery" ${it.product === 'Freight & Delivery' ? 'selected' : ''}>Freight & Delivery</option>
                          </select>
                        ` : `
                          <input type="text" class="qbo-prod-input" value="${esc(it.product || '')}" placeholder="Vendor product..." style="width:100%; border:1px solid #cbd5e1; border-radius:4px; padding:6px; font-weight:700; font-size:12px">
                        `}
                      </td>
                      <td style="padding:8px">
                        <textarea class="qbo-desc-input" rows="3" placeholder="Paste item list / cabinet codes (e.g. SM: YOHADI, W3042 X1, SB36 X1)..." style="width:100%; border:1px solid #cbd5e1; border-radius:4px; padding:6px; font-size:12px; font-family:sans-serif; resize:vertical">${esc(it.desc || '')}</textarea>
                      </td>
                      <td style="padding:8px">
                        <input type="number" step="1" class="qbo-qty-input" value="${it.qty || 1}" oninput="calcQboTotals()" style="width:100%; border:1px solid #cbd5e1; border-radius:4px; padding:6px; text-align:right; font-weight:700; font-size:12px">
                      </td>
                      <td style="padding:8px">
                        <input type="number" step="0.01" class="qbo-rate-input" value="${it.rate || 0}" oninput="calcQboTotals()" style="width:100%; border:1px solid #cbd5e1; border-radius:4px; padding:6px; text-align:right; font-weight:700; font-size:12px">
                      </td>
                      <td style="padding:8px; text-align:right; font-weight:800; color:#0f172a" class="qbo-amount-cell">
                        $ ${Number(it.amount || (it.qty * it.rate) || 0).toFixed(2)}
                      </td>
                      <td style="padding:8px; text-align:center">
                        <input type="checkbox" class="qbo-tax-input" ${it.tax ? 'checked' : ''} onchange="calcQboTotals()" style="width:15px; height:15px; cursor:pointer">
                      </td>
                      <td style="padding:8px; text-align:center">
                        <button type="button" onclick="removeQboRow(this)" style="background:none; border:0; color:#ef4444; font-weight:800; cursor:pointer; font-size:14px" title="Delete row">🗑️</button>
                      </td>
                    </tr>
                  `).join('')}
                </tbody>
              </table>
            </div>

            <div style="display:flex; gap:10px; margin-top:10px">
              <button type="button" onclick="addQboRow('${type}')" style="background:#ffffff; color:#006738; border:1px solid #006738; padding:6px 14px; border-radius:18px; font-size:12px; font-weight:800; cursor:pointer">
                + Add line item ˅
              </button>
              <button type="button" onclick="document.querySelectorAll('.qbo-desc-input').forEach(i=>i.value=''); calcQboTotals()" style="background:none; border:0; color:#64748b; font-size:12px; font-weight:700; cursor:pointer">
                Clear all descriptions
              </button>
            </div>
          </div>

          <!-- 6. SUMMARY & PAYMENT DETAILS GRID -->
          <div style="padding:16px; background:#f8fafd; border-top:1px solid #dadce0; display:grid; grid-template-columns:1fr 1fr; gap:24px">
            <!-- Left Column: Payment & Notes -->
            <div>
              <div style="margin-bottom:12px">
                <label style="display:block; font-size:12px; font-weight:800; color:#444746; margin-bottom:4px">Payment instructions</label>
                <input id="qboFormPayInstructions" type="text" value="${esc(data.paymentInstructions || 'You can Pay - Zelle@CabellaCollections.com')}" style="width:100%; border:1px solid #cbd5e1; border-radius:6px; padding:7px; font-size:12px">
              </div>
              <div>
                <label style="display:block; font-size:12px; font-weight:800; color:#444746; margin-bottom:4px">Note to customer</label>
                <textarea id="qboFormCustomerNote" rows="2" style="width:100%; border:1px solid #cbd5e1; border-radius:6px; padding:8px; font-size:12px; font-family:sans-serif; line-height:1.4">${esc(data.customerNote || 'A copy of this invoice is required for pickup. Se requiere una copia de esta factura para recoger sus artículos.')}</textarea>
              </div>
            </div>

            <!-- Right Column: Financial Calculation Totals -->
            <div style="background:#ffffff; border:1px solid #cbd5e1; border-radius:8px; padding:14px; font-size:13px">
              <div style="display:flex; justify-content:space-between; padding:4px 0; color:#444746 font-weight:600">
                <span>Subtotal</span>
                <strong id="qboDisplaySubtotal" style="color:#0f172a">$ ${Number(data.subtotal || 0).toFixed(2)}</strong>
              </div>

              <!-- Tax Dropdown -->
              <div style="display:flex; justify-content:space-between; align-items:center; padding:6px 0">
                <div style="display:flex; align-items:center; gap:6px">
                  <span style="font-size:12px; color:#444746; font-weight:700">Sales Tax:</span>
                  <select id="qboTaxRateSelect" onchange="calcQboTotals()" style="border:1px solid #cbd5e1; border-radius:4px; padding:2px 6px; font-size:11.5px; font-weight:700">
                    <option value="0.08375" ${(data.taxRate || 0.08375) === 0.08375 ? 'selected' : ''}>NV Tax (8.375%)</option>
                    <option value="0.00" ${data.taxRate === 0 ? 'selected' : ''}>Tax Exempt / Wholesale (0%)</option>
                  </select>
                </div>
                <strong id="qboDisplayTax" style="color:#0f172a">$ ${Number(data.taxAmount || 0).toFixed(2)}</strong>
              </div>

              ${isInvoice ? `
                <div style="display:flex; justify-content:space-between; align-items:center; padding:6px 0">
                  <span style="font-size:12px; color:#444746; font-weight:700">Freight / Shipping ($)</span>
                  <input id="qboFormShipping" type="number" step="0.01" value="${data.shipping || 0}" oninput="calcQboTotals()" style="width:90px; text-align:right; border:1px solid #cbd5e1; border-radius:4px; padding:4px; font-weight:700; font-size:12px">
                </div>
              ` : ''}

              <div style="display:flex; justify-content:space-between; padding:8px 0; border-top:1px solid #e2e8f0; margin-top:4px; font-size:15px; font-weight:900; color:#0f172a">
                <span>Total Amount</span>
                <strong id="qboDisplayTotal" style="color:#0f172a">$ ${Number(data.total || 0).toFixed(2)}</strong>
              </div>

              ${isInvoice ? `
                <div style="display:flex; justify-content:space-between; align-items:center; padding:6px 0; background:#f0fdf4; margin:4px -14px; padding:8px 14px">
                  <span style="font-size:12px; color:#166534; font-weight:800">Deposit / Payment Received ($)</span>
                  <input id="qboFormDeposit" type="number" step="0.01" value="${data.deposit || 0}" oninput="calcQboTotals()" style="width:100px; text-align:right; border:1px solid #006738; border-radius:4px; padding:4px; font-weight:800; font-size:13px; color:#166534">
                </div>
              ` : ''}

              <div style="display:flex; justify-content:space-between; padding:8px 0; border-top:2px solid #0b57d0; margin-top:6px; font-size:16px; font-weight:900">
                <span style="color:#0f172a">Balance Due</span>
                <strong id="qboDisplayBalanceDue" style="color:#0b57d0">$ ${Number(data.balanceDue || 0).toFixed(2)}</strong>
              </div>
            </div>
          </div>

          <!-- 7. BOTTOM ACTION FOOTER -->
          <div style="background:#1f1f1f; padding:12px 20px; display:flex; justify-content:space-between; align-items:center">
            <div>
              <button type="button" onclick="closeModal()" style="background:transparent; color:#e2e8f0; border:1px solid #475569; padding:8px 16px; border-radius:18px; font-weight:700; font-size:12.5px; cursor:pointer">Cancel</button>
            </div>
            <div style="display:flex; gap:10px">
              <button type="button" onclick="switchQboModalTab('preview')" style="background:#334155; color:#ffffff; border:0; padding:8px 16px; border-radius:18px; font-weight:700; font-size:12.5px; cursor:pointer">
                👁️ Preview PDF
              </button>
              <button type="submit" style="background:#006738; color:#ffffff; border:0; padding:9px 24px; border-radius:18px; font-weight:800; font-size:13.5px; cursor:pointer; box-shadow:0 2px 6px rgba(0,0,0,0.3)">
                💾 Save & Sync ${type}
              </button>
            </div>
          </div>
        </form>
      </div>

      <!-- PDF PREVIEW SECTION -->
      <div id="qboModalPreviewSection" style="display:none; padding:20px; background:#f1f5f9; max-height:75vh; overflow-y:auto">
        ${generateQboPdfHtml(data)}
      </div>

    </div>
  `;
}

function switchQboModalTab(tab) {
  const editSec = document.getElementById('qboModalEditSection');
  const prevSec = document.getElementById('qboModalPreviewSection');
  const btnEdit = document.getElementById('qboTabBtnEdit');
  const btnPrev = document.getElementById('qboTabBtnPreview');

  if (tab === 'preview') {
    if (editSec) editSec.style.display = 'none';
    if (prevSec) prevSec.style.display = 'block';
    if (btnEdit) { btnEdit.style.color = '#444746'; btnEdit.style.borderBottom = 'none'; }
    if (btnPrev) { btnPrev.style.color = '#006738'; btnPrev.style.borderBottom = '3px solid #006738'; }
  } else {
    if (editSec) editSec.style.display = 'block';
    if (prevSec) prevSec.style.display = 'none';
    if (btnEdit) { btnEdit.style.color = '#006738'; btnEdit.style.borderBottom = '3px solid #006738'; }
    if (btnPrev) { btnPrev.style.color = '#444746'; btnPrev.style.borderBottom = 'none'; }
  }
}

function generateQboPdfHtml(data) {
  return `
    <div id="qboPdfPrintContainer" style="background:#ffffff; color:#1e293b; font-family:'Roboto', Arial, sans-serif; padding:32px; border-radius:8px; max-width:800px; margin:0 auto; box-shadow:0 2px 8px rgba(0,0,0,0.1)">
      <!-- Header row with Cabella Branding -->
      <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:24px; border-bottom:2px solid #f1f5f9; padding-bottom:16px">
        <div>
          <h1 style="margin:0 0 6px 0; font-size:24px; font-weight:900; color:#006738; letter-spacing:0.5px">INVOICE</h1>
          <div style="font-weight:800; font-size:13.5px; color:#0f172a">CABELLA CABINETS STONE & FL</div>
          <div style="font-size:12px; color:#475569; margin-top:2px; line-height:1.4">
            3555 W Reno Ave, Ste G<br>
            Las Vegas, NV 89118-7702<br>
            Orders@CabellaCollections.com<br>
            +1 (702) 879-2549<br>
            www.CabellaCollections.com
          </div>
        </div>
        <div style="text-align:right">
          <div style="font-size:28px; font-weight:900; color:#e11d48; letter-spacing:1px; line-height:1">CABELLA</div>
          <div style="font-size:10px; font-weight:800; color:#334155; letter-spacing:1px; margin-top:3px">CABINETS • STONE • FLOORING</div>
        </div>
      </div>

      <!-- Customer Bill To & Ship To Banner -->
      <div style="background:#f0f7ff; padding:14px 18px; border-radius:6px; margin-bottom:20px; display:grid; grid-template-columns:1fr 1fr; gap:16px">
        <div>
          <div style="font-size:13px; font-weight:800; color:#006738; margin-bottom:4px">${esc(data.customer || 'Customer')}:${esc(data.jobsite || '')}</div>
          <div style="font-size:11px; font-weight:700; color:#64748b; text-transform:uppercase; margin-bottom:2px">Bill to</div>
          <div style="font-size:13px; font-weight:700; color:#0f172a">${esc(data.customer || 'Customer Name')}</div>
          <div style="font-size:12px; color:#475569; white-space:pre-line">${esc(data.shipTo || data.jobsite || 'Las Vegas, NV')}</div>
        </div>
        <div>
          <div style="font-size:11px; font-weight:700; color:#64748b; text-transform:uppercase; margin-bottom:2px">Ship to</div>
          <div style="font-size:13px; font-weight:700; color:#0f172a">${esc(data.customer || 'Customer Name')}</div>
          <div style="font-size:12px; color:#475569; white-space:pre-line">${esc(data.shipTo || data.jobsite || 'Las Vegas, NV')}</div>
        </div>
      </div>

      <!-- Details Grid -->
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:20px; font-size:12px; background:#fafafa; padding:12px; border-radius:6px">
        <div>
          <div style="font-weight:800; color:#0f172a; margin-bottom:4px">Invoice details</div>
          <div><strong>Invoice no.:</strong> ${esc(data.id)}</div>
          <div><strong>Terms:</strong> ${esc(data.terms || 'Due on receipt')}</div>
          <div><strong>Invoice date:</strong> ${esc(data.date)}</div>
          <div><strong>Due date:</strong> ${esc(data.dueDate || data.date)}</div>
        </div>
        <div>
          <div style="font-weight:800; color:#0f172a; margin-bottom:4px">Project details</div>
          <div><strong>Sales Rep:</strong> ${esc(data.salesRep || 'Edwin Portillo')}</div>
          <div><strong>PO #:</strong> ${esc(data.poNumber || 'N/A')}</div>
          <div><strong>Project / Job Name:</strong> ${esc(data.jobsite || 'N/A')}</div>
        </div>
      </div>

      <!-- Line items table -->
      <table style="width:100%; border-collapse:collapse; font-size:12px; margin-bottom:20px">
        <thead>
          <tr style="border-bottom:1px solid #cbd5e1; text-align:left; color:#475569; font-weight:700">
            <th style="padding:8px 4px; width:25px">#</th>
            <th style="padding:8px; width:150px">Product or service</th>
            <th style="padding:8px">Description</th>
            <th style="padding:8px; width:45px; text-align:right">Qty</th>
            <th style="padding:8px; width:85px; text-align:right">Rate</th>
            <th style="padding:8px; width:95px; text-align:right">Amount</th>
          </tr>
        </thead>
        <tbody>
          ${(data.items || []).map((it, idx) => `
            <tr style="border-bottom:1px solid #f1f5f9; vertical-align:top">
              <td style="padding:10px 4px; color:#64748b; font-weight:700">${idx + 1}.</td>
              <td style="padding:10px 8px; font-weight:800; color:#0f172a">${esc(it.product || 'Cabinets')}</td>
              <td style="padding:10px 8px; font-family:sans-serif; color:#334155; white-space:pre-wrap; line-height:1.4; font-size:11.5px">${esc(it.desc || '')}</td>
              <td style="padding:10px 8px; text-align:right; font-weight:700">${it.qty || 1}</td>
              <td style="padding:10px 8px; text-align:right; font-weight:700">$ ${Number(it.rate || 0).toFixed(2)}</td>
              <td style="padding:10px 8px; text-align:right; font-weight:800; color:#0f172a">$ ${Number(it.amount || (it.qty * it.rate) || 0).toFixed(2)}</td>
            </tr>
          `).join('')}
        </tbody>
      </table>

      <!-- Subtotal, Tax, Total Block -->
      <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-top:16px; border-top:1px solid #e2e8f0; padding-top:14px">
        <div style="max-width:50%; font-size:11.5px; color:#475569">
          <div style="font-weight:700; color:#006738; margin-bottom:4px">You can Pay - Zelle@CabellaCollections.com</div>
          <div style="font-weight:800; color:#0f172a; margin-top:10px; margin-bottom:2px">Note to customer</div>
          <div style="font-size:11px; color:#64748b; line-height:1.4">${esc(data.customerNote || 'A copy of this invoice is required for pickup. Se requiere una copia de esta factura para recoger sus artículos.')}</div>
        </div>
        <div style="width:240px; font-size:12.5px">
          <div style="display:flex; justify-content:space-between; padding:3px 0; color:#475569">
            <span>Subtotal</span>
            <span style="font-weight:700">$ ${Number(data.subtotal || 0).toFixed(2)}</span>
          </div>
          <div style="display:flex; justify-content:space-between; padding:3px 0; color:#475569">
            <span>Sales tax</span>
            <span style="font-weight:700">$ ${Number(data.taxAmount || 0).toFixed(2)}</span>
          </div>
          ${data.shipping ? `
            <div style="display:flex; justify-content:space-between; padding:3px 0; color:#475569">
              <span>Freight / Delivery</span>
              <span style="font-weight:700">$ ${Number(data.shipping).toFixed(2)}</span>
            </div>
          ` : ''}
          <div style="display:flex; justify-content:space-between; padding:6px 0; border-top:2px solid #0f172a; margin-top:4px; font-size:15px; font-weight:900; color:#0f172a">
            <span>Total</span>
            <span>$ ${Number(data.total || 0).toFixed(2)}</span>
          </div>
          ${data.deposit ? `
            <div style="display:flex; justify-content:space-between; padding:3px 0; color:#059669; font-weight:700">
              <span>Payment / Deposit</span>
              <span>-$ ${Number(data.deposit).toFixed(2)}</span>
            </div>
          ` : ''}
          <div style="display:flex; justify-content:space-between; padding:6px 0; border-top:1px solid #cbd5e1; margin-top:4px; font-size:14px; font-weight:900; color:${data.balanceDue > 0 ? '#b91c1c' : '#166534'}">
            <span>Balance due</span>
            <span>$ ${Number(data.balanceDue || 0).toFixed(2)}</span>
          </div>
          ${data.balanceDue <= 0 ? `
            <div style="text-align:right; margin-top:6px">
              <span style="background:#166534; color:#ffffff; padding:3px 10px; border-radius:4px; font-weight:900; font-size:11px; letter-spacing:0.5px">Paid in Full</span>
            </div>
          ` : ''}
        </div>
      </div>

      <!-- Action Footer -->
      <div style="margin-top:24px; text-align:right; border-top:1px solid #e2e8f0; padding-top:12px">
        <button type="button" onclick="window.print()" style="background:#006738; color:#ffffff; border:none; padding:8px 18px; border-radius:6px; font-weight:800; font-size:12px; cursor:pointer">
          🖨️ Print / Export PDF
        </button>
      </div>
    </div>
  `;
}

function addQboRow(type = 'Invoice') {
  const tbody = document.getElementById('qboItemsTbody');
  if (!tbody) return;
  const count = tbody.querySelectorAll('.qbo-item-row').length + 1;
  const isCustomerDoc = (type === 'Invoice' || type === 'Estimate');

  const tr = document.createElement('tr');
  tr.className = 'qbo-item-row';
  tr.style.borderBottom = '1px solid #f1f3f4';
  tr.style.verticalAlign = 'top';
  tr.innerHTML = `
    <td style="padding:8px; text-align:center; font-weight:800; color:#64748b" class="qbo-row-num">${count}</td>
    <td style="padding:8px">
      ${isCustomerDoc ? `
        <select class="qbo-prod-input" style="width:100%; border:1px solid #cbd5e1; border-radius:4px; padding:6px; font-weight:700; font-size:12px; background:#fff">
          <option value="Cabinets">Cabinets</option>
          <option value="Countertops & Stone Slabs">Countertops & Stone Slabs</option>
          <option value="Hardware & Accessories">Hardware & Accessories</option>
          <option value="Sinks & Plumbing">Sinks & Plumbing</option>
          <option value="Tile & Flooring">Tile & Flooring</option>
          <option value="Labor & Installation">Labor & Installation</option>
          <option value="Freight & Delivery">Freight & Delivery</option>
        </select>
      ` : `
        <input type="text" class="qbo-prod-input" placeholder="Vendor item..." style="width:100%; border:1px solid #cbd5e1; border-radius:4px; padding:6px; font-weight:700; font-size:12px">
      `}
    </td>
    <td style="padding:8px">
      <textarea class="qbo-desc-input" rows="3" placeholder="Paste item cutlist / cabinet codes..." style="width:100%; border:1px solid #cbd5e1; border-radius:4px; padding:6px; font-size:12px; font-family:sans-serif; resize:vertical"></textarea>
    </td>
    <td style="padding:8px">
      <input type="number" step="1" class="qbo-qty-input" value="1" oninput="calcQboTotals()" style="width:100%; border:1px solid #cbd5e1; border-radius:4px; padding:6px; text-align:right; font-weight:700; font-size:12px">
    </td>
    <td style="padding:8px">
      <input type="number" step="0.01" class="qbo-rate-input" value="0.00" oninput="calcQboTotals()" style="width:100%; border:1px solid #cbd5e1; border-radius:4px; padding:6px; text-align:right; font-weight:700; font-size:12px">
    </td>
    <td style="padding:8px; text-align:right; font-weight:800; color:#0f172a" class="qbo-amount-cell">
      $ 0.00
    </td>
    <td style="padding:8px; text-align:center">
      <input type="checkbox" class="qbo-tax-input" checked onchange="calcQboTotals()" style="width:15px; height:15px; cursor:pointer">
    </td>
    <td style="padding:8px; text-align:center">
      <button type="button" onclick="removeQboRow(this)" style="background:none; border:0; color:#ef4444; font-weight:800; cursor:pointer; font-size:14px" title="Delete row">🗑️</button>
    </td>
  `;
  tbody.appendChild(tr);
  calcQboTotals();
}

function removeQboRow(btn) {
  const row = btn.closest('tr');
  if (row) {
    row.remove();
    // re-number remaining rows
    const tbody = document.getElementById('qboItemsTbody');
    if (tbody) {
      tbody.querySelectorAll('.qbo-item-row').forEach((r, i) => {
        const numCell = r.querySelector('.qbo-row-num');
        if (numCell) numCell.textContent = i + 1;
      });
    }
    calcQboTotals();
  }
}

function calcQboTotals() {
  const rows = document.querySelectorAll('.qbo-item-row');
  let subtotal = 0;
  let taxableSubtotal = 0;
  rows.forEach(r => {
    const qty = parseFloat(r.querySelector('.qbo-qty-input')?.value || 0);
    const rate = parseFloat(r.querySelector('.qbo-rate-input')?.value || 0);
    const isTaxable = r.querySelector('.qbo-tax-input')?.checked || false;
    const amount = qty * rate;
    const cell = r.querySelector('.qbo-amount-cell');
    if (cell) cell.textContent = '$ ' + amount.toFixed(2);
    subtotal += amount;
    if (isTaxable) taxableSubtotal += amount;
  });

  const taxRateSelect = document.getElementById('qboTaxRateSelect');
  const taxRate = taxRateSelect ? parseFloat(taxRateSelect.value || 0) : 0.08375;
  const taxAmount = taxableSubtotal * taxRate;
  const shipping = parseFloat(document.getElementById('qboFormShipping')?.value || 0);
  const total = subtotal + taxAmount + shipping;
  const deposit = parseFloat(document.getElementById('qboFormDeposit')?.value || 0);
  const balanceDue = Math.max(0, total - deposit);

  // Update DOM displays
  if (document.getElementById('qboDisplaySubtotal')) document.getElementById('qboDisplaySubtotal').textContent = '$ ' + subtotal.toFixed(2);
  if (document.getElementById('qboDisplayTax')) document.getElementById('qboDisplayTax').textContent = '$ ' + taxAmount.toFixed(2);
  if (document.getElementById('qboDisplayTotal')) document.getElementById('qboDisplayTotal').textContent = '$ ' + total.toFixed(2);
  if (document.getElementById('qboDisplayBalanceDue')) document.getElementById('qboDisplayBalanceDue').textContent = '$ ' + balanceDue.toFixed(2);
  if (document.getElementById('qboLiveBalanceDue')) document.getElementById('qboLiveBalanceDue').textContent = '$ ' + balanceDue.toFixed(2);
}

function handleQboTransactionSave(event, type, docId) {
  event.preventDefault();
  const party = document.getElementById('qboFormParty')?.value || 'Customer';
  const newId = document.getElementById('qboFormDocId')?.value || docId;
  const terms = document.getElementById('qboFormTerms')?.value || 'Due on receipt';
  const date = document.getElementById('qboFormDate')?.value || new Date().toISOString().split('T')[0];
  const dueDate = document.getElementById('qboFormDueDate')?.value || date;
  const salesRep = document.getElementById('qboFormSalesRep')?.value || 'Edwin Portillo';
  const poNumber = document.getElementById('qboFormPoNum')?.value || '';
  const jobsite = document.getElementById('qboFormJobsite')?.value || '';

  // Extract items
  const rows = document.querySelectorAll('.qbo-item-row');
  const items = [];
  rows.forEach(r => {
    items.push({
      product: r.querySelector('.qbo-prod-input')?.value || 'Cabinets',
      desc: r.querySelector('.qbo-desc-input')?.value || '',
      qty: parseFloat(r.querySelector('.qbo-qty-input')?.value || 1),
      rate: parseFloat(r.querySelector('.qbo-rate-input')?.value || 0),
      amount: parseFloat(r.querySelector('.qbo-qty-input')?.value || 1) * parseFloat(r.querySelector('.qbo-rate-input')?.value || 0),
      tax: r.querySelector('.qbo-tax-input')?.checked || false
    });
  });

  const subtotal = parseFloat(document.getElementById('qboDisplaySubtotal')?.textContent.replace('$','').trim() || 0);
  const taxRate = parseFloat(document.getElementById('qboTaxRateSelect')?.value || 0.08375);
  const taxAmount = parseFloat(document.getElementById('qboDisplayTax')?.textContent.replace('$','').trim() || 0);
  const shipping = parseFloat(document.getElementById('qboFormShipping')?.value || 0);
  const total = parseFloat(document.getElementById('qboDisplayTotal')?.textContent.replace('$','').trim() || 0);
  const deposit = parseFloat(document.getElementById('qboFormDeposit')?.value || 0);
  const balanceDue = parseFloat(document.getElementById('qboDisplayBalanceDue')?.textContent.replace('$','').trim() || 0);
  const paymentInstructions = document.getElementById('qboFormPayInstructions')?.value || '';
  const customerNote = document.getElementById('qboFormCustomerNote')?.value || '';

  const store = getQboStore();

  if (type === 'Invoice') {
    const isPaid = balanceDue <= 0;
    const isPartial = deposit > 0 && balanceDue > 0;
    const status = isPaid ? 'Paid in Full' : (isPartial ? 'Partial (Deposit Paid)' : 'Unpaid');
    
    const record = {
      id: newId,
      customer: party,
      jobsite: jobsite,
      shipTo: party + '\n' + jobsite,
      date: date,
      dueDate: dueDate,
      terms: terms,
      salesRep: salesRep,
      poNumber: poNumber,
      items: items,
      subtotal: subtotal,
      taxRate: taxRate,
      taxAmount: taxAmount,
      shipping: shipping,
      total: total,
      deposit: deposit,
      balanceDue: balanceDue,
      status: status,
      paymentInstructions: paymentInstructions,
      customerNote: customerNote
    };

    const idx = store.invoices.findIndex(x => x.id === docId || x.id === newId);
    if (idx !== -1) store.invoices[idx] = record;
    else store.invoices.unshift(record);

    saveQboStore(store);
    closeModal();
    showToast(`✅ Invoice #${newId} saved successfully!`);
  } else if (type === 'Estimate') {
    const record = {
      id: newId,
      customer: party,
      jobsite: jobsite,
      shipTo: party + '\n' + jobsite,
      date: date,
      expirationDate: dueDate,
      terms: terms,
      salesRep: salesRep,
      poNumber: poNumber,
      items: items,
      subtotal: subtotal,
      taxRate: taxRate,
      taxAmount: taxAmount,
      shipping: shipping,
      total: total,
      status: 'Pending Approval'
    };

    const idx = store.estimates.findIndex(x => x.id === docId || x.id === newId);
    if (idx !== -1) store.estimates[idx] = record;
    else store.estimates.unshift(record);

    saveQboStore(store);
    closeModal();
    showToast(`✅ Estimate #${newId} saved!`);
  } else if (type === 'Purchase Order') {
    const record = {
      id: newId,
      vendor: party,
      jobsiteRef: jobsite,
      date: date,
      deliveryDate: dueDate,
      items: items,
      subtotal: subtotal,
      shipping: shipping,
      total: total,
      status: 'Issued to Vendor'
    };

    const idx = store.pos.findIndex(x => x.id === docId || x.id === newId);
    if (idx !== -1) store.pos[idx] = record;
    else store.pos.unshift(record);

    saveQboStore(store);
    closeModal();
    showToast(`✅ Vendor Purchase Order #${newId} saved!`);
  } else if (type === 'Bill') {
    const record = {
      id: newId,
      vendor: party,
      jobsiteRef: jobsite,
      date: date,
      dueDate: dueDate,
      items: items,
      subtotal: subtotal,
      total: total,
      status: 'Unpaid'
    };

    const idx = store.bills.findIndex(x => x.id === docId || x.id === newId);
    if (idx !== -1) store.bills[idx] = record;
    else store.bills.unshift(record);

    saveQboStore(store);
    closeModal();
    showToast(`✅ Vendor Bill #${newId} recorded!`);
  }
}

function handleQboProjectSave(event, projId) {
  event.preventDefault();
  const name = document.getElementById('qboProjName')?.value;
  const client = document.getElementById('qboProjClient')?.value;
  const address = document.getElementById('qboProjAddress')?.value;
  const pm = document.getElementById('qboProjPm')?.value;
  const contract = parseFloat(document.getElementById('qboProjContract')?.value || 0);

  const store = getQboStore();
  const record = {
    id: projId,
    name: name,
    client: client,
    address: address,
    pm: pm,
    contractValue: contract,
    invoiced: 0.00,
    expenses: 0.00,
    status: 'Active'
  };

  const idx = store.projects.findIndex(x => x.id === projId);
  if (idx !== -1) store.projects[idx] = record;
  else store.projects.unshift(record);

  saveQboStore(store);
  closeModal();
  showToast(`✅ Jobsite Project ${name} saved!`);
}

function renderAllQboTables() {
  renderQboInvoices();
  renderQboBills();
  renderQboProjects();
  if (typeof renderWarehouseFeed === 'function') renderWarehouseFeed();
}

function renderQboInvoices() {
  const tbody = document.getElementById('qboInvoicesTableBody');
  if (!tbody) return;
  const store = getQboStore();
  const invoices = store.invoices || [];
  if (invoices.length === 0) {
    tbody.innerHTML = `<tr><td colspan="9" style="text-align:center; padding:20px; color:#64748b">No invoices found. Click "+ New Invoice" above to create one.</td></tr>`;
    return;
  }
  tbody.innerHTML = invoices.map(inv => {
    const isPaid = inv.balanceDue <= 0;
    const isPartial = inv.deposit > 0 && inv.balanceDue > 0;
    const statusBg = isPaid ? '#dcfce7' : (isPartial ? '#e0f2fe' : '#fef3c7');
    const statusColor = isPaid ? '#166534' : (isPartial ? '#0369a1' : '#92400e');
    return `
      <tr style="border-bottom:1px solid #e2e8f0">
        <td style="padding:10px 12px; font-weight:800; color:#0b57d0">${esc(inv.id)}</td>
        <td style="padding:10px 12px; font-weight:700; color:#0f172a">${esc(inv.customer)}</td>
        <td style="padding:10px 12px; color:#475569; font-size:12px">${esc(inv.jobsite || 'N/A')}</td>
        <td style="padding:10px 12px; color:#64748b">${esc(inv.date)}</td>
        <td style="padding:10px 12px; color:#64748b">${esc(inv.dueDate)}</td>
        <td style="padding:10px 12px; text-align:right; font-weight:700">$ ${Number(inv.total).toFixed(2)}</td>
        <td style="padding:10px 12px; text-align:right; font-weight:800; color:${inv.balanceDue > 0 ? '#b91c1c' : '#166534'}">$ ${Number(inv.balanceDue).toFixed(2)}</td>
        <td style="padding:10px 12px; text-align:center">
          <span style="background:${statusBg}; color:${statusColor}; padding:3px 8px; border-radius:12px; font-weight:800; font-size:11px">
            ${esc(inv.status)}
          </span>
        </td>
        <td style="padding:10px 12px; text-align:center">
          <button onclick="openQboTransactionModal('Invoice', '${esc(inv.id)}')" style="background:#0b57d0; color:#fff; border:0; padding:4px 10px; border-radius:4px; font-size:11.5px; font-weight:700; cursor:pointer">
            ✏️ View / Edit
          </button>
        </td>
      </tr>
    `;
  }).join('');
}

function renderQboBills() {
  const tbody = document.getElementById('qboBillsTableBody');
  if (!tbody) return;
  const store = getQboStore();
  const bills = store.bills || [];
  if (bills.length === 0) {
    tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; padding:20px; color:#64748b">No vendor bills recorded. Click "+ Record Vendor Bill" to log supplier invoices.</td></tr>`;
    return;
  }
  tbody.innerHTML = bills.map(b => {
    return `
      <tr style="border-bottom:1px solid #e2e8f0">
        <td style="padding:10px 12px; font-weight:800; color:#059669">${esc(b.id)}</td>
        <td style="padding:10px 12px; font-weight:700; color:#0f172a">${esc(b.vendor)}</td>
        <td style="padding:10px 12px; color:#475569; font-size:12px">${esc(b.jobsiteRef || 'General Inventory')}</td>
        <td style="padding:10px 12px; color:#64748b">${esc(b.date)}</td>
        <td style="padding:10px 12px; text-align:right; font-weight:700">$ ${Number(b.total).toFixed(2)}</td>
        <td style="padding:10px 12px; text-align:center">
          <span style="background:#fef3c7; color:#92400e; padding:3px 8px; border-radius:12px; font-weight:800; font-size:11px">${esc(b.status || 'Unpaid')}</span>
        </td>
        <td style="padding:10px 12px; text-align:center">
          <button onclick="openQboTransactionModal('Bill', '${esc(b.id)}')" style="background:#059669; color:#fff; border:0; padding:4px 10px; border-radius:4px; font-size:11.5px; font-weight:700; cursor:pointer">✏️ View Bill</button>
        </td>
      </tr>
    `;
  }).join('');
}

function renderQboProjects() {
  const tbody = document.getElementById('qboProjectsTableBody');
  if (!tbody) return;
  const store = getQboStore();
  const projects = store.projects || [];
  if (projects.length === 0) {
    tbody.innerHTML = `<tr><td colspan="8" style="text-align:center; padding:20px; color:#64748b">No jobsite projects recorded yet. Click "+ New Jobsite Project" above to start.</td></tr>`;
    return;
  }
  tbody.innerHTML = projects.map(p => {
    return `
      <tr style="border-bottom:1px solid #e2e8f0">
        <td style="padding:10px; font-weight:800; color:#0b57d0">${esc(p.id)}</td>
        <td style="padding:10px; font-weight:700; color:#0f172a">
          <div>${esc(p.name)}</div>
          <div style="font-size:11.5px; color:#64748b; font-weight:400">PM: ${esc(p.pm)}</div>
        </td>
        <td style="padding:10px; text-align:right; font-weight:700">$ ${Number(p.contractValue).toFixed(2)}</td>
        <td style="padding:10px; text-align:right; font-weight:700; color:#059669">$ ${Number(p.invoiced).toFixed(2)}</td>
        <td style="padding:10px; text-align:right; font-weight:700; color:#b91c1c">$ ${Number(p.expenses).toFixed(2)}</td>
        <td style="padding:10px; text-align:center">
          <span style="background:#dcfce7; color:#166534; padding:3px 8px; border-radius:12px; font-weight:800; font-size:11px">${esc(p.status)}</span>
        </td>
        <td style="padding:10px; text-align:center">
          <button onclick="openQboTransactionModal('Project', '${esc(p.id)}')" style="background:#0f172a; color:#fff; border:0; padding:4px 10px; border-radius:4px; font-size:11.5px; font-weight:700; cursor:pointer">✏️ Manage</button>
        </td>
      </tr>
    `;
  }).join('');
}

