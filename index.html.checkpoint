  <div class="hero" style="background:linear-gradient(135deg, #061a33 0%, #133763 100%);color:#fff;border-radius:14px;padding:26px 30px;margin-bottom:20px;border:1px solid #1c4b82">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px">
      <span class="badge" style="background:#e5b85f;color:#061a33;font-weight:bold">Cabella Employee Academy</span>
      <span class="badge" style="background:rgba(255,255,255,0.2);color:#fff">Interactive Flowing Handbook</span>
    </div>
    <h1 style="color:#fff;margin:0 0 8px;font-size:28px">🎓 Employee Onboarding, Workflow & Story</h1>
    <p style="color:#b3c8e2;margin:0;font-size:15px;max-width:820px;line-height:1.5">
      Welcome to Cabella Cabinets Stone & Flooring. This single flowing academy consolidates who we are, your first-week onboarding roadmap, our complete 9-step project workflow, and essential operating policies.
    </p>
  </div>

  <div class="onboarding-subtabs">
