  function renderPlHomeCoStone(q) {
    const body = document.getElementById('plHcStoneTableBody');
    if (!body) return;
    const query = (q || (document.getElementById('hcStoneSearch') ? document.getElementById('hcStoneSearch').value : '')).trim().toLowerCase();
    const data = (typeof STONE_COMPARISON_DATA !== 'undefined') ? STONE_COMPARISON_DATA : [];
