      🏢 1. Who We Are & Story
    </button>
    <button id="obTabBtn-roadmap" class="ob-tab-btn" onclick="switchOnboardingTab('roadmap')">
      🚀 2. Day 1 & First Week Roadmap
    </button>
    <button id="obTabBtn-workflow" class="ob-tab-btn" onclick="switchOnboardingTab('workflow')">
