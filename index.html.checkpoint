function getInventoryStore() {
  const data = localStorage.getItem('cabella_inventory_store_v1');
  if (data) {
    try {
      return JSON.parse(data);
    } catch(e) {}
  }
  const init = {
    items: DEFAULT_INVENTORY_ITEMS,
    auditLog: DEFAULT_INVENTORY_AUDIT_LOG,
    activeRole: 'purchasing'
  };
  saveInventoryStore(init);
  return init;
}

function saveInventoryStore(store) {
  localStorage.setItem('cabella_inventory_store_v1', JSON.stringify(store));
}

let activeInventorySubtab = 'stock';
let activeInventoryRole = 'purchasing';

function switchInventoryRoleView(role) {
  activeInventoryRole = role;
  const store = getInventoryStore();
  store.activeRole = role;
  saveInventoryStore(store);
  renderInventoryView();
}

function switchInventorySubtab(tabId) {
  activeInventorySubtab = tabId;
  const subtabs = ['stock', 'depletion', 'invoices', 'history'];
  subtabs.forEach(t => {
    const btn = document.getElementById('invSubtabBtn-' + t);
    const content = document.getElementById('invSubtabContent-' + t);
    if (btn) {
      if (t === tabId) {
        btn.className = 'btn';
        btn.style.background = '#0284c7';
        btn.style.color = '#fff';
        btn.style.border = '0';
      } else {
        btn.className = 'btn secondary';
        btn.style.background = '#fff';
        btn.style.color = '#0f172a';
        btn.style.border = '1px solid #cbd5e1';
      }
    }
    if (content) {
      content.style.display = (t === tabId) ? 'block' : 'none';
    }
  });
  renderInventoryView();
}

function renderInventoryView() {
  renderInventoryKpis();
  renderInventoryStockTable();
  renderInventoryDepletionCards();
  renderInventoryInvoicesTable();
  renderInventoryAuditLog();
  updateHomeCommandCenterDepletion();
}

function renderInventoryKpis() {
  const kpiContainer = document.getElementById('invKpiMetricsGrid');
  if (!kpiContainer) return;
  const store = getInventoryStore();
  const items = store.items || [];
  const role = activeInventoryRole;

  let totalSkus = items.length;
  let totalUnits = items.reduce((sum, i) => sum + (Number(i.onHand) || 0), 0);
  let totalValue = items.reduce((sum, i) => sum + ((Number(i.onHand) || 0) * (Number(i.unitCost) || 0)), 0);
  
  // Calculate critical items (< 7 days of stock)
  let criticalItems = items.filter(i => {
    const dailyVel = (Number(i.salesVelocity3Day) || 0) / 3;
    const avail = (Number(i.onHand) || 0) - (Number(i.reserved) || 0);
    if (dailyVel > 0) {
      const days = avail / dailyVel;
      return days <= 7;
    }
    return false;
  });

  if (role === 'sales') {
    kpiContainer.innerHTML = `
      <div style="background:#f0fdf4; border:1px solid #bbf7d0; border-radius:10px; padding:14px 16px">
        <div style="font-size:11px; font-weight:800; color:#166534; text-transform:uppercase">Catalog Items</div>
        <div style="font-size:24px; font-weight:900; color:#064e3b; margin-top:4px">${totalSkus} Active SKUs</div>
        <div style="font-size:11.5px; color:#15803d; margin-top:2px">Cabinets, Slabs & Flooring</div>
      </div>
      <div style="background:#f0f9ff; border:1px solid #bae6fd; border-radius:10px; padding:14px 16px">
        <div style="font-size:11px; font-weight:800; color:#0369a1; text-transform:uppercase">Physical Stock Available</div>
        <div style="font-size:24px; font-weight:900; color:#0c4a6e; margin-top:4px">${totalUnits} Units in Bins</div>
        <div style="font-size:11.5px; color:#0284c7; margin-top:2px">Ready for Will-Call or Delivery</div>
      </div>
      <div style="background:#fefce8; border:1px solid #fef08a; border-radius:10px; padding:14px 16px">
        <div style="font-size:11px; font-weight:800; color:#854d0e; text-transform:uppercase">High Demand Alert</div>
        <div style="font-size:24px; font-weight:900; color:#713f12; margin-top:4px">${criticalItems.length} Fast Selling SKUs</div>
        <div style="font-size:11.5px; color:#a16207; margin-top:2px">Check with purchasing for bulk jobs</div>
      </div>
    `;
  } else {
    // Purchasing & CFO View
    kpiContainer.innerHTML = `
      <div style="background:#0f172a; color:#fff; border-radius:10px; padding:14px 16px">
        <div style="font-size:11px; font-weight:800; color:#94a3b8; text-transform:uppercase">Total Inventory Value</div>
        <div style="font-size:24px; font-weight:900; color:#38bdf8; margin-top:4px">$${totalValue.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2})}</div>
        <div style="font-size:11.5px; color:#cbd5e1; margin-top:2px">${totalUnits} Physical Units across ${totalSkus} SKUs</div>
      </div>
      <div style="background:#fef2f2; border:1px solid #fecaca; border-radius:10px; padding:14px 16px">
        <div style="font-size:11px; font-weight:800; color:#991b1b; text-transform:uppercase">Critical Reorder Alert</div>
        <div style="font-size:24px; font-weight:900; color:#7f1d1d; margin-top:4px">${criticalItems.length} SKUs < 7 Days Left</div>
        <div style="font-size:11.5px; color:#b91c1c; margin-top:2px">B12 Shaker (~5.1 Days), BLS36 (~4 Days)</div>
      </div>
      <div style="background:#f0fdf4; border:1px solid #bbf7d0; border-radius:10px; padding:14px 16px">
        <div style="font-size:11px; font-weight:800; color:#166534; text-transform:uppercase">B12 Burn Rate (Example)</div>
        <div style="font-size:24px; font-weight:900; color:#064e3b; margin-top:4px">3.3 Cabinets / Day</div>
        <div style="font-size:11.5px; color:#15803d; margin-top:2px">10 sold in 3 days · 17 in stock</div>
      </div>
      <div style="background:#f0f9ff; border:1px solid #bae6fd; border-radius:10px; padding:14px 16px">
        <div style="font-size:11px; font-weight:800; color:#0369a1; text-transform:uppercase">Inbound Logistics</div>
        <div style="font-size:24px; font-weight:900; color:#0c4a6e; margin-top:4px">2 Arriving Trucks</div>
        <div style="font-size:11.5px; color:#0284c7; margin-top:2px">Grandwood (1042) & Achilles Slabs</div>
      </div>
    `;
  }
}

function renderInventoryStockTable() {
  const tbody = document.getElementById('invStockTableBody');
  if (!tbody) return;
  const store = getInventoryStore();
  const items = store.items || [];
  const role = activeInventoryRole;

  const search = (document.getElementById('invStockSearchInput')?.value || '').toLowerCase().trim();
  const catFilter = document.getElementById('invCategoryFilter')?.value || '';
  const locFilter = document.getElementById('invLocationFilter')?.value || '';

  // Hide or show columns depending on role permissions
  const thCost = document.getElementById('invThWholesaleCost');
  const thVelocity = document.getElementById('invThDepletionRate');
  const thDays = document.getElementById('invThDaysLeft');
  if (thCost) thCost.style.display = (role === 'sales') ? 'none' : 'table-cell';
  if (thVelocity) thVelocity.style.display = (role === 'sales') ? 'none' : 'table-cell';
  if (thDays) thDays.style.display = (role === 'sales') ? 'none' : 'table-cell';

  const filtered = items.filter(item => {
    const matchSearch = !search || 
      item.sku.toLowerCase().includes(search) || 
      item.name.toLowerCase().includes(search) || 
      item.location.toLowerCase().includes(search) ||
      item.style.toLowerCase().includes(search);
    const matchCat = !catFilter || item.category === catFilter;
    const matchLoc = !locFilter || item.aisle === locFilter;
    return matchSearch && matchCat && matchLoc;
  });

  if (filtered.length === 0) {
    tbody.innerHTML = `<tr><td colspan="10" style="text-align:center; padding:24px; color:#64748b">No inventory items matched your search filters.</td></tr>`;
    return;
  }

  tbody.innerHTML = filtered.map(item => {
    const avail = (Number(item.onHand) || 0) - (Number(item.reserved) || 0);
    const dailyVel = (Number(item.salesVelocity3Day) || 0) / 3;
    const daysLeft = dailyVel > 0 ? (avail / dailyVel).toFixed(1) : '∞';
    
    let daysBadge = '';
    if (dailyVel > 0) {
      if (Number(daysLeft) <= 5.5) {
        daysBadge = `<span style="background:#fee2e2; color:#991b1b; font-weight:800; padding:2px 8px; border-radius:4px; border:1px solid #fecaca">🔴 ${daysLeft} Days</span>`;
      } else if (Number(daysLeft) <= 10) {
        daysBadge = `<span style="background:#fefce8; color:#854d0e; font-weight:800; padding:2px 8px; border-radius:4px; border:1px solid #fef08a">🟡 ${daysLeft} Days</span>`;
      } else {
        daysBadge = `<span style="background:#f0fdf4; color:#166534; font-weight:800; padding:2px 8px; border-radius:4px; border:1px solid #bbf7d0">🟢 ${daysLeft} Days</span>`;
      }
    } else {
      daysBadge = `<span style="background:#f1f5f9; color:#475569; font-weight:700; padding:2px 6px; border-radius:4px">Stable</span>`;
    }

    const costCell = (role === 'sales') ? '' : `<td style="padding:10px 12px; text-align:right; font-weight:700; color:#0f172a">$${Number(item.unitCost).toFixed(2)}</td>`;
    const velCell = (role === 'sales') ? '' : `<td style="padding:10px 12px; text-align:center; font-weight:700; color:#475569">${dailyVel.toFixed(1)} / day <span style="font-size:10.5px; color:#64748b">(${item.salesVelocity3Day} in 3d)</span></td>`;
    const daysCell = (role === 'sales') ? '' : `<td style="padding:10px 12px; text-align:center">${daysBadge}</td>`;

    return `
      <tr style="border-bottom:1px solid #e2e8f0; transition:background 0.15s" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='transparent'">
        <td style="padding:10px 12px">
          <div style="font-weight:800; color:#0284c7; font-size:14px">${esc(item.sku)}</div>
          <div style="font-size:12px; color:#334155; font-weight:600">${esc(item.name)}</div>
        </td>
        <td style="padding:10px 12px">
          <span style="font-size:11px; font-weight:800; background:#f1f5f9; color:#334155; padding:2px 6px; border-radius:4px">${esc(item.category)}</span>
          <div style="font-size:11px; color:#64748b; margin-top:2px">${esc(item.style)}</div>
        </td>
        <td style="padding:10px 12px">
          <div style="display:inline-flex; align-items:center; gap:6px; background:#eff6ff; border:1px solid #bfdbfe; padding:3px 8px; border-radius:6px; font-weight:800; color:#1e40af; font-size:12px">
            <span>📍</span> <span>${esc(item.location)}</span>
          </div>
          <div style="font-size:10.5px; color:#64748b; margin-top:2px">${esc(item.aisle)} · ${esc(item.rack)} · ${esc(item.bin)}</div>
        </td>
        <td style="padding:10px 12px; text-align:center; font-weight:900; font-size:14px; color:#0f172a">
          ${item.onHand} <span style="font-size:11px; font-weight:normal; color:#64748b">${item.unit}</span>
        </td>
        <td style="padding:10px 12px; text-align:center; font-weight:700; color:#c2410c">
          ${item.reserved > 0 ? item.reserved : '0'}
        </td>
        <td style="padding:10px 12px; text-align:center; font-weight:900; font-size:14.5px; color:${avail <= item.reorderPoint ? '#b91c1c' : '#166534'}">
          ${avail}
        </td>
        ${costCell}
        ${velCell}
        ${daysCell}
        <td style="padding:10px 12px; text-align:center">
          <div style="display:flex; gap:6px; justify-content:center">
            <button class="btn" style="background:#0f172a; color:#fff; font-size:11px; font-weight:700; padding:4px 8px; border-radius:6px" onclick="openItemDetailModal('${item.id}')" title="Adjust stock, view details or move bin">
              ⚙️ Manage
            </button>
            <button class="btn secondary" style="font-size:11px; font-weight:700; padding:4px 8px; border-radius:6px" onclick="printSingleQrLabel('${item.id}')" title="Print Bin QR Code">
              🖨️ QR
            </button>
          </div>
        </td>
      </tr>
    `;
  }).join('');
}

function renderInventoryDepletionCards() {
  const container = document.getElementById('invDepletionCardsGrid');
  if (!container) return;
  const store = getInventoryStore();
  const items = store.items || [];

  container.innerHTML = items.map(item => {
    const avail = (Number(item.onHand) || 0) - (Number(item.reserved) || 0);
    const dailyVel = (Number(item.salesVelocity3Day) || 0) / 3;
    const daysLeft = dailyVel > 0 ? (avail / dailyVel).toFixed(1) : '99';
    const isCritical = Number(daysLeft) <= 6;
    const isWarning = Number(daysLeft) > 6 && Number(daysLeft) <= 12;

    const borderColor = isCritical ? '#ef4444' : (isWarning ? '#f59e0b' : '#10b981');
    const badgeColor = isCritical ? '#fee2e2' : (isWarning ? '#fefce8' : '#f0fdf4');
    const badgeText = isCritical ? '#991b1b' : (isWarning ? '#854d0e' : '#166534');
    const badgeLabel = isCritical ? '🔴 REORDER CRITICAL' : (isWarning ? '🟡 MONITOR VELOCITY' : '🟢 HEALTHY STOCK');

    const recommendedOrderQty = Math.max(0, item.targetStock - avail);

    return `
      <div style="background:#ffffff; border:1px solid #cbd5e1; border-top:4px solid ${borderColor}; border-radius:12px; padding:16px 18px; box-shadow:0 2px 6px rgba(0,0,0,0.03); display:flex; flex-direction:column; justify-content:space-between">
        <div>
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px">
            <span style="font-size:10px; font-weight:800; background:${badgeColor}; color:${badgeText}; padding:2px 6px; border-radius:4px">${badgeLabel}</span>
            <span style="font-size:11px; font-weight:700; color:#64748b">📍 ${esc(item.location)}</span>
          </div>

          <div style="font-size:16px; font-weight:900; color:#0f172a">${esc(item.sku)} — ${esc(item.name)}</div>
          <div style="font-size:12px; color:#475569; margin:3px 0 10px">${esc(item.style)} · Vendor: <strong>${esc(item.vendor)}</strong></div>

          <!-- Dynamic Velocity Breakdown (Gil's B12 Formula) -->
          <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:10px 12px; font-size:12.5px; margin-bottom:12px">
            <div style="display:flex; justify-content:space-between; margin-bottom:4px">
              <span style="color:#64748b">Current Stock Available:</span>
              <strong style="color:#0f172a">${avail} ${item.unit}</strong>
            </div>
            <div style="display:flex; justify-content:space-between; margin-bottom:4px">
              <span style="color:#64748b">3-Day Sales Consumption:</span>
              <strong style="color:#c2410c">${item.salesVelocity3Day} units (${dailyVel.toFixed(1)} / day)</strong>
            </div>
            <div style="display:flex; justify-content:space-between; border-top:1px dashed #cbd5e1; padding-top:4px; margin-top:4px">
              <span style="font-weight:800; color:#0f172a">Run-Out Prediction:</span>
              <strong style="color:${isCritical ? '#b91c1c' : '#166534'}; font-size:13px">${dailyVel > 0 ? '~' + daysLeft + ' Days of Stock Left' : 'Stable'}</strong>
            </div>
          </div>
        </div>

        <div style="display:flex; justify-content:space-between; align-items:center; padding-top:10px; border-top:1px solid #f1f5f9">
          <span style="font-size:11px; color:#64748b">Reorder Target: <strong>${recommendedOrderQty} units</strong></span>
          <button class="btn" style="background:#0284c7; color:#fff; font-size:11.5px; font-weight:800; padding:6px 12px; border-radius:6px; border:0; cursor:pointer" onclick="openSingleReorderPoModal('${item.id}', ${recommendedOrderQty})">
            ⚡ Quick Reorder PO
          </button>
        </div>
      </div>
    `;
  }).join('');
}

function renderInventoryInvoicesTable() {
  const tbody = document.getElementById('invInvoicesTableBody');
  if (!tbody) return;
  const qboStore = (typeof getQboStore === 'function') ? getQboStore() : { invoices: [] };
  const invoices = qboStore.invoices || [];

  if (invoices.length === 0) {
    tbody.innerHTML = `<tr><td colspan="8" style="text-align:center; padding:20px; color:#64748b">No invoices found in QuickBooks. Create an invoice to test stock deductions.</td></tr>`;
    return;
  }

  tbody.innerHTML = invoices.map(inv => {
    const isDeducted = inv.stockDeducted === true;
    const isPaid = inv.balanceDue <= 0;

    return `
      <tr style="border-bottom:1px solid #e2e8f0">
        <td style="padding:10px 12px; font-weight:800; color:#0284c7">#${esc(inv.id)}</td>
        <td style="padding:10px 12px">
          <div style="font-weight:700; color:#0f172a">${esc(inv.customer)}</div>
          <div style="font-size:11.5px; color:#64748b">${esc(inv.jobsite || 'N/A')}</div>
        </td>
        <td style="padding:10px 12px; font-size:12px; color:#475569">${esc(inv.date)}</td>
        <td style="padding:10px 12px; font-weight:800; color:#0f172a">$${Number(inv.total).toFixed(2)}</td>
        <td style="padding:10px 12px">
          <span style="font-size:10.5px; font-weight:800; background:${isPaid ? '#dcfce7' : '#fef3c7'}; color:${isPaid ? '#166534' : '#92400e'}; padding:2px 6px; border-radius:4px">
            ${isPaid ? 'Paid in Full' : 'Deposit / Pending'}
          </span>
        </td>
        <td style="padding:10px 12px; font-size:12px; color:#334155">
          ${inv.items ? inv.items.map(it => `<div>• ${it.qty || 1}x ${esc(it.product || it.desc || 'Materials')}</div>`).join('') : 'Standard Project Package'}
        </td>
        <td style="padding:10px 12px; text-align:center">
          <span style="font-size:11px; font-weight:800; background:${isDeducted ? '#dcfce7' : '#fee2e2'}; color:${isDeducted ? '#166534' : '#991b1b'}; padding:3px 8px; border-radius:6px; border:1px solid ${isDeducted ? '#bbf7d0' : '#fecaca'}">
            ${isDeducted ? '✅ Stock Deducted from Bins' : '⏳ Pending Warehouse Deduction'}
          </span>
        </td>
        <td style="padding:10px 12px; text-align:center">
          ${isDeducted ? `
            <button class="btn secondary" style="font-size:11px; padding:4px 8px; border-radius:6px" onclick="revertInvoiceStockDeduction('${inv.id}')" title="Restock items back into warehouse bins">
              ↩️ Revert Stock
            </button>
          ` : `
            <button class="btn" style="background:#166534; color:#fff; font-size:11px; font-weight:800; padding:6px 12px; border-radius:6px; border:0; cursor:pointer; box-shadow:0 2px 5px rgba(22,101,52,0.25)" onclick="execute1ClickInvoiceStockDeduct('${inv.id}')">
              ⚡ Deduct Stock Now
            </button>
          `}
        </td>
      </tr>
    `;
  }).join('');
}

function renderInventoryAuditLog() {
  const tbody = document.getElementById('invAuditLogTableBody');
  if (!tbody) return;
  const store = getInventoryStore();
  const logs = store.auditLog || [];

  if (logs.length === 0) {
    tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; padding:20px; color:#64748b">No movements logged yet.</td></tr>`;
    return;
  }

  tbody.innerHTML = logs.map(l => {
    const isPositive = String(l.qtyChange).startsWith('+');
    return `
      <tr style="border-bottom:1px solid #e2e8f0; font-size:12.5px">
        <td style="padding:8px 12px; color:#64748b">${esc(l.timestamp)}</td>
        <td style="padding:8px 12px; font-weight:700; color:#0f172a">${esc(l.type)}</td>
        <td style="padding:8px 12px; font-weight:800; color:#0284c7">${esc(l.sku)}</td>
        <td style="padding:8px 12px; color:#334155">${esc(l.location)}</td>
        <td style="padding:8px 12px; text-align:center; font-weight:800; color:${isPositive ? '#166534' : '#b91c1c'}">${esc(l.qtyChange)}</td>
        <td style="padding:8px 12px; color:#475569">${esc(l.user)}</td>
        <td style="padding:8px 12px; font-size:11.5px; color:#64748b">${esc(l.ref)}</td>
      </tr>
    `;
  }).join('');
}

function updateHomeCommandCenterDepletion() {
  const leadEl = document.getElementById('homeDepletionLeadKpi');
  if (!leadEl) return;
  const store = getInventoryStore();
  const items = store.items || [];
  const b12 = items.find(i => i.sku === 'B12');
  if (b12) {
    const avail = b12.onHand - b12.reserved;
    const dailyVel = (b12.salesVelocity3Day || 10) / 3;
    const daysLeft = (avail / dailyVel).toFixed(1);
    leadEl.textContent = `B12: ~${daysLeft} Days Left`;
  }
}

// 1-Click Invoice Deductor Function
function execute1ClickInvoiceStockDeduct(invoiceId) {
  const qboStore = (typeof getQboStore === 'function') ? getQboStore() : null;
  if (!qboStore) return;
  const inv = qboStore.invoices.find(x => x.id === invoiceId);
  if (!inv) return;

  const invStore = getInventoryStore();
  const items = invStore.items;

  // Simulate deducting matching items
  // Default: Deduct 2 B12, 1 B18, 1 B36, 1 Sink, or items in invoice
  let deductedSummary = [];
  const uName = (typeof currentActiveUser !== 'undefined' && currentActiveUser.name) ? currentActiveUser.name : 'Gil Sirimarco';

  // Apply deduction to B12 & B18 as standard package if items not mapped exactly
  items.forEach(it => {
    if (it.sku === 'B12' && it.onHand >= 2) {
      it.onHand -= 2;
      it.salesVelocity3Day += 2;
      deductedSummary.push('2x B12 (Rack A-02)');
      invStore.auditLog.unshift({
        id: 'LOG-' + Math.floor(Math.random()*9000 + 1000),
        timestamp: new Date().toLocaleString(),
        type: 'Invoice Deduction',
        sku: 'B12',
        location: it.location,
        qtyChange: '-2',
        user: uName,
        ref: 'Invoice #' + inv.id + ' (' + (inv.customer || 'Client') + ')'
      });
    } else if (it.sku === 'B18' && it.onHand >= 1) {
      it.onHand -= 1;
      it.salesVelocity3Day += 1;
      deductedSummary.push('1x B18 (Rack A-02)');
      invStore.auditLog.unshift({
        id: 'LOG-' + Math.floor(Math.random()*9000 + 1000),
        timestamp: new Date().toLocaleString(),
        type: 'Invoice Deduction',
        sku: 'B18',
        location: it.location,
        qtyChange: '-1',
        user: uName,
        ref: 'Invoice #' + inv.id + ' (' + (inv.customer || 'Client') + ')'
      });
    }
  });

  inv.stockDeducted = true;
  saveQboStore(qboStore);
  saveInventoryStore(invStore);

  showToast('✅ Invoice #' + inv.id + ' Stock Deducted! Updated: ' + deductedSummary.join(', '));
  renderInventoryView();
}

function revertInvoiceStockDeduction(invoiceId) {
  const qboStore = (typeof getQboStore === 'function') ? getQboStore() : null;
  if (!qboStore) return;
  const inv = qboStore.invoices.find(x => x.id === invoiceId);
  if (!inv) return;

  const invStore = getInventoryStore();
  const items = invStore.items;

  items.forEach(it => {
    if (it.sku === 'B12') {
      it.onHand += 2;
      it.salesVelocity3Day = Math.max(0, it.salesVelocity3Day - 2);
    } else if (it.sku === 'B18') {
      it.onHand += 1;
      it.salesVelocity3Day = Math.max(0, it.salesVelocity3Day - 1);
    }
  });

  inv.stockDeducted = false;
  saveQboStore(qboStore);
  saveInventoryStore(invStore);

  showToast('↩️ Stock Restocked back into Warehouse Bins for Invoice #' + inv.id);
  renderInventoryView();
}

