aphael.com, info@caraphael.com","address":"3111 S Valley View Blvd Suite C-105, Las Vegas, NV 89102","openBalance":350,"display":"Raphael Stone Collection (LV & CA)","category":["Prefabricated stone","Stone supplier"],"products":["Prefabricated quartz countertops","Quartz slabs","Porcelain slabs","Calacatta Gold & Royal Quartz","Statuario Quartz"],"payment":"Check payable to Raphael Stone LV or Zelle to info@caraphael.com (Account Name: California-Quartz). Online invoice links sent to Gmail (Password Protected).","contact":"David (Shalom) & Tanya Billing","website":"https://www.raphaelstoneusa.com/","notes":["Las Vegas Valley View Showroom & Warehouse: 3111 S Valley View Blvd #C-105.","Contacts: David (Shalom) & Tanya Billing.","💳 Zelle Payment Info: Send to info@caraphael.com (Registered Name: California-Quartz).","📄 Online Invoices: Raphael Stone sends password-protected online invoices via lms.raphaelstoneusa.com."]},{"name":"RD Woodworking Hardware","company":"RD Woodworking Hardware","phone":"951-729-5870","email":"rdwh951@gmail.com","address":"6674 Van Buren Boulevard, Riverside, CA 92503","openBalance":0,"display":"RD Woodworking Hardware","category":["Hardware"],"products":["Hinges","Drawer Slides","Pulls & Handles","Woodworking Hardware"],"payment":"Payment upon invoice / Cabella account terms.","contact":"Federico Diaz","website":"https://rdwoodworkinghardware.com/","notes":["Riverside hardware distributor."]},{"name":"RingCentral","company":"RingCentral","phone":"(800) 574-5290","email":"support@ringcentral.com","address":"20 Davis Drive, Belmont, CA 94002","openBalance":0,"display":"RingCentral","category":["Telecommunications"],"products":["VoIP Phone System","SMS Dispatch","Staff Extensions"],"payment":"Monthly subscription via Cabella credit card.","contact":"Support & Direct Line","website":"https://app.ringcentral.com/","notes":["Company VoIP & staff extension communications portal."]},{"name":"Royal Playwood","company":"Royal Plywood","phone":"(702) 260-9979","email":"ian@royalplywood.com","address":"6650 Spencer St, Las Vegas, NV 89119","openBalance":0,"display":"Royal Plywood","category":["Plywood & Sheet Goods"],"products":["Hardwood Plywood","Cabinet Grade Plywood","MDF & Melamine"],"payment":"Payment upon invoice / Cabella account terms.","contact":"Ian","website":"https://royalplywood.com/","notes":["Las Vegas Spencer St warehouse for plywood and sheet materials."]},{"name":"Sandi Cabinet","company":"Sandi Cabinet","phone":"(909) 590-8844","email":"charles@sandicabinet.com, cs3@sandicabinet.com","address":"14368 Central Ave, Chino, CA 91710","openBalance":608.18,"display":"Sandi Cabinet","category":["Cabinets"],"products":["RTA Cabinets","Kitchen Cabinets","Bathroom Vanities"],"payment":"Payment upon invoice / Cabella account terms.","contact":"Charles","website":"https://sandicabinet.com/","notes":["Chino CA cabinet supplier."]},{"name":"T & L Granite","company":"T & L Granite","phone":"(626) 454-3178","email":"info@tlgranite.com","address":"10775 Lower Azusa Rd, El Monte, CA 91731","openBalance":0,"display":"T & L Granite","category":["Granite & Stone"],"products":["Prefabricated Granite","Quartz Countertops","Stone Slabs"],"payment":"Payment upon invoice / Cabella account terms.","contact":"Sales & Sourcing Desk","website":"http://www.tlgranite.com/","notes":["El Monte granite & quartz supplier."]},{"name":"TOP KING CABINETS","company":"TOP KING CABINETS","phone":"(562) 229-1128","email":"topkingcabinets@gmail.com, celine.topking@gmail.com","address":"15303 Marquardt Ave, Santa Fe Springs, CA 90670","openBalance":199.21,"display":"TOP KING CABINETS","category":["Cabinets","Prefabricated Stone","Flooring"],"products":["RTA Cabinets","Kitchen Cabinets","Bath Vanities","Accessories","Countertop Slabs","LVP Flooring"],"payment":"Payment upon invoice / Cabella account terms.","contact":"Celine","website":"https://topkingcabinets.com/","notes":["Contact: Celine (Email: celine.topking@gmail.com | Phone: 562-229-1128)","Santa Fe Springs supplier for cabinets, stone and flooring."]}],"people":[{"name":"Edwin Portillo","role":"Chief Executive Officer","email":"edwin@cabellacollections.com","phone":"(702) 679-2070","extension":"103","system":"RingCentral"},{"name":"Gil Sirimarco","role":"Chief Financial Officer","email":"gil@cabellacollections.com","phone":"(702) 679-2715","extension":"101","system":"RingCentral"},{"name":"Jerry Maza","role":"Head Project Manager","email":"jerry@cabellacollections.com","phone":"(702) 679-2239","extension":"104","system":"RingCentral"},{"name":"Mayra Rodriguez","role":"Orders Coordinator","email":"orders@cabellacollections.com","phone":"Main line: (702) 879-2549","extension":"106","system":"RingCentral"},{"name":"Chuy","role":"Warehouse Manager","email":"inbox@cabellacollections.com","phone":"Main line: (702) 879-2549","extension":"","system":"Company"},{"name":"Margie Caro","role":"Project Manager & Sales","email":"pm@cabellacollections.com","phone":"(725) 255-2835","extension":"107","system":"RingCentral"}],"articles":[{"id":"CSE-001","title":"Who We Are","type":"Company","summary":"Cabella is a wholesale material supplier serving contractors, builders, investors, property managers, and developers.","body":"Cabella Cabinets Stone & Flooring supplies ready-to-assemble (RTA) cabinets, prefabricated stone countertops, flooring, sinks, hardware, and related materials. Cabella is not a retail store for walk-in homeowners and does not provide installation services. The showroom is a resource for professional customers to bring homeowners for material selections."},{"id":"CSE-005","title":"How to Use CSE","type":"Onboarding","summary":"Search CSE first.","body":"Type a full question or a few keywords. If the answer is not found, try a different keyword. If it still is not found, ask your direct supervisor. Once the correct answer is confirmed, add or update the CSE so the next employee can find it."},{"id":"CSE-100","title":"Cabella Project Workflow","type":"Workflow","summary":"The standard process from project assignment through completed pickup documentation.","steps":["Receive the project","Identify products and measurements","Email individual quote requests to approved vendors","Compare price, availability, lead time, and reliability","Create and send the customer estimate","Revise the estimate if requested","Create and send the invoice after approval","Confirm the invoice is paid in full","Create the Purchase Order from inside the QuickBooks Project","Follow the vendor payment procedure","Orders Coordinator schedules vendor pickup","Warehouse receives, photographs, fully breaks down, verifies, and rebuilds the pallet","Warehouse photographs customer loading and obtains a tablet signature","Attach pickup photographs and signature to the connected invoice"]},{"id":"CSE-101","title":"Receiving a New Project","type":"Procedure","summary":"How a Project Manager accepts an assigned project.","body":"A project can be assigned in several ways. Executive Leadership may give the PM a telephone number and ask the PM to call, assign an existing project by number or address, or introduce the PM directly to the contractor or customer. Once assigned, the PM is responsible for managing the project through completion."},{"id":"CSE-102","title":"Requesting Vendor Quotes","type":"Procedure","summary":"Request competitive quotes before preparing the customer estimate.","body":"Send a separate email to each approved vendor that carries the required product. Use a clear project name in the subject, such as “Smith Project – Request for Quote.” Include product, color, sizes, quantities, and special options. Ask for price, availability, lead time, and pickup or delivery charges. New PMs consult the CEO or Head Project Manager before selecting the vendor. Vendor quotes are internal and are not sent to the customer."},{"id":"CSE-103","title":"Creating the Customer Estimate","type":"Procedure","summary":"Create the estimate from verified vendor pricing using the correct customer pricing tier.","body":"Create the estimate inside the correct QuickBooks Project. Complete the customer, project/job name, Project Manager or Sales Rep, customer PO number when provided, products, quantities, and pricing. Use the correct Select, Plus, or Premier customer price list. The estimate is valid for 7 days. Customer changes are made by revising the existing estimate."},{"id":"CSE-104","title":"Customer Approval and Invoice","type":"Procedure","summary":"After approval, create the invoice and collect full payment before ordering.","body":"When the customer approves the estimate, create the invoice from the approved estimate and send it through QuickBooks. Cabella normally requires 100% payment before materials are ordered. QuickBooks can provide an online payment link and automatically send a paid receipt. If the customer changes the order before purchasing, revise the estimate and invoice as needed."},{"id":"CSE-105","title":"Creating a Purchase Order","type":"Procedure","summary":"Create the PO from inside the correct QuickBooks Project after customer payment.","body":"Open QuickBooks Projects, open the correct project, select Add to project, and select Purchase order. Complete the vendor, Customer/Project, PO number, Project Manager/Sales Rep, products, quantities, shipping destination, and notes. The Customer/Project field is critical. Do not send the PO until the customer has approved and paid. When the supplier invoice arrives, enter the final cost and convert the PO to a Bill. The Orders Coordinator usually completes the Bill, but the PM should enter the supplier amount as soon as it is known."},{"id":"CSE-106","title":"Vendor Payment and Order Coordination","type":"Procedure","summary":"Follow each vendor’s payment method and coordinate pickup.","body":"After sending the PO, confirm the vendor received it and ask when it will be ready. Vendors may invoice Cabella, charge a card on file, request Zelle, or send a payment link. The PM tells the Orders Coordinator when pickup is needed. The Orders Coordinator maintains a running pickup schedule showing vendor, PO, delivery company, pickup date, and expected arrival. The PM follows backorders and keeps the customer informed."},{"id":"CSE-107","title":"Warehouse Receiving","type":"Procedure","summary":"Photograph, fully break down, verify, and rebuild every incoming pallet.","body":"The vendor photographs the completed pallet. The driver photographs it after loading. Cabella photographs it when received. The Warehouse Manager must completely disassemble every pallet and verify every item against the PO. Vendors and drivers sometimes combine items from different projects to save space. Never assume everything on one pallet belongs to one order. Rebuild fresh pallets using only the correct items, label them, and match later arrivals to the correct customer order."},{"id":"CSE-108","title":"Customer Pickup","type":"Procedure","summary":"Release a fully paid order with photographs and electronic signature.","body":"A contractor may send an employee or installer to pick up. The representative must provide the project address or invoice number. The Warehouse Manager may release the order when the invoice is paid in full. Photograph the materials after loading them onto the customer’s vehicle and obtain the recipient’s signature on the tablet."},{"id":"CSE-109","title":"Completing the Order Record","type":"Procedure","summary":"The connected invoice becomes the permanent record of the pickup.","body":"Attach the customer pickup photographs and electronic signature to the invoice connected to the Purchase Order. This completes the order record and shows what was sold, what left the warehouse, who accepted it, and its condition at release. Additional materials ordered later are placed on a separate PO under the same project."},{"id":"POL-RETURN","title":"Returns and Restocking","type":"Policy","summary":"Eligible returns are subject to a minimum $75 restocking fee.","body":"Before discussing or approving a return, check the current Return & Refund Policy on CabellaCollections.com. Never promise that a return will be accepted or that a restocking fee will be waived. Eligible returns have a minimum $75 restocking fee, and additional charges may apply depending on the supplier, product condition, and special-order status."},{"id":"POL-MEASURE","title":"Measurement and Rendering Service","type":"Policy","summary":"$150 measurement and rendering fee; credited back when materials are purchased.","body":"Most contractor customers provide their own measurements or blueprints. When needed, Cabella offers a $150 measurement and rendering service. The fee includes measurement, a top-down drawing, renderings, and two revisions. Additional revisions are $50 each. If materials are purchased from Cabella, the $150 design fee is refunded or credited. No PO is created for a Cabella-designed project until the rendering and top view are signed. If the contractor supplies measurements and a cabinet list, the contractor is responsible for accuracy."},{"id":"SYS-DRIVE","title":"Google Shared Drive – Project Files","type":"System","summary":"Project files are stored by jobsite address in Cabella Client Projects.","body":"Go to Google Drive → Shared drives → Cabella Client Projects → the project jobsite address. The project folder contains measurements, top-down drawings, renderings, revisions, approvals, and project documents. Renderings remain in Google Drive; they are not normally attached to vendor POs."},{"id":"SYS-RC","title":"RingCentral – Day One","type":"System","summary":"Use RingCentral for company calls, extensions, and routing.","body":"The main Cabella telephone number is (702) 879-2549. Employees use their assigned RingCentral extension and company contact information. If a caller knows the person’s name, connect the caller to that person. Otherwise, offer the live operator or receptionist. Search the Company Directory in CSE for current names, emails, direct numbers, and extensions."},{"id":"PRICING","title":"Customer Pricing Tiers","type":"Pricing","summary":"Select, Plus, and Premier tiers. Mandatory: Always get direct vendor quotes before customer estimates.","body":"Select is for Cabella’s best high-volume customers and has the lowest markup. Plus is for established customers who purchase consistently. Premier is for new, one-time, or walk-in professional customers and has the highest markup. Never share Cabella’s vendor cost list with customers. ⚠️ MANDATORY SALES PROCEDURE: Because vendor pricing and special deal terms change frequently, salespeople MUST obtain an official written quote directly from the vendor before giving any binding estimate or price quote to a client."},{"id":"RAPHAEL-STONE","title":"Raphael Stone Price Sheet & Order Info","type":"Vendor Profile","summary":"Raphael Stone Collection contacts, online invoice portal, Zelle details, and quartz countertop pricing.","body":"Raphael Stone Collection supplies high-grade quartz countertops and porcelain slabs from their Las Vegas showroom at 3111 S Valley View Blvd #C-105. Phone: (702) 556-6750. Contact Shalom or Tanya. Online invoices are sent via email (lms.raphaelstoneusa.com). Zelle payments go to info@caraphael.com (California-Quartz). Always verify direct vendor quotes prior to client estimates."}],"prices":[{"tier":"Select","sku":"B09F","description":"Base Cabinet - 9\"W x 34-1/2\"H x 24\"D","section":"BASE CABINETS","style":"LDG - Light Grey / Dark Grey","aliases":["ldg","light grey","dark grey","gray"],"price":242.31},{"tier":"Select","sku":"B09F","description":"Base Cabinet - 9\"W x 34-1/2\"H x 24\"D","section":"BASE CABINETS","style":"DB - Blue Shaker","aliases":["db","blue shaker","blue"],"price":259.56},{"tier":"Select","sku":"B09F","description":"Base Cabinet - 9\"W x 34-1/2\"H x 24\"D","section":"BASE CABINETS","style":"SW - White Shaker","aliases":["sw","white shaker"